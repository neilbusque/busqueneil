---
/* Shared shell for the 50-piece content programme (docs/content-plan-50.md).
 *
 * Each article was ~60 lines of identical schema and header boilerplate. Across 50 pages that
 * is 3,000 lines of copy-paste, and copy-paste is how a canonical ends up pointing at the page
 * it was duplicated from. This takes a slug, reads everything else from content-index, and
 * leaves the article file as frontmatter plus prose.
 *
 * ⚠️ The entry must exist in content-index.ts and be `live: true`, or the build fails here
 * rather than shipping a page the sitemap and hubs do not know about.
 */
import AppShell from './AppShell.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { AUTHOR, PUBLISHER, SITE_URL, WEBSITE_REF } from '../lib/seo';
import { CONTENT, clusterPath, urlFor, type Cluster } from '../data/content-index';

interface FaqItem { q: string; a: string }
interface Props {
  slug: string;
  /** Overrides the index title for the <title> tag when the H1 needs to differ. */
  seoTitle?: string;
  description: string;
  /** Rendered as the H1. Wrap the accent word in the `accent` prop instead of markup. */
  heading: string;
  accent?: string;
  lede: string;
  /** Index number shown in the eyebrow, e.g. "02". */
  idx: string;
  faq?: FaqItem[];
  keywords?: string;
}

const { slug, seoTitle, description, heading, accent, lede, idx, faq = [], keywords } = Astro.props;

const entry = CONTENT.find((c) => c.slug === slug);
if (!entry) throw new Error(`ContentArticle: "${slug}" is not in content-index.ts`);
if (!entry.live) throw new Error(`ContentArticle: "${slug}" is in content-index but not marked live:true`);

const cluster: Cluster = entry.cluster;
const canonical = `${SITE_URL}${urlFor(entry)}`;
const image = `${SITE_URL}/assets/brand/og-v13.png`;

const CRUMB_LABEL: Record<Cluster, string> = {
  compare: 'Compare',
  guides: 'Resources',
  research: 'Research',
};
/* /guides 301s to /resources, so the breadcrumb for a guide must point at the 200. */
const CRUMB_URL: Record<Cluster, string> = {
  compare: `${SITE_URL}/compare`,
  guides: `${SITE_URL}/resources`,
  research: `${SITE_URL}/research`,
};
const EYEBROW: Record<Cluster, string> = { compare: 'Compare', guides: 'Guide', research: 'Research' };

const article = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: seoTitle ?? entry.title,
  description,
  '@id': `${canonical}#article`,
  author: AUTHOR,
  publisher: PUBLISHER,
  datePublished: entry.published,
  dateModified: entry.modified ?? entry.published,
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  isPartOf: WEBSITE_REF,
  image,
  inLanguage: 'en-US',
  ...(keywords ? { keywords } : {}),
};

/* FAQPage is emitted only when the questions are genuinely answered in visible copy on the
   page. Marking up questions that are not on the page is a structured-data violation, and
   FAQ rich results are in any case now limited to authoritative gov/health sites — this is
   for machine comprehension, not a rich-result play. */
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<AppShell
  title={`${seoTitle ?? entry.title} | Neil Busque`}
  description={description}
  canonical={canonical}
  ogImage={image}
  ogType="article"
  active="resources"
>
  <Fragment slot="head">
    <Breadcrumb items={[
      { name: 'Home', url: `${SITE_URL}/` },
      { name: CRUMB_LABEL[cluster], url: CRUMB_URL[cluster] },
      { name: entry.title, url: canonical },
    ]} />
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <header class="page-head">
    <p class="eyebrow"><span class="idx">{idx}</span> {EYEBROW[cluster]}</p>
    <h1>{heading} {accent && <span class="accent">{accent}</span>}</h1>
    <p class="lede">{lede}</p>
  </header>

  <article class="article-page">
    <div class="prose">
      <slot />
    </div>
  </article>
</AppShell>
