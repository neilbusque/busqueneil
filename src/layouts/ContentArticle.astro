---
/* Article layout for every guide, comparison and research page.

   A page passes its slug and its copy; everything else (title tag, dates, canonical, schema,
   related reading) comes from src/data/content-index.ts, so a canonical can never point at the
   page it was copied from. The entry must exist in the index and be live, or the build fails
   here rather than shipping a page the hubs and the sitemap do not know about.

   Page order (blueprint "Article page"): back link to /resources, kind label, H1, lead, meta row
   (author, read time, updated date), art 16/9 seeded by the slug, then the body in a 680px
   column with a sticky table of contents at 1200px and wider, the FAQ, the author box, three
   related reads, and the closing band from AppShell.

   FAQ: the questions passed in `faq` are rendered visibly here AND marked up as FAQPage, from
   the same array, so the schema always matches what a reader sees. Do not repeat them in the
   body. */
import AppShell from './AppShell.astro';
import ArticleFrame from '../components/articles/ArticleFrame.astro';
import { countWords, minutesFor, prepareProse } from '../components/articles/prose';
import { relatedRows } from '../components/articles/rows';
import { AUTHOR, PUBLISHER, SITE_URL, SOCIAL_IMAGE_URL, WEBSITE_REF } from '../lib/seo';
import { ARTICLES, KIND_LABEL, kindOf, readMinutes, urlFor, type Cluster } from '../data/content-index';

interface FaqItem { q: string; a: string }
interface Props {
  slug: string;
  /** Overrides the index title for the title tag and the schema headline. */
  seoTitle?: string;
  /** The exact title tag, with no suffix added. For pages that keep an older title tag. */
  titleTag?: string;
  /** Schema headline, when it should differ from the title. */
  headline?: string;
  description: string;
  /** Rendered as the H1. Put the accent words in `accent`, not in markup. */
  heading: string;
  accent?: string;
  lede: string;
  /** Old index number. Kept so existing pages compile; no longer shown. */
  idx?: string;
  faq?: FaqItem[];
  keywords?: string;
  /** Schema type. Most pieces are how-to or technical, so TechArticle is the default. */
  schemaType?: 'TechArticle' | 'Article';
  /** Extra fields merged into the article schema, for example proficiencyLevel. */
  schema?: Record<string, unknown>;
  /** Social image. Defaults to the site's article image. */
  ogImage?: string;
}

const {
  slug,
  seoTitle,
  titleTag,
  headline,
  description,
  heading,
  accent,
  lede,
  faq = [],
  keywords,
  schemaType = 'TechArticle',
  schema: extraSchema,
  ogImage,
} = Astro.props;

const entry = ARTICLES.find((c) => c.slug === slug);
if (!entry) throw new Error(`ContentArticle: "${slug}" is not a live entry in content-index.ts`);

const cluster: Cluster = entry.cluster;
const canonical = `${SITE_URL}${urlFor(entry)}`;
const image = ogImage ?? SOCIAL_IMAGE_URL;
const kind = kindOf(entry);
const updated = entry.modified ?? entry.published;

/* The body, rendered once: H2s get ids and feed the table of contents, bare tables get a
   scrolling wrapper. */
const rendered = await Astro.slots.render('default');
const { html: body, toc } = prepareProse(rendered, ['faq', 'main', 'article-title']);
if (faq.length) toc.push({ id: 'faq', html: 'FAQ' });

const words = countWords(body) + faq.reduce((n, f) => n + countWords(`${f.q} ${f.a}`), 0);
/* The hubs list the stored READ_MINUTES; the live count is the fallback for a new page and the
   source for refreshing the stored numbers (data-words below). */
const minutes = readMinutes(entry) ?? minutesFor(words);

/* Breadcrumb schema as before: Compare, Resources (guides; /guides 301s there) or Research. */
const CRUMB: Record<Cluster, { name: string; url: string }> = {
  compare: { name: 'Compare', url: `${SITE_URL}/compare` },
  guides: { name: 'Resources', url: `${SITE_URL}/resources` },
  research: { name: 'Research', url: `${SITE_URL}/research` },
};

const article = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: headline ?? seoTitle ?? entry.title,
  description,
  '@id': `${canonical}#article`,
  author: AUTHOR,
  publisher: PUBLISHER,
  datePublished: entry.published,
  dateModified: updated,
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  isPartOf: WEBSITE_REF,
  image,
  inLanguage: 'en-US',
  ...(keywords ? { keywords } : {}),
  ...(extraSchema ?? {}),
};

/* FAQPage only for questions shown on the page (they render below, from this same array). */
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      isPartOf: { '@id': `${canonical}#webpage` },
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const related = relatedRows(entry);
---
<AppShell
  title={titleTag ?? `${seoTitle ?? entry.title} | Neil Busque`}
  description={description}
  canonical={canonical}
  ogImage={image}
  ogType="article"
  active="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <ArticleFrame
    kind={KIND_LABEL[kind]}
    heading={heading}
    accent={accent}
    lede={lede}
    minutes={minutes}
    date={updated ? { iso: updated, label: 'Updated' } : undefined}
    artSeed={slug}
    body={body}
    toc={toc}
    faq={faq}
    related={related}
    words={words}
    crumbs={[{ name: 'Home', url: `${SITE_URL}/` }, CRUMB[cluster], { name: entry.title, url: canonical }]}
  />
</AppShell>
