---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  active?: 'feed' | 'projects' | 'writing' | 'guides' | 'now' | 'about' | 'hire';
}

const { active, ...baseProps } = Astro.props;
---
<Base {...baseProps}>
  <slot name="head" slot="head" />

  <div class="ticker">
    <div class="wrap">
      {/* Availability status pulled 2026-07-25 (Neil): none site-wide. Braces, not an
          HTML comment, so the phrase does not ship in the page source. */}
      <span>New Jersey</span>
      <span class="sep hide-sm">/</span>
      <span class="hide-sm">EST</span>
      <a class="right" href="mailto:busqueneil@gmail.com" style="color:inherit;text-decoration:none">busqueneil@gmail.com</a>
    </div>
  </div>

  <div class="wrap">
    <header class="masthead">
      <a class="name" href="/">busque<b>neil</b></a>
      <nav>
        <a href="/work" aria-current={active === 'projects' ? 'page' : undefined}>Work</a>
        <a href="/resources" aria-current={active === 'guides' ? 'page' : undefined}>Resources</a>
        <a href="/blog" aria-current={active === 'writing' ? 'page' : undefined}>Writing</a>
        <a href="/story" aria-current={active === 'about' ? 'page' : undefined}>Story</a>
        <a class="hire" href="/hire" aria-current={active === 'hire' ? 'page' : undefined}>Hire</a>
      </nav>
    </header>

    <slot />

    <footer class="footer">
      <div class="footer-cols">
        <div class="footer-brand">busque<b>neil</b></div>
        <div class="footer-links">
          <a href="/hire">Hire</a>
          <a href="/work">Work</a>
          <a href="/work">Case studies</a>
          <a href="/resources">Resources</a>
          <a href="/blog">Writing</a>
          <a href="/blog?filter=now">Now</a>
          <a href="/story">Story</a>
          <a href="/rss.xml">RSS</a>
          <a href="/resume.pdf">Resume</a>
          <a href="mailto:busqueneil@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/neilbusque/" rel="me">LinkedIn</a>
        </div>
      </div>
      <div class="footer-colophon">New Jersey · © 2026 Neil Busque</div>
    </footer>
  </div>
</Base>
