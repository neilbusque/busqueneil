---
import '../styles/global.css';
import { ORGANIZATION_REF, PERSON_REF, SOCIAL_IMAGE_URL, WEBSITE_REF } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Dark premium landing (homepage): loads Sora + dark theme-color + body flag. */
  dark?: boolean;
  /** Suppress the floating Talk concierge bubble (focused conversion pages). */
  noConcierge?: boolean;
  /** v8 app shell: Ribbon N brand system. */
  v8?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = SOCIAL_IMAGE_URL,
  noindex = false,
  dark = false,
  noConcierge = false,
  v8 = false,
} = Astro.props;

/* v12: ONE typeface site-wide (Neil: "just use 1 font for everything"). Geist for all text
   and UI; Geist Mono only inside <code>/<pre>, because proportional code is unreadable.
   ⚠️ The old v8 href never requested Geist at all, yet CSS asked for it first via --sans.
   document.fonts.check() reported it present because it resolves locally-installed faces,
   so this looked fine on our machines while visitors silently got a fallback. Load it. */
const fontHref = v8
  ? 'https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Figtree:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap';

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: 'en-US',
  isPartOf: WEBSITE_REF,
  about: [PERSON_REF, ORGANIZATION_REF],
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: ogImage,
    contentUrl: ogImage,
    width: 1200,
    height: 630,
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={v8 ? '#F5F0E8' : (dark ? '#08080C' : '#FFFFFF')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Neil Busque" />
    <meta name="application-name" content="busqueneil" />
    <meta name="apple-mobile-web-app-title" content="busqueneil" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="author" href="https://busqueneil.com/story" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} | Neil Busque`} />
    <meta property="og:site_name" content="busqueneil" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${title} | Neil Busque`} />

    <link rel="icon" type="image/svg+xml" href="/assets/brand/mark-small.svg?v=12" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png?v=12" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16.png?v=12" />
    <link rel="shortcut icon" href="/favicon.ico?v=12" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon-180.png?v=12" />
    <link rel="mask-icon" href="/assets/brand/mark-mono.svg?v=12" color="#16150F" />
    <link rel="manifest" href="/site.webmanifest?v=12" />
    <link rel="me" href="https://www.linkedin.com/in/neilbusque/" />
    <link rel="me" href="https://www.facebook.com/neilvbusque/" />
    <link rel="me" href="https://www.instagram.com/neil_busque/" />
    <link rel="alternate" type="application/rss+xml" title="Neil Busque" href="/rss.xml" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}

    {/* SearchAtlas OTTO removed 2026-07-25. The snippet was a render-blocking <script> in
        <head> (no async/defer), so every cold visit stalled on a searchatlas round trip —
        that was the "blank until I refresh" bug. Worse, OTTO's body_substitutions rewrote
        live DOM: it set the hero <h1> textContent to "Neil Busque: AI Engineer and Product
        Builder for Small Teams", which blew the 96px display heading to an 845px-tall block,
        and replaced <title> with "AI Automation & Agent Development". Verified in a headless
        render before removal. Do NOT re-add without `defer` AND with heading/title
        substitutions rejected in the OTTO dashboard. */}

    <slot name="head" />
  </head>
  <body class={dark ? 'theme-dark' : undefined}>
    <slot />
    <script is:inline>
      /* .reveal elements start at opacity 0 and are shown by this observer.
         ⚠️ This MUST re-arm after every ClientRouter navigation. It used to run once, as a
         bare IIFE. ClientRouter replaces <body> on navigation, so on any client-side visit
         the new page's .reveal elements were never observed and stayed invisible forever —
         clicking a case study from /work rendered a blank page, while loading the same URL
         directly was fine. Verified: .cs-metrics still hidden 5s after navigation.
         Hence astro:page-load, plus a failsafe for anything already on screen. */
      (function () {
        var io = null;
        function showAll() {
          document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
        }
        function arm() {
          if (io) { io.disconnect(); io = null; }
          if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
            showAll();
            return;
          }
          io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
          var pending = document.querySelectorAll('.reveal:not(.in)');
          pending.forEach(function (el) { io.observe(el); });
          /* Belt and braces: anything sitting in the viewport and still hidden shortly after
             is stuck, so show it unconditionally rather than leave a blank screen. */
          setTimeout(function () {
            document.querySelectorAll('.reveal:not(.in)').forEach(function (el) {
              var r = el.getBoundingClientRect();
              if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('in');
            });
          }, 600);
        }
        arm();
        document.addEventListener('astro:page-load', arm);
      })();
    </script>
    {/* Talk concierge — availability-gated floating bubble; only shows "Speak with Neil live" when the host console is online.
        Gated on noConcierge ALONE. It used to also require !noindex, which silently coupled two
        unrelated things: a robots directive is about crawlers, the pill is about visitors. The
        side effect was that /404 — a page where offering a live human is worth more than
        anywhere else on the site — never showed it. Pages that genuinely should not have the
        pill now say so explicitly with noConcierge, which is the prop that means it. */}
    {!noConcierge && (
      <script
        src="https://talk.busqueneil.com/widget.js"
        data-talk-widget
        data-label="I'm online right now. Want to talk?"
        data-sub="Live video, no booking, no pitch"
        defer
      ></script>
    )}
    {/* Exit-intent popup removed 2026-07-26 (Neil), desktop and mobile. It fired three ways:
        pointer leaving the top of the viewport, a fast scroll-up, and a 25s dwell timer — and
        that last one meant it interrupted anyone simply reading, on phones too, where there is
        no exit intent to detect. The analyzer it advertised is reachable from /free and from
        the landing-page and funnel service pages. */}
  </body>
</html>
