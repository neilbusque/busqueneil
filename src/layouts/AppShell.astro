---
import '../styles/v8.css';
import '../styles/v13.css';
import Base from './Base.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string; description: string; canonical?: string; ogImage?: string; ogType?: string; noindex?: boolean;
  active: 'home' | 'story' | 'work' | 'services' | 'blog' | 'resources' | 'free' | 'hire' | 'contact';
}
const { active, ...baseProps } = Astro.props;

const NAV = [
  { key: 'work',      href: '/work',      label: 'Work' },
  { key: 'services',  href: '/services',  label: 'Services' },
  { key: 'story',     href: '/story',     label: 'About' },
  { key: 'resources', href: '/resources', label: 'Resources' },
] as const;

const activeNav = active === 'blog' ? 'resources' : active;
const BOOK_HREF = 'https://book.busqueneil.com/';
const WA_HREF = 'https://wa.me/19083164140?text=Hi%20Neil%2C%20got%20an%20idea%3A%20';
---
<Base {...baseProps} v8={true}>
  <slot name="head" slot="head" />
  <ClientRouter slot="head" />
  <script>
    import { initPointer } from '../scripts/pointer';
    initPointer();
    document.addEventListener('astro:page-load', () => initPointer());
  </script>

  <div class="v8 shell">
    <slot name="intro" />

    <header class="topnav">
      <nav class="topnav-inner" aria-label="Primary">
        <a class="topnav-brand" href="/" aria-label="Neil Busque, home" aria-current={active === 'home' ? 'page' : undefined}>
          <span class="topnav-mark" aria-hidden="true">N</span>
          <span>Neil Busque</span>
        </a>
        <div class="topnav-links">
          {NAV.map((n) => (
            <a class:list={['topnav-link', { active: activeNav === n.key }]} href={n.href} aria-current={activeNav === n.key ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
        </div>
        <a class="btn-sun topnav-cta" href={BOOK_HREF} target="_blank" rel="noopener">Book a free call</a>
      </nav>
    </header>

    <main class="shell-main" transition:animate="fade">
      <slot />

      <footer class="shell-foot">
        <div class="foot-brand">
          <strong>Neil Busque</strong>
          <span>AI engineer and product builder · New Jersey</span>
        </div>
        <nav class="shell-foot-links" aria-label="Footer">
          <a href="/work">Work</a>
          <a href="/services">Services</a>
          <a href="/story">About</a>
          <a href="/free">Free tools</a>
          <a href="https://ai.busqueneil.com/">AI offer</a>
          <a href="/contact">Contact</a>
        </nav>
        <div class="foot-meta">
          <span>© 2026 Neil Busque</span>
          <span class="foot-socials">
            <a href="https://www.linkedin.com/in/neilbusque/" aria-label="LinkedIn" rel="me" target="_blank">LinkedIn</a>
            <a href={WA_HREF} aria-label="WhatsApp" target="_blank" rel="noopener">WhatsApp</a>
            <a href="/resume.pdf">Resume</a>
          </span>
        </div>
      </footer>
    </main>
  </div>

  <script>
    import '../scripts/v9-motion';
  </script>
</Base>
