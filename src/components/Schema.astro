---
/* The site's identity graph: one person, one brand and one website. The home page renders it,
   and page-level schema points at these stable ids (PERSON_REF, ORGANIZATION_REF, WEBSITE_REF).
   Facts come from the copy deck's Person schema and llms.txt bio. Keep it free of employers,
   schools, cities and portraits. */
import { SITE, FOOTER_TAGLINE } from '../data/site';
import {
  LOGO,
  ORGANIZATION_ID,
  ORGANIZATION_REF,
  PERSON_ID,
  PERSON_REF,
  SITE_URL,
  SOCIAL_IMAGE,
  WEBSITE_ID,
} from '../lib/seo';

interface Props {
  /** WebSite description. Defaults to the home page meta description. */
  description?: string;
}

const HOME_DESCRIPTION =
  'I find the work worth handing to AI, build it and keep it running. AI agents, custom software, automations and sites. First versions in days.';
const { description = HOME_DESCRIPTION } = Astro.props;

const url = `${SITE_URL}/`;
const telephone = '+1-908-316-4140';
const jobTitle = 'AI developer and fractional AI lead';
const sameAs = [
  'https://www.linkedin.com/in/neilbusque/',
  'https://www.facebook.com/neilvbusque/',
  'https://www.instagram.com/neil_busque/',
];
const address = { '@type': 'PostalAddress', addressRegion: 'New Jersey', addressCountry: 'US' };

const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: SITE.name,
  givenName: 'Neil',
  familyName: 'Busque',
  alternateName: 'busqueneil',
  url,
  mainEntityOfPage: { '@id': `${SITE_URL}/story#webpage` },
  jobTitle,
  description:
    'Neil Busque, based in New Jersey, finds the work worth handing to AI for small and mid-size businesses, builds the agents, software and automations, and keeps them running.',
  email: `mailto:${SITE.email}`,
  telephone,
  address,
  hasOccupation: {
    '@type': 'Occupation',
    name: jobTitle,
    occupationLocation: { '@type': 'State', name: 'New Jersey' },
    skills:
      'AI agents, AI voice agents, LLM applications, Model Context Protocol (MCP), workflow automation, n8n, custom software, business operating systems, CRM, websites and funnels',
  },
  knowsAbout: [
    'Artificial intelligence',
    'AI agents',
    'AI voice agents',
    'Large language models',
    'Model Context Protocol (MCP)',
    'Retrieval-augmented generation (RAG)',
    'Workflow automation',
    'n8n',
    'GoHighLevel',
    'CRM',
    'Custom software',
    'Web app development',
    'Generative Engine Optimization (GEO)',
    'SEO',
    'Conversion funnels',
  ],
  sameAs,
};

const organization = {
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: 'busqueneil',
  alternateName: SITE.name,
  url,
  slogan: 'Your AI guy.',
  description: FOOTER_TAGLINE,
  logo: LOGO,
  image: SOCIAL_IMAGE,
  founder: PERSON_REF,
  email: SITE.email,
  telephone,
  address,
  areaServed: [{ '@type': 'State', name: 'New Jersey' }, { '@type': 'Country', name: 'United States' }, 'Remote'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'project inquiries',
    email: SITE.email,
    telephone,
    availableLanguage: ['English'],
  },
  sameAs,
};

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url,
  name: 'busqueneil',
  alternateName: SITE.name,
  description,
  inLanguage: 'en-US',
  publisher: ORGANIZATION_REF,
  creator: PERSON_REF,
  about: [PERSON_REF, ORGANIZATION_REF],
};

const graph = { '@context': 'https://schema.org', '@graph': [LOGO, SOCIAL_IMAGE, organization, person, website] };
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
