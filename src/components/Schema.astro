---
// Person + WebSite + ProfilePage + FAQPage JSON-LD for the homepage.
// Keep this aligned with the visible homepage positioning.

const person = {
  '@type': 'Person',
  '@id': 'https://busqueneil.com/#person',
  name: 'Neil Busque',
  givenName: 'Neil',
  familyName: 'Busque',
  url: 'https://busqueneil.com/',
  image: 'https://busqueneil.com/assets/brand/og-default.png',
  jobTitle: 'AI Product Builder & Automation Consultant',
  description:
    'Product builder based in New Jersey. Designs and ships custom AI apps, websites, automation systems, and digital products for founders and small teams. Documents the work in public at busqueneil.com.',
  email: 'mailto:busqueneil@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'New Jersey',
    addressRegion: 'NJ',
    addressCountry: 'US',
  },
  hasOccupation: {
    '@type': 'Occupation',
    name: 'AI Product Builder & Automation Consultant',
    occupationLocation: { '@type': 'City', name: 'New Jersey' },
    skills: 'AI agents, LLM applications, Model Context Protocol (MCP), workflow automation, n8n, generative engine optimization (GEO), SEO, paid search, CRM, web app development',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'STI Tagum College',
    address: 'Philippines',
  },
  knowsAbout: [
    'Artificial intelligence',
    'AI agents',
    'Large language models',
    'Generative Engine Optimization (GEO)',
    'AI search optimization',
    'Model Context Protocol (MCP)',
    'Retrieval-augmented generation (RAG)',
    'Prompt engineering',
    'Claude Code',
    'Workflow automation',
    'n8n',
    'GoHighLevel',
    'Digital marketing',
    'SEO',
    'Paid search',
    'Conversion funnels',
    'CRM',
    'Web app development',
    'Astro',
    'Supabase',
  ],
  sameAs: [
    'https://www.linkedin.com/in/neilbusque',
    'https://github.com/neilbusque',
  ],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://busqueneil.com/#website',
  url: 'https://busqueneil.com/',
  name: 'Neil Busque',
  description:
    'Neil Busque designs and ships custom AI apps, websites, and automations for founders and small teams. Based in New Jersey.',
  inLanguage: 'en-US',
  publisher: { '@id': 'https://busqueneil.com/#person' },
};

const profilePage = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateCreated: '2026-05-13',
  dateModified: '2026-07-25',
  mainEntity: person,
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who is Neil Busque?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Neil Busque is a product builder based in New Jersey. He designs and ships custom AI apps, websites, automation systems, and digital products, and documents the work in public at busqueneil.com.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is Neil Busque based?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'New Jersey, United States (Eastern Time). He works remote, hybrid, or on-site across the NJ / NYC metro.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does Neil Busque do?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'He turns rough ideas into working products: custom web apps, websites, AI agents, landing pages, funnels, and automation systems. He handles the design and build directly and posts the work in public at busqueneil.com.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I contact Neil Busque?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Email busqueneil@gmail.com, use the contact page at busqueneil.com/contact, or message him through the WhatsApp link on the site.',
      },
    },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(website)} />
<script type="application/ld+json" set:html={JSON.stringify(profilePage)} />
<script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
