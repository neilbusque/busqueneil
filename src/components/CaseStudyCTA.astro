---
/* The ask at the end of a case study: one sentence and the WhatsApp button on a single row
   (the shared CtaRow), above the next project. The closing band below repeats the full ask. */
import CtaRow from './site/CtaRow.astro';
import { waGlobal } from '../data/site';

interface Props {
  text?: string;
  class?: string;
}

const { text = 'I can build something like this around how your business works.', class: className } = Astro.props;
---
<CtaRow class:list={['cs-cta', className]} text={text} cta={{ href: waGlobal(), label: 'Message me on WhatsApp' }} variant="primary" />
