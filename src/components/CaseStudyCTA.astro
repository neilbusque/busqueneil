---
import { BOOKING_URL, WHATSAPP_URL, EMAIL_URL } from '../data/case-studies/types';

interface Props {
  /** product name, so the copy can reference what they just read */
  product?: string;
  body?: string;
}

const { product, body } = Astro.props;

const b = body ?? (product
  ? `${product} started with a real problem and an empty repo. If you have something similar sitting in a spreadsheet, buried in email threads, or waiting in your notes, tell me about it. I will help you work out the smallest useful version.`
  : 'If your team keeps rebuilding the same tool in spreadsheets, holding a client experience together with email threads, or sitting on an idea nobody has time to test, tell me about it. I will help you scope the smallest useful version.');
---
<section class="cs-cta reveal">
  <p class="eyebrow"><span class="idx">&#8727;</span> Work with me<span class="line"></span></p>
  <h2>Got a project? Let&rsquo;s <span class="accent">talk</span>.</h2>
  <p>{b}</p>
  <div class="acts">
    <a class="btn" href={BOOKING_URL} target="_blank" rel="noopener">Book a call</a>
    <a class="btn ghost" href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>
    <a class="btn ghost" href={EMAIL_URL}>Email me</a>
  </div>
  <p class="fine">Free 20 minutes &middot; New Jersey &middot; Eastern Time &middot; No pitch deck</p>
</section>
