---
/* Scroll reveal, owned by CSS: elements marked data-reveal fade in and rise 8px over 240ms
   when they scroll into view, once, staggered 40ms within a group (max 4 steps).

   THE BUG THIS EXISTS TO PREVENT. An older system hid content from a bundled module after
   the page had already painted, so the finished page showed, went blank, then faded back.
   The rules that keep that from coming back:
     1. The hidden state is CSS in site.css, switched on by the .js-reveal class that the
        inline script below puts on <html> while <head> is still parsing, before first paint.
        Never move this into a bundled or deferred script.
     2. Above the fold never animates. The arm step runs as soon as the page markup has been
        parsed (AppShell fires "reveal:arm" from the end of the body, before any module
        script), and anything already on screen is shown at once, without motion. The nav
        and the hero never carry data-reveal at all.
     3. Failsafes: if arming never happens, the hidden state is dropped after 1.5s. After
        arming, any element at or above the bottom of the viewport that is still hidden (a
        scroll jump, an anchor link, a late observer delivery, the end of the page) is
        shown at once, and printing shows everything.
     4. Visitors with reduced motion or no JS never get the hidden state. Neither do
        automated browsers (navigator.webdriver): QA screenshots capture the whole page
        without scrolling and must show the resting design.

   This script also puts .js on <html>, which components use for no-JS fallbacks. */
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    var motionOK = window.matchMedia && matchMedia('(prefers-reduced-motion: no-preference)').matches;
    if (!motionOK || !('IntersectionObserver' in window) || navigator.webdriver) return;
    root.classList.add('js-reveal');

    var STAGGER = 40, MAX_STEPS = 4, DURATION = 240;
    var armed = false;
    var bail = setTimeout(function () { if (!armed) root.classList.remove('js-reveal'); }, 1500);

    function showNow(el) { el.classList.add('is-in', 'rv-done'); }
    function animateIn(el, delay) {
      el.style.setProperty('--rv-delay', delay + 'ms');
      el.classList.add('is-in');
      setTimeout(function () { el.classList.add('rv-done'); }, DURATION + delay + 80);
    }

    function arm() {
      if (armed) return;
      armed = true;
      clearTimeout(bail);
      var pending = new Set();
      var fold = window.innerHeight;
      document.querySelectorAll('.site [data-reveal]').forEach(function (el) {
        if (el.getBoundingClientRect().top < fold) showNow(el);
        else pending.add(el);
      });
      if (!pending.size) return;

      var io = new IntersectionObserver(function (entries) {
        var hits = entries
          .filter(function (e) { return e.isIntersecting && pending.has(e.target); })
          .map(function (e) { return e.target; });
        hits.sort(function (a, b) {
          var ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
          return Math.abs(ra.top - rb.top) > 4 ? ra.top - rb.top : ra.left - rb.left;
        });
        var steps = new Map();
        hits.forEach(function (el) {
          var group = el.parentElement;
          var i = steps.get(group) || 0;
          steps.set(group, i + 1);
          pending.delete(el);
          io.unobserve(el);
          animateIn(el, Math.min(i, MAX_STEPS - 1) * STAGGER);
        });
      }, { rootMargin: '0px 0px -32px 0px' });
      pending.forEach(function (el) { io.observe(el); });

      function sweep() {
        var limit = window.innerHeight - 40;
        Array.from(pending).forEach(function (el) {
          if (el.getBoundingClientRect().top < limit) {
            pending.delete(el);
            io.unobserve(el);
            showNow(el);
          }
        });
      }
      var queued = false;
      window.addEventListener('scroll', function () {
        if (queued) return;
        queued = true;
        setTimeout(function () { queued = false; sweep(); }, 300);
      }, { passive: true });
      setTimeout(sweep, 1500);
      window.addEventListener('beforeprint', function () {
        Array.from(pending).forEach(showNow);
        pending.clear();
      });
    }

    document.addEventListener('reveal:arm', arm, { once: true });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', arm, { once: true });
    else arm();
  })();
</script>
