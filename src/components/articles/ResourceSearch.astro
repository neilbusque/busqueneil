---
/* Search field for the resources hub. Without JavaScript it is a GET form that reloads
   /resources with ?q= (the server filters the list). With JavaScript, ResourceIndex filters the
   list as you type and Enter scrolls to it. The current kind and topic ride along as hidden
   fields so a search keeps the view you were in. */
import type { HubKind, HubTopic } from '../../lib/blogFilters';

interface Props {
  query?: string;
  kind?: HubKind;
  topic?: HubTopic | null;
  placeholder?: string;
  /** Shown instead on narrow phones, where the full placeholder would be cut off. */
  placeholderShort?: string;
}

const {
  query = '',
  kind = 'all',
  topic = null,
  placeholder = 'Search guides, comparisons and research',
  placeholderShort = 'Search all guides',
} = Astro.props;
---
<form class="rsearch" role="search" action="/resources" method="get">
  <label class="sr-only" for="rsearch-q">{placeholder}</label>
  <svg class="rsearch-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
  <input
    class="input rsearch-input"
    id="rsearch-q"
    type="search"
    name="q"
    value={query}
    placeholder={placeholder}
    autocomplete="off"
    enterkeyhint="search"
    spellcheck="false"
    maxlength="80"
    data-rsearch
    data-placeholder-short={placeholderShort}
  />
  {topic && <input type="hidden" name="topic" value={topic} />}
  {kind !== 'all' && <input type="hidden" name="type" value={kind} />}
</form>

<script>
  /* The full placeholder does not fit a phone-width field at 16px, so narrow screens get the
     short one. The label keeps the full wording for screen readers either way. */
  document.querySelectorAll<HTMLInputElement>('[data-rsearch][data-placeholder-short]').forEach((input) => {
    const full = input.placeholder;
    const short = input.dataset.placeholderShort || full;
    const narrow = window.matchMedia('(max-width: 480px)');
    const set = () => { input.placeholder = narrow.matches ? short : full; };
    set();
    narrow.addEventListener('change', set);
  });
</script>
