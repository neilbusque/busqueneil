---
/* Real client messages, shown as the original screenshots (Slack / WhatsApp / Discord).
   Screenshots, not retyped quotes, because the raw thread is the proof. Never replace
   these with written-out testimonials. */
const SHOTS = [
  { src: '/assets/testimonials/testimonial4.webp', w: 814, h: 634, alt: 'Client message: "Neil, we just want to take a moment to say how much we appreciate all the amazing work you have done for us at Novuskin Med Spa and PPS... You have designed around 25 pages for us... The landing pages you created for PSC have been a game-changer, outperforming our previous ones and bringing in more leads and bookings than we ever imagined."' },
  { src: '/assets/testimonials/testimonial7.webp', w: 900, h: 150, alt: 'Client message from Quinton L.: "amazing, looks good. Looking forward to next week. thanks again for all the work, you are doing amazing. Feel free to send over the invoice for this week and i will send payment right away."' },
  { src: '/assets/testimonials/testimonial8.webp', w: 900, h: 237, alt: 'Client message: "Hey Neil, I just want to say thank you once again for your great work so far. Very happy with the way this design is coming out... Keep doing what you are doing and send me updates."' },
  { src: '/assets/testimonials/testimonial1.webp', w: 900, h: 180, alt: 'Client message from Brandon: "You are the man Neil! I already love working with you."' },
  { src: '/assets/testimonials/testimonial5.webp', w: 864, h: 230, alt: 'Client message: "OH MY GOODNESS, it looks amazing." followed by "it is amazing".' },
  { src: '/assets/testimonials/testimonial3.webp', w: 900, h: 246, alt: 'Client message about a landing page for the Mental Health Conference: "It looks good... Preciate all your help."' },
  { src: '/assets/testimonials/testimonial2.webp', w: 490, h: 130, alt: 'Client message: "yooooo this is perfect".' },
  { src: '/assets/testimonials/testimonial6.webp', w: 482, h: 160, alt: 'Client message from Rj: "Looks really good".' },
];
---
<section class="hsec" id="praise">
  <span class="eyebrow">What people say</span>
  <h2 class="sec">Messages I was happy to <span class="mark-hl">get.</span></h2>
  <p class="praise-note">Unedited client messages, shown exactly as they came in.</p>
  <div class="praise-wall">
    {SHOTS.map((s) => (
      <figure class="praise-shot">
        <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
      </figure>
    ))}
  </div>
</section>
