---
/* Real client messages, shown as the original screenshots (Slack / WhatsApp / Discord).
   Screenshots, not retyped quotes, because the raw thread is the proof. Never replace
   these with written-out testimonials. */
const SHOTS = [
  { src: '/assets/testimonials/testimonial4.webp', w: 814, h: 634, alt: 'Client thanks Neil for roughly 25 landing pages that improved leads and bookings.' },
  { src: '/assets/testimonials/testimonial7.webp', w: 900, h: 150, alt: 'Client praises Neil’s work and asks him to send the weekly invoice.' },
  { src: '/assets/testimonials/testimonial8.webp', w: 900, h: 237, alt: 'Client says they are very happy with the design and asks Neil to keep going.' },
  { src: '/assets/testimonials/testimonial1.webp', w: 900, h: 180, alt: 'Client tells Neil they already love working with him.' },
  { src: '/assets/testimonials/testimonial5.webp', w: 864, h: 230, alt: 'Client reacts enthusiastically to a finished design.' },
  { src: '/assets/testimonials/testimonial3.webp', w: 900, h: 246, alt: 'Client approves a conference landing page and thanks Neil for the help.' },
  { src: '/assets/testimonials/testimonial2.webp', w: 490, h: 130, alt: 'Client says the work is perfect.' },
  { src: '/assets/testimonials/testimonial6.webp', w: 482, h: 160, alt: 'Client says the work looks really good.' },
];
---
<section class="hsec" id="praise">
  <span class="eyebrow">What people say</span>
  <h2 class="sec">Straight from the <span class="mark-hl">group chat.</span></h2>
  <p class="praise-note">Real messages from clients, screenshotted as they came in.</p>
  <div class="praise-wall">
    {SHOTS.map((s) => (
      <figure class="praise-shot">
        <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
      </figure>
    ))}
  </div>
</section>
