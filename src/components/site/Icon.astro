---
/* Line icons, Lucide style, 24px grid. One icon per meaning:
     arrow-right     internal link, next
     arrow-left      back to the parent page
     arrow-up-right  external link or another app (WhatsApp, email, booking)
     arrow-up        send (prompt card)
     check           included, a good fit
     x               not included, not a fit (shorter strokes than close)
     plus            expand (FAQ rows; rotates to a cross when open)
     menu            open the phone menu
     close           close a sheet or bar
   Decorative by default (aria-hidden). Pass `label` when the icon is the only content. */
export type IconName = 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'arrow-up' | 'check' | 'x' | 'plus' | 'menu' | 'close';

interface Props {
  name: IconName;
  /** Pixel size for width and height. CSS in site.css usually sizes icons by context. */
  size?: number;
  strokeWidth?: number;
  /** Accessible name. Leave empty for decorative icons. */
  label?: string;
  class?: string;
}

const PATHS: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  'arrow-left': '<path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M7 7h10v10"/>',
  'arrow-up': '<path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  x: '<path d="M17 7 7 17"/><path d="m7 7 10 10"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
};

const { name, size = 16, strokeWidth = 1.75, label, class: className } = Astro.props;
---
<svg
  class:list={['icon', `icon--${name}`, className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={PATHS[name]}
/>
