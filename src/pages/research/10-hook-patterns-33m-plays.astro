import ContentArticle from '../../layouts/ContentArticle.astro';
export const prerender = true;

const faq = [
  { q: 'What makes a good hook for a short-form video?', a: 'A specific number, a claim before any credentials, and a debt the viewer stays to collect. Across 19 posts totalling 33.1M plays, the openings that worked all created an obligation in the first sentence — a fight to resolve, a number to explain, or an instruction weird enough to need justifying.' },
  { q: 'How long do you have to hook someone?', a: 'Three seconds, and the payoff has to land inside about five. The shortest winner in this set resolved its entire premise in 11.7 seconds. Anything that spends the opening on setup has already lost the people who were going to leave.' },
  { q: 'Should I state credentials before the claim?', a: 'No. Every winner here leads with the claim and stacks credentials immediately after. Opening with who you are gives the viewer a reason to decide you are not for them before they have heard anything interesting.' },
