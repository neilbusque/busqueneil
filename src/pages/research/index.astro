---
/* /research: the research view of the resources hub, same table and tabs. The URL and the
   title tag stay as they were for search. Only live studies are listed: an orphan link to a
   page that does not exist yet is worse than no link (see src/data/content-index.ts). */
import AppShell from '../../layouts/AppShell.astro';
import PageHead from '../../components/site/PageHead.astro';
import Section from '../../components/site/Section.astro';
import Breadcrumb from '../../components/site/Breadcrumb.astro';
import ResourceIndex from '../../components/articles/ResourceIndex.astro';
import { articleRows, indexTabs, newestFirst, noteRow, type HubRow } from '../../components/articles/rows';
import { getAllPublished } from '../../lib/posts';
import { SITE_URL } from '../../lib/seo';
import '../../styles/pages/articles.css';

const title = 'Original Research | Neil Busque';
const description = 'Studies built from data I collected myself: competitor ad libraries, viral content transcripts and contact-enrichment error rates, with the method stated on every one.';
const canonical = `${SITE_URL}/research`;

let notes: HubRow[] = [];
try {
  notes = (await getAllPublished({ request: Astro.request, cookies: Astro.cookies })).map(noteRow);
} catch {
  notes = [];
}
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const everything = newestFirst([...articleRows(), ...notes]);
const rows = everything.filter((r) => r.kind === 'research');

const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    '@id': `${canonical}#list`,
    name: 'Original research by Neil Busque',
    numberOfItems: rows.length,
    itemListElement: rows.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.title, url: `${SITE_URL}${r.href}` })),
  },
};
---
<AppShell title={title} description={description} canonical={canonical} active="resources">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <Breadcrumb back={false} items={[{ name: 'Home', url: `${SITE_URL}/` }, { name: 'Research', url: canonical }]} />

  <PageHead
    title="Research from my"
    accent="own data."
    class="rview-head"
    lead="Not a roundup of other people's studies. Each one comes from a dataset I pulled, cleaned and had to make a decision with. The method is on every page, so you can check it or argue with it."
  />

  <Section labelledby="list-title" class="rview-list">
    <h2 class="sr-only" id="list-title">All studies</h2>
    <ResourceIndex rows={rows} tabs={indexTabs(everything, 'view')} active="research" mode="view" label="Resource types" />
  </Section>
</AppShell>
