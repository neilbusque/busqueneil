---
import AppShell from '../../layouts/AppShell.astro';
import Art from '../../components/Art.astro';
import Section from '../../components/site/Section.astro';
import PageHead from '../../components/site/PageHead.astro';
import SectionHead from '../../components/site/SectionHead.astro';
import Button from '../../components/site/Button.astro';
import RuledGrid from '../../components/site/RuledGrid.astro';
import StatCell from '../../components/site/StatCell.astro';
import QuoteCard from '../../components/site/QuoteCard.astro';
import CheckList from '../../components/site/CheckList.astro';
import CtaRow from '../../components/site/CtaRow.astro';
import Breadcrumb from '../../components/site/Breadcrumb.astro';
import LinkRows from '../../components/services/LinkRows.astro';
import { ORGANIZATION_REF, SOCIAL_IMAGE_URL, WEBSITE_REF } from '../../lib/seo';
import { QUOTES, waGlobal } from '../../data/site';
import '../../styles/pages/services.css';

// The middleware also serves this page at the root of hire.busqueneil.com, so it stays
// server-rendered (a rewrite cannot target a prerendered route).
export const prerender = false;

const title = 'Hire an AI developer to lead your AI work | Neil Busque';
const description = 'Bring in one person to find the work worth handing to AI, build it and keep it running. First versions in days. You own the code and accounts.';
const canonical = 'https://busqueneil.com/hire';

const GET = [
  'One person who decides what to hand to AI, builds it and keeps it running',
  'A short list of the jobs worth handing to AI, starting with the one that saves the most time',
  'A working first version in days, then short rounds of changes',
  'AI that asks before anything risky, like spending money or deleting records',
  'The code and the accounts, in your name',
];

const START = [
  'Send me a message about your business and the work you want off your plate.',
  'We talk it through, by message or on a short call.',
  'You get a clear scope and price. Nothing starts until you say yes.',
];

const MORE = [
  { href: '/hire/ai-engineer', title: 'Hire an AI engineer', text: 'Agents, LLM features and the systems around them.' },
  { href: '/hire/ai-automation', title: 'Hire for AI automation', text: 'Workflows that take the busywork off your team.' },
  { href: '/hire/ai-engineer-nj', title: 'An AI engineer in New Jersey', text: 'Local, same time zone, in person when it helps.' },
  { href: '/hire/ai-engineer-nyc', title: 'An AI engineer for NYC teams', text: 'Close to Manhattan, remote for the build.' },
  { href: '/hire/ai-engineer-remote', title: 'A remote AI engineer', text: 'US Eastern time, with frequent preview links.' },
  { href: '/services', title: 'All services', text: 'Agents, apps, automations and sites, side by side.' },
];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: 'AI developer and fractional AI lead',
  url: canonical,
  image: SOCIAL_IMAGE_URL,
  provider: ORGANIZATION_REF,
  brand: ORGANIZATION_REF,
  isPartOf: WEBSITE_REF,
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  areaServed: ['New Jersey', 'New York', 'New York City', 'United States', 'Remote'],
  serviceType: ['Fractional AI lead', 'AI agent development', 'AI automation', 'Custom software development'],
  description,
};
---
<AppShell title={title} description={description} canonical={canonical} ogImage={SOCIAL_IMAGE_URL} active="hire">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(service)} />
  <Breadcrumb back={false} items={[
    { name: 'Home', url: 'https://busqueneil.com/' },
    { name: 'When to hire me', url: canonical },
  ]} />

  <PageHead
    title="When to bring me in, and when"
    accent="not to."
    lead="Bring me in when the busywork keeps growing and nobody on your team owns fixing it. Skip me if a tool you already pay for can do the job. I'll tell you that on the first call."
  >
    <div class="btn-row btn-row--stack">
      <Button href={waGlobal()}>Message me on WhatsApp</Button>
      <Button href="/work" variant="secondary">See the work</Button>
    </div>
    <div slot="aside" class="svc-head-art hire-art">
      <Art seed="hire-bring-me-in" kind="service" ratio="4 / 3" palette="mist" loading="eager" />
    </div>
  </PageHead>

  <Section id="get" labelledby="get-title">
    <div class="svc-split">
      <h2 class="t-h2" id="get-title">What you get when you bring me in</h2>
      <CheckList items={GET} />
    </div>
  </Section>

  <Section band="mist" id="start" labelledby="start-title">
    <SectionHead id="start-title" title="How it starts" />
    <RuledGrid cols={3} class="svc-start" label="How it starts">
      {START.map((s, i) => (
        <div>
          <p class="t-label">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="t-h4">{s}</h3>
        </div>
      ))}
    </RuledGrid>
    <p class="svc-note">You can start with one build and move to a monthly arrangement later.</p>
  </Section>

  <Section id="proof" labelledby="proof-title">
    <SectionHead id="proof-title" title="The record so far" />
    <RuledGrid cols={4} class="svc-proof" label="The record so far">
      <StatCell value="40+" caption="Products shipped in 2026" />
      <StatCell value="6" caption="Agencies and service businesses on operating systems I built and still look after" />
      <StatCell value="2 days" caption="From signing to a live first version of a recruiting system" />
      <QuoteCard quote={QUOTES[0].quote} role={QUOTES[0].role} />
    </RuledGrid>
    <CtaRow
      class="svc-proof-row"
      text="I keep working until you are proud of it. If I am not the right fit, I will tell you on the first call."
      cta={{ href: '/work', label: 'See the work' }}
    />
  </Section>

  <Section id="more" labelledby="more-title">
    <div class="svc-split">
      <div class="svc-split-head">
        <h2 class="t-h2" id="more-title">Bring me in for one thing</h2>
        <p class="t-lead">One page per kind of work, and per area I serve.</p>
      </div>
      <LinkRows rows={MORE} />
    </div>
  </Section>
</AppShell>

<style>
  .hire-art { width: 100%; max-width: 440px; margin-left: auto; }
  @media (max-width: 900px) { .hire-art { max-width: none; } }
</style>
