---
/* /compare: the comparisons view of the resources hub, same table and tabs. The URL and the
   title tag stay as they were for search. Rendered on request so the tab counts include notes
   the moment one is published. */
import AppShell from '../../layouts/AppShell.astro';
import PageHead from '../../components/site/PageHead.astro';
import Section from '../../components/site/Section.astro';
import Breadcrumb from '../../components/site/Breadcrumb.astro';
import ResourceIndex from '../../components/articles/ResourceIndex.astro';
import { articleRows, indexTabs, newestFirst, noteRow, type HubRow } from '../../components/articles/rows';
import { getAllPublished } from '../../lib/posts';
import { SITE_URL } from '../../lib/seo';
import '../../styles/pages/articles.css';

const title = 'Tool Comparisons | Neil Busque';
const description = 'Head-to-head comparisons of the tools I actually ship with: AI coding agents, backends, hosting, automation platforms, and CRMs. First-hand, with the trade-offs stated.';
const canonical = `${SITE_URL}/compare`;

let notes: HubRow[] = [];
try {
  notes = (await getAllPublished({ request: Astro.request, cookies: Astro.cookies })).map(noteRow);
} catch {
  notes = [];
}
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const everything = newestFirst([...articleRows(), ...notes]);
const rows = everything.filter((r) => r.kind === 'comparison');

const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    '@id': `${canonical}#list`,
    name: 'Tool comparisons by Neil Busque',
    numberOfItems: rows.length,
    itemListElement: rows.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.title, url: `${SITE_URL}${r.href}` })),
  },
};
---
<AppShell title={title} description={description} canonical={canonical} active="resources">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <Breadcrumb back={false} items={[{ name: 'Home', url: `${SITE_URL}/` }, { name: 'Compare', url: canonical }]} />

  <PageHead
    title="Tools I ship with,"
    accent="side by side."
    class="rview-head"
    lead="Every comparison here is between tools I've run in production. So I can tell you where each one breaks, which is the part a feature table never covers."
  />

  <Section labelledby="list-title" class="rview-list">
    <h2 class="sr-only" id="list-title">All comparisons</h2>
    <ResourceIndex rows={rows} tabs={indexTabs(everything, 'view')} active="comparison" mode="view" label="Resource types" />
  </Section>
</AppShell>
