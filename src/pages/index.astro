---
import AppShell from '../layouts/AppShell.astro';
import Schema from '../components/Schema.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Testimonials from '../components/Testimonials.astro';
import { getFeed, getNow } from '../lib/posts';
import type { Post } from '../lib/types';

const opts = { request: Astro.request, cookies: Astro.cookies };
const [{ posts: latest }, { current: now }] = await Promise.all([
  getFeed(opts, { page: 1 }),
  getNow(opts),
]);
const latest3 = latest.filter((p) => p.type !== 'now').slice(0, 3);

const WORK = [
  { name: 'Orbit CRM', img: '/assets/work/orbit-app.webp', href: '/case-studies/orbit', tag: 'CRM + AI agents' },
  { name: 'Tandem', img: '/assets/work/tandem.webp', href: '/case-studies/tandem', tag: 'Couples app', note: 'built this for my wife' },
  { name: 'Darioo', img: '/assets/work/darioo.webp', href: '/work', tag: 'Client site + app' },
  { name: 'Otto', img: '/assets/work/otto.webp', href: '/work', tag: 'AI command center' },
];
const WA_BUILD = 'https://wa.me/19083164140?text=Hi%20Neil%2C%20I%20want%20to%20build%20something';
const WA_SHOP = 'https://wa.me/19083164140?text=Hi%20Neil%2C%20about%20the%20shop';

const nowText = now?.title || 'Building in public, every day.';
const nowDateStr = now?.published_at
  ? new Date(now.published_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

function shortDate(iso: string | null): string {
  return iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
}
function tagFor(p: Post): string {
  if (p.tags?.includes('video')) return 'Video';
  if (p.type === 'article') return p.tags.includes('tutorial') ? 'Tutorial' : 'Article';
  const map: Record<string, string> = { status: 'Thought', project: 'Build', now: 'Now' };
  return map[p.type] ?? 'Post';
}
---
<AppShell title="Neil Busque — AI Product Builder" description="Custom AI apps, websites, and automations, designed and shipped directly by Neil Busque. From rough idea to working product, usually in days." active="home">
  <Fragment slot="head"><Schema /></Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-copy">
      <p class="hero-kicker"><span>Neil Busque</span><i aria-hidden="true"></i>Independent product builder</p>
      <h1>From rough idea to <span class="hero-em">working product.</span></h1>
      <p class="hero-sub">I design and build custom apps, websites, and automations for founders and small teams. You work directly with me from the first sketch to the live link, usually in days.</p>
      <div class="hero-ctas">
        <a class="btn-sun" href="/contact">Tell me what you&rsquo;re building</a>
        <a class="btn-ghost" href="/work">See live work</a>
      </div>
      <p class="hero-reassurance"><span aria-hidden="true">&#10003;</span> One builder, no agency handoffs, no black-box platform.</p>
    </div>
    <figure class="hero-photo-wrap">
      <div class="hero-photo-stage" aria-hidden="true">
        <span class="hero-stage-index">01 / DESIGN &middot; BUILD &middot; LAUNCH</span>
        <span class="hero-monogram">NB</span>
        <span class="hero-stage-line"></span>
      </div>
      <img class="hero-photo" src="/assets/art/neil-cutout.webp" alt="Neil Busque, product designer and builder" width="640" height="1413" fetchpriority="high" decoding="async" />
      <figcaption class="hero-caption">You talk to the person doing the work.</figcaption>
    </figure>
  </section>

  <!-- STATS -->
  <div class="stats">
    <div class="stat"><b>40+</b><span>products shipped in 2026</span></div>
    <div class="stat"><b>Days</b><span>idea to first version</span></div>
    <div class="stat"><b>1:1</b><span>direct from start to finish</span></div>
  </div>

  <!-- CLIENTS -->
  <section class="hsec client-proof">
    <span class="eyebrow">Trusted by teams at</span>
    <ClientLogos />
  </section>

  <!-- WORK -->
  <section class="hsec">
    <span class="eyebrow">Selected work</span>
    <h2 class="sec">Real products, <span class="mark-hl">live</span> right now.</h2>
    <div class="workgrid">
      {WORK.map((w) => (
        <a class="workcard" href={w.href}>
          {w.note && <span class="worknote">{w.note}</span>}
          <img
            src={w.img}
            srcset={`${w.img.replace('.webp', '-sm.webp')} 760w, ${w.img} 1440w`}
            sizes="(max-width: 980px) calc(100vw - 40px), 50vw"
            alt={w.name}
            width="1280" height="800"
            loading="lazy"
          />
          <div class="workmeta"><b>{w.name}</b><span>{w.tag}</span></div>
        </a>
      ))}
    </div>
    <p style="margin-top:22px"><a class="link-arrow" href="/work">All work
      <svg width="44" height="16" viewBox="0 0 44 16" fill="none" aria-hidden="true"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#242424" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
  </section>

  <!-- PRAISE -->
  <Testimonials />

  <!-- SERVICES -->
  <section class="hsec">
    <span class="eyebrow">What I build</span>
    <h2 class="sec">One partner for the <span class="mark-hl">whole build.</span></h2>
    <ul class="svc">
      <li><span class="num">01</span><span class="name">Web Apps</span><span class="desc">Portals, dashboards, and tools that people can actually use. Not demos.</span></li>
      <li><span class="num">02</span><span class="name">Websites</span><span class="desc">Fast, original sites built around your offer, not a recycled template.</span></li>
      <li><span class="num">03</span><span class="name">Landing Pages</span><span class="desc">One focused page with one job: turn the right visitor into a lead.</span></li>
      <li><span class="num">04</span><span class="name">Funnels</span><span class="desc">The full path from first click to booked call, wired end to end.</span></li>
      <li><span class="num">05</span><span class="name">Automation</span><span class="desc">AI, n8n, Zapier, GHL, and custom systems that keep busywork moving.</span></li>
    </ul>
  </section>

  <!-- SHOP -->
  <section class="hsec">
    <span class="eyebrow">Shop</span>
    <h2 class="sec">Things I made that <span class="mark-hl">you can buy.</span></h2>
    <p style="color:var(--muted); max-width:56ch; margin-top:14px;">The shop opens soon. Templates, playbooks, and the tools I use to ship real products, packaged for you.</p>
    <p style="margin-top:18px"><a class="btn-sun" href={WA_SHOP}>Tell me what you want first</a></p>
    <p style="margin-top:14px"><span class="hand">first drops are in the works</span></p>
  </section>

  <!-- NOW + BLOG -->
  <section class="hsec">
    <span class="eyebrow">Personal</span>
    <h2 class="sec">What I&rsquo;m <span class="mark-hl">up to.</span></h2>
    <div class="nowwrap">
      <div>
        <span class="nowlabel">right now:</span>
        <p class="nowtext">{nowText}</p>
        {nowDateStr && <span class="nowdate">Updated {nowDateStr}</span>}
      </div>
      <div>
        {latest3.length > 0 ? (
          <>
            <ul class="postlist">
              {latest3.map((p) => (
                <li>
                  <a href={`/posts/${p.slug}`}>
                    <span class="pd">{shortDate(p.published_at)}</span>
                    <span class="pt">{p.title ?? 'Untitled'}</span>
                    <span class:list={['tag', { video: p.tags.includes('video') }]}>{tagFor(p)}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p style="margin-top:18px"><a class="link-arrow" href="/blog">Read the blog
              <svg width="44" height="16" viewBox="0 0 44 16" fill="none" aria-hidden="true"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#242424" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
          </>
        ) : (
          <div class="v8-card nowcta">
            <p>Most of what I build never makes it to a blog post. The fastest way to see whether I can build your thing is to ask me.</p>
            <div class="hero-ctas" style="margin-top:16px">
              <a class="btn-sun" href="/contact">Send me your idea</a>
              <a class="btn-ghost" href="/work">See the work</a>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- STATEMENT -->
  <div class="statement">
    <p>Anyone can use AI. <span class="mark-hl">Finished</span> <span class="script">is what you hire me for.</span></p>
  </div>

  <!-- DARK CTA -->
  <div class="darkcta">
    <h2>Tell me what you want to <span class="mark-hl">build.</span></h2>
    <p>Send me the idea in a few sentences. I answer personally, usually the same day.</p>
    <p class="guarantee-line">I keep working until you are proud of it. If I am not the right fit, I will tell you on the first call.</p>
    <div class="hero-ctas" style="margin-top:0">
      <a class="btn-sun" href="/contact">Send me your idea</a>
      <a class="btn-ghost" href={WA_BUILD}>Or message on WhatsApp</a>
    </div>
    <img class="sig" src="/assets/brand/sig-sun.webp" alt="Neil" width="280" height="165" loading="lazy" />
  </div>
</AppShell>
