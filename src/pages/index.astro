---
import AppShell from '../layouts/AppShell.astro';
import IntroCinematic from '../components/IntroCinematic.astro';
import Schema from '../components/Schema.astro';
import ClientLogos from '../components/ClientLogos.astro';
import StackIcon from '../components/StackIcon.astro';
import Testimonials from '../components/Testimonials.astro';
import { getFeed, getNow } from '../lib/posts';
import type { Post } from '../lib/types';

const opts = { request: Astro.request, cookies: Astro.cookies };
const [{ posts: latest }, { current: now }] = await Promise.all([
  getFeed(opts, { page: 1 }),
  getNow(opts),
]);
const latest3 = latest.filter((p) => p.type !== 'now').slice(0, 3);

const WORK = [
  { name: 'Orbit CRM', img: '/assets/work/orbit-app.webp', href: '/case-studies/orbit', tag: 'CRM + AI agents', clip: 'orbit' },
  { name: 'Tandem', img: '/assets/work/tandem.webp', href: '/case-studies/tandem', tag: 'Couples app', note: 'built this for my wife', clip: 'tandem' },
  { name: 'Darioo', img: '/assets/work/darioo.webp', href: '/work', tag: 'Client site + app', clip: 'darioo' },
  { name: 'Scott Greenleaf', img: '/assets/work/scottgreenleaf.webp', href: 'https://scottgreenleaf.com/', tag: 'Client site' },
];
/* `clip` = a muted looping screen recording of the real product, played only when the card is
   on screen and only when motion is allowed. The Greenleaf card has no clip: it is a site, and
   its hero says more in a still than a scroll recording would.
   ⚠️ Greenleaf replaced Otto here (Neil). Two different things share that name, so keep them
   straight: THIS card is the shipped client site at scottgreenleaf.com, which Neil built. The
   separate concept rebuild at greenleaf.busqueneil.com was never adopted and lives in the
   concepts band on /work. A fresh headless capture of scottgreenleaf.com renders an empty hero
   (the GHL hero widget lazy-loads), which is why the shot on file stays. */
const WA_BUILD = 'https://wa.me/19083164140?text=Hi%20Neil%2C%20I%20want%20to%20build%20something';

/* Grouped by job rather than by vendor, so a visitor scanning for "do you know my CRM"
   finds it in one place instead of reading a flat logo soup. */
const STACK = [
  { label: 'Build', items: ['Claude', 'Codex', 'VS Code', 'Astro', 'Next.js', 'React', 'TypeScript', 'Node'] },
  { label: 'Infrastructure', items: ['Vercel', 'Railway', 'Supabase', 'Postgres', 'Cloudflare', 'Porkbun'] },
  // Neil's actual strength, so it gets its own group instead of being buried in Automation
  { label: 'APIs and integrations', items: ['REST APIs', 'Webhooks', 'MCP servers', 'OAuth', 'Puppeteer'] },
  { label: 'Automation', items: ['n8n', 'Zapier', 'Make'] },
  { label: 'CRM and email', items: ['GoHighLevel', 'HubSpot', 'Klaviyo', 'Resend', 'Mailgun', 'Twilio'] },
  { label: 'Web and commerce', items: ['WordPress', 'Shopify', 'Stripe', 'ClickFunnels'] },
  { label: 'AI and media', items: ['OpenRouter', 'ElevenLabs', 'Remotion', 'Kie.ai'] },
  { label: 'Social', items: ['Zernio', 'Postiz'] },
  { label: 'Design', items: ['Figma', 'Canva', 'Photoshop', 'Illustrator'] },
  { label: 'Ads', items: ['Meta Ads', 'Google Ads'] },
  { label: 'Analytics and SEO', items: ['GA4', 'Search Console', 'DataForSEO'] },
  { label: 'Data', items: ['Apify', 'Firecrawl', 'Trawl'] },
];

const nowPublished = now?.published_at ? new Date(now.published_at) : null;
const nowIsFresh = nowPublished ? Date.now() - nowPublished.getTime() < 1000 * 60 * 60 * 24 * 75 : false;
const nowText = nowIsFresh ? (now?.title || 'Building something new.') : 'Building, writing, and getting better at both.';
const nowDateStr = now?.published_at
  ? new Date(now.published_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

function shortDate(iso: string | null): string {
  return iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
}
function tagFor(p: Post): string {
  if (p.tags?.includes('video')) return 'Video';
  if (p.type === 'article') return p.tags.includes('tutorial') ? 'Tutorial' : 'Article';
  const map: Record<string, string> = { status: 'Thought', project: 'Build', now: 'Now' };
  return map[p.type] ?? 'Post';
}
---
<AppShell title="Neil Busque | AI Engineer and Product Builder" description="I build AI agents, automations, web apps, and websites for small teams. You work with me directly, and most first versions ship in days." active="home">
  <IntroCinematic slot="intro" />
  <Fragment slot="head"><Schema /></Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-field" aria-hidden="true"></div>
    <div>
      <h1>Hey!! I&rsquo;m Neil <span class="wave" aria-hidden="true">&#128075;</span></h1>
      <p class="hero-sub">I build the useful version of your idea: AI agents, web apps, websites, funnels, and automations. You work with me directly, and most first versions are live in days.</p>
      <div class="hero-ctas">
        <a class="btn-sun" href="/hire">Start your build</a>
        <a class="link-arrow" href="/work">See the work
          <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#242424" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
    <div class="hero-photo-wrap">
      {/* The nbsp glues "AI assistants": unglued, the 190px note broke after "my AI" and
          stranded "assistants" alone on line 3. Gluing "my AI" instead does nothing, since
          that was never where it broke. */}
      <span class="note who">the guy who actually builds it, and my AI&nbsp;assistants
        <!-- v11: the note now sits ABOVE and right of the figure, so the arrow points down-LEFT
             at him. It pointed down-right when the note lived to his left. -->
        <svg width="60" height="34" viewBox="0 0 60 34" fill="none"><path d="M52 2 C 40 16, 28 22, 12 28 M20 22 L 10 29 L 22 32" stroke="#16150F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <img class="hero-photo" src="/assets/art/neil-cutout.webp" alt="Neil Busque" width="640" height="1413" fetchpriority="high" />
      {/* The Claude Code sticker mascot and the Codex cloud, the actual marks rather than
          lookalikes, shown the way a tech-stack badge is: a truthful statement that these are
          the tools Neil works in, which the site already says in prose. No partnership or
          endorsement is claimed anywhere. Decorative here, so aria-hidden. */}
      <div class="hero-pets" aria-hidden="true">
        <img class="pet pet-a" src="/assets/art/pet-claude.webp" width="523" height="420" alt="" loading="lazy" decoding="async" />
        <img class="pet pet-b" src="/assets/art/pet-codex.webp" width="460" height="460" alt="" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- STATS -->
  <div class="stats">
    <div class="stat"><b>40+</b><span>products shipped in 2026</span></div>
    <!-- the sublabel has to carry the number, or "Days" alone reads as a missing value
         next to "40+" and "1 person" -->
    <div class="stat"><b>Days</b><span>not months. idea to first version</span></div>
    <div class="stat"><b>1 person</b><span>start to finish, no handoffs</span></div>
  </div>

  <!-- SERVICES -->
  <section class="hsec">
    <span class="eyebrow">What I do</span>
    <h2 class="sec">Five ways I can <span class="mark-hl">help.</span></h2>
    <ul class="svc">
      <li>
        <a class="svc-row" href="/services/web-apps">
          <span class="num">01</span>
          <span class="svc-art" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect class="cell" x="5" y="8" width="14" height="10" rx="2"/><path d="M5 12h14M9 21h6"/></svg></span>
          <span class="name">Web Apps</span>
          <span class="desc">Portals, dashboards, and internal tools your team can actually use.</span>
          <span class="svc-cta" aria-hidden="true">&#8594;</span>
        </a>
      </li>
      <li>
        <a class="svc-row" href="/services/websites">
          <span class="num">02</span>
          <span class="svc-art" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect class="cell" x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M7 13h7"/></svg></span>
          <span class="name">Websites</span>
          <span class="desc">Fast, custom sites that feel like your business, not a template.</span>
          <span class="svc-cta" aria-hidden="true">&#8594;</span>
        </a>
      </li>
      <li>
        <a class="svc-row" href="/services/landing-pages">
          <span class="num">03</span>
          <span class="svc-art" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect class="cell" x="6" y="3" width="12" height="18" rx="2"/><path d="M9 8h6M9 12h6"/><path d="M9 17h4"/></svg></span>
          <span class="name">Landing Pages</span>
          <span class="desc">A focused page that makes the next step obvious.</span>
          <span class="svc-cta" aria-hidden="true">&#8594;</span>
        </a>
      </li>
      <li>
        <a class="svc-row" href="/services/funnels">
          <span class="num">04</span>
          <span class="svc-art" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v6l-4 2v-8z"/><rect class="cell" x="10" y="14" width="4" height="4"/></svg></span>
          <span class="name">Funnels</span>
          <span class="desc">From first click to booked call, with every handoff connected.</span>
          <span class="svc-cta" aria-hidden="true">&#8594;</span>
        </a>
      </li>
      <li>
        <a class="svc-row" href="/services/ai-automation-services">
          <span class="num">05</span>
          <span class="svc-art" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="3"/><rect class="cell" x="14" y="4" width="6" height="6"/><path d="M7 10v4a3 3 0 0 0 3 3h7"/><path d="M15 15l2 2-2 2"/></svg></span>
          <span class="name">Automation</span>
          <span class="desc">n8n, Zapier, and GHL workflows that take repetitive work off your plate.</span>
          <span class="svc-cta" aria-hidden="true">&#8594;</span>
        </a>
      </li>
    </ul>
    <p style="margin-top:22px"><a class="link-arrow" href="/services">All services
      <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#16150F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
  </section>

  {/* No subscription card here on purpose: /unlimited is an unlisted offer Neil sends
      directly, so the site must not surface it. */}

  <!-- CLIENTS -->
  <section class="hsec">
    <span class="eyebrow">Worked with</span>
    <ClientLogos />
  </section>

  <!-- WORK -->
  <section class="hsec">
    <span class="eyebrow">Selected work</span>
    <h2 class="sec">Working products you can <span class="mark-hl">open.</span></h2>
    <div class="workgrid">
      {WORK.map((w) => (
        <a class="workcard" href={w.href} target={w.href.startsWith('http') ? '_blank' : undefined} rel={w.href.startsWith('http') ? 'noopener' : undefined}>
          {w.note && <span class="worknote">{w.note}</span>}
          <div class="wc-chrome" aria-hidden="true"><i></i><i></i><i></i><span class="wc-bar"></span></div>
          <div class="wc-shot">
            {w.clip
              ? <video
                  class="wc-video"
                  poster={`/assets/work/${w.clip}-poster.webp`}
                  width="960" height="600"
                  muted loop playsinline preload="none"
                  aria-label={`${w.name}, recorded`}
                  data-wc-clip
                >
                  {/* H.264 first on purpose. Chrome picks the first source it can play, and
                      three concurrent VP9 decodes on this page produced MEDIA_ERR_DECODE on two
                      of the three cards while H.264 decodes fine (and is hardware-accelerated). */}
                  <source src={`/assets/work/${w.clip}.mp4`} type="video/mp4" />
                  <source src={`/assets/work/${w.clip}.webm`} type="video/webm" />
                </video>
              : <img
                  src={w.img}
                  srcset={`${w.img.replace('.webp', '-sm.webp')} 760w, ${w.img} 1440w`}
                  sizes="(max-width: 980px) calc(100vw - 40px), 50vw"
                  alt={w.name}
                  width="1280" height="800"
                  loading="lazy"
                />}
            <span class="wc-live">Live</span>
          </div>
          <div class="workmeta"><b>{w.name}</b><span>{w.tag}</span></div>
        </a>
      ))}
    </div>
    <p style="margin-top:22px"><a class="link-arrow" href="/work">All work
      <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#242424" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
  </section>

  <!-- PRAISE -->
  <Testimonials />

  <!-- NOW + BLOG -->
  <section class="hsec">
    <span class="eyebrow">Personal</span>
    <h2 class="sec">What I&rsquo;m <span class="mark-hl">up to.</span></h2>
    <div class="nowwrap">
      <div>
        <span class="nowlabel">right now:</span>
        <p class="nowtext">{nowText}</p>
        {nowDateStr && <span class="nowdate">Updated {nowDateStr}</span>}
      </div>
      <div>
        {latest3.length > 0 ? (
          <>
            <ul class="postlist">
              {latest3.map((p) => (
                <li>
                  <a href={`/posts/${p.slug}`}>
                    <span class="pd">{shortDate(p.published_at)}</span>
                    <span class="pt">{p.title ?? 'Untitled'}</span>
                    <span class:list={['tag', { video: p.tags.includes('video') }]}>{tagFor(p)}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p style="margin-top:18px"><a class="link-arrow" href="/blog">Read the blog
              <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#242424" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
          </>
        ) : (
          <div class="v8-card nowcta">
            <p>Most of what I build never becomes a post. The fastest way to find out if I can build yours is to ask.</p>
            <div class="hero-ctas" style="margin-top:16px">
              <a class="btn-sun" href="https://book.busqueneil.com/" target="_blank" rel="noopener">Book a call</a>
              <a class="btn-ghost" href="/work">See the work</a>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- STATEMENT -->
  <div class="statement">
    <p>AI can start the work. <span class="mark-hl">Finished</span> <span class="script">is what you hire me for.</span></p>
    <p class="statement-sub">The first draft is fast. The real job is making it dependable enough for customers and coworkers.</p>
  </div>

  <!-- STACK -->
  <section class="hsec">
    <span class="eyebrow">Tools I work in</span>
    <h2 class="sec">The <span class="mark-hl">stack.</span></h2>
    <p class="stack-note">My favorite part is making two tools that were never meant to talk work together. Webhooks, OAuth, MCP servers, whatever the job needs.</p>
    <div class="stack">
      {STACK.map((group) => (
        <div class="stack-group">
          <span class="stack-label">{group.label}</span>
          <ul class="stack-list">
            {group.items.map((t) => <StackIcon name={t} />)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- GUARANTEE -->
  <!-- DIY -->
  <!-- Grounded in what people actually report about the AI app builders: credits vanishing in
       debugging loops, a fix that creates two new bugs, hallucinated imports and layouts that
       break on real use, and being locked to whatever stack the tool picked. No vendor named:
       naming dates fast and reads petty, and the pattern is the same across all of them. -->
  <section class="hsec">
    <span class="eyebrow">Why not just build it yourself</span>
    <h2 class="sec">The demo is easy. <span class="mark-hl">The last 20% is not.</span></h2>
    <p class="stack-note">I use them too. They are great for a first pass. The trouble starts when the app has real users, real data, and edge cases.</p>
    <ul class="diy">
      <li>
        <b>The first screen looks finished in an afternoon.</b>
        <span>Then a real user takes the path the demo never covered.</span>
      </li>
      <li>
        <b>Then the debugging loop starts.</b>
        <span>One fix creates another bug, the context gets messier, and you stop knowing which change caused what.</span>
      </li>
      <li>
        <b>The code can look right and still be wrong.</b>
        <span>A package that does not exist. A layout that breaks on a phone. A permission rule that exposes the wrong data.</span>
      </li>
      <li>
        <b>You inherit choices you never made.</b>
        <span>The stack, the host, and the database shape are already decided. Changing them later is the expensive part.</span>
      </li>
    </ul>
    <p class="diy-close">I use the speed. I still own the engineering.</p>
  </section>

  <!-- WHY ME -->
  <section class="hsec">
    <span class="eyebrow">Why people pick me</span>
    <h2 class="sec">Your thing becomes <span class="mark-hl">my thing.</span></h2>
    <ul class="why">
      <li>
        <b>I know what we talked about last time.</b>
        <span>I keep the client list short on purpose. You do not have to re-explain the project every time you message me.</span>
      </li>
      <li>
        <b>You get my actual phone number.</b>
        <span>Me, on WhatsApp, usually the same day. No ticket queue in between.</span>
      </li>
      <li>
        <b>Going live is not the finish line.</b>
        <span>I want the thing doing the job you hired it to do, and I keep working until it does.</span>
      </li>
      <li>
        <b>I care about the handoff.</b>
        <span>You should understand what you own, where it lives, and what to do when something changes.</span>
      </li>
    </ul>
  </section>

  <section class="hsec">
    <span class="eyebrow">Working with me</span>
    <h2 class="sec">The <span class="mark-hl">guarantee.</span></h2>
    <ul class="guar">
      <li>
        <b>I keep working until you are proud of it.</b>
        <span>Done means the agreed build works and you are happy to put your name on it.</span>
      </li>
      <li>
        <b>If I am not the right fit, I tell you on the first call.</b>
        <span>Costs you nothing, and you leave with an honest read on your problem.</span>
      </li>
      <li>
        <b>You talk to me. Every time.</b>
        <span>One person from the first call to live.</span>
      </li>
      <li>
        <b>You see the scope before I start.</b>
        <span>We agree on the job, timeline, and price before I build. No vague invoice at the end.</span>
      </li>
    </ul>
  </section>

  <!-- DARK CTA -->
  <div class="darkcta">
    <h2>Got something you want <span class="mark-hl">built?</span></h2>
    <p>A rough idea is enough. Book a call and I will tell you how I would approach it, or send it over on WhatsApp if that is easier.</p>
    <div class="hero-ctas" style="margin-top:0">
      <a class="btn-sun" href="https://book.busqueneil.com/" target="_blank" rel="noopener">Book a call</a>
      <a class="btn-ghost" href={WA_BUILD} target="_blank" rel="noopener">Or message me on WhatsApp</a>
    </div>
    <img class="sig" src="/assets/brand/sig-sun.webp" alt="Neil" width="280" height="165" loading="lazy" />
  </div>
</AppShell>
