---
import AppShell from '../layouts/AppShell.astro';
import Schema from '../components/Schema.astro';
import { getFeed, getNow } from '../lib/posts';
import { isNowFresh } from '../lib/now';
import type { Post } from '../lib/types';

const opts = { request: Astro.request, cookies: Astro.cookies };
const [{ posts: latest }, { current: now }] = await Promise.all([
  getFeed(opts, { page: 1 }),
  getNow(opts),
]);
const latest3 = latest.filter((post) => post.type !== 'now').slice(0, 3);

const WA_BUILD = 'https://wa.me/19083164140?text=Hi%20Neil%2C%20I%20want%20to%20build%20something';
const LINKEDIN = 'https://www.linkedin.com/in/neilbusque/';

const CAPABILITIES = [
  {
    number: '01',
    name: 'AI agents',
    description: 'Agents, assistants, and voice tools that answer questions, follow up, qualify leads, and help move work forward.',
  },
  {
    number: '02',
    name: 'Custom software',
    description: 'Web apps, portals, dashboards, internal tools, and client-facing products built around the way people really work.',
  },
  {
    number: '03',
    name: 'Automations',
    description: 'n8n, Zapier, GoHighLevel, APIs, webhooks, and the small connections that make a business run smoother.',
  },
  {
    number: '04',
    name: 'Websites and funnels',
    description: 'Fast sites, landing pages, and simple flows that make it obvious what to do next.',
  },
];

const WORK = [
  {
    name: 'Orbit CRM',
    description: 'A CRM and operations workspace with AI features, built to help manage work in one place.',
    img: '/assets/work/orbit-app.webp',
    href: '/case-studies/orbit',
    label: 'CRM + AI agents',
  },
  {
    name: 'Tandem',
    description: 'A couples app built around connection, shared experience, and product thinking.',
    img: '/assets/work/tandem.webp',
    href: '/case-studies/tandem',
    label: 'Personal product',
  },
  {
    name: 'Darioo',
    description: 'A client site and app built to support the business with something real people can use.',
    img: '/assets/work/darioo.webp',
    href: 'https://darioo.com',
    label: 'Client site + app',
  },
  {
    name: 'Scott Greenleaf',
    description: 'A client site focused on clarity, presentation, and getting the message across cleanly.',
    img: '/assets/work/scottgreenleaf.webp',
    href: 'https://scottgreenleaf.com/',
    label: 'Client site',
  },
];

const TOPICS = [
  'Building apps with AI',
  'Automations and workflow systems',
  'Design decisions',
  'Product ideas',
  'Experiments that worked',
  'Experiments that did not',
  'Lessons from client projects',
  'Things I am figuring out in real time',
];

const nowIsFresh = isNowFresh(now?.published_at);
const nowText = nowIsFresh
  ? (now?.title || now?.excerpt || 'Building something new.')
  : 'Right now I am focused on building better software, writing more, and getting sharper at turning rough ideas into things people can actually use.';
const nowDate = nowIsFresh && now?.published_at
  ? new Date(now.published_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

function shortDate(iso: string | null): string {
  return iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
}

function tagFor(post: Post): string {
  if (post.tags?.includes('video')) return 'Video';
  if (post.type === 'article') return post.tags.includes('tutorial') ? 'Tutorial' : 'Note';
  const map: Record<string, string> = { status: 'Thought', project: 'Build', now: 'Now' };
  return map[post.type] ?? 'Note';
}
---
<AppShell
  title="Neil Busque — I Build Cool Stuff with AI"
  description="Apps, automations, AI agents, and little internet projects by Neil Busque. See the work, read the notes, and follow what he is building now."
  ogImage="https://busqueneil.com/assets/brand/og-journal.png"
  active="home"
>
  <Fragment slot="head"><Schema /></Fragment>

  <div class="journal-home">
    <section class="hero journal-hero">
      <div class="hero-copy">
        <span class="eyebrow">Neil Busque · builder</span>
        <h1>I build <em>cool stuff</em> with AI.</h1>
        <p class="hero-sub">I make apps, automations, AI agents, and little internet projects. Some are for clients. Some are ideas I want to see exist. This site is where I share the work, what I&rsquo;m learning, and what I&rsquo;m building right now.</p>
        <div class="hero-ctas">
          <a class="btn-sun" href={WA_BUILD} target="_blank" rel="noopener">Message me on WhatsApp</a>
          <a class="link-arrow" href="/work">See what I&rsquo;m building <span aria-hidden="true">↘</span></a>
        </div>
      </div>
      <div class="hero-visual">
        <figure class="hero-product">
          <div class="hero-product-bar" aria-hidden="true">
            <span></span><span></span><span></span><strong>A real thing I built</strong>
          </div>
          <img src="/assets/work/orbit-app.webp" srcset="/assets/work/orbit-app-sm.webp 760w, /assets/work/orbit-app.webp 1440w" sizes="(max-width: 1020px) calc(100vw - 4rem), 48vw" alt="Orbit CRM and operations workspace designed and built by Neil Busque" width="1280" height="800" fetchpriority="high" />
          <figcaption><span>Orbit CRM</span><strong>Software + AI agents</strong></figcaption>
        </figure>
        <figure class="hero-person">
          <img src="/assets/art/neil-cutout.webp" alt="Neil Busque" width="640" height="1413" fetchpriority="high" />
          <figcaption><strong>Neil Busque</strong><span>The person building the work.</span></figcaption>
        </figure>
      </div>
    </section>

    <div class="journal-strip" aria-label="How Neil works">
      <span>Direct with Neil</span><i aria-hidden="true"></i><span>No middleman</span><i aria-hidden="true"></i><span>You own the work</span>
    </div>

    <section class="journal-section journal-intro">
      <div>
        <span class="eyebrow">Intro</span>
        <h2>I like building useful things.</h2>
      </div>
      <div class="journal-copy">
        <p>I like building useful things that save time, remove friction, or make someone&rsquo;s day a little easier. Most of my work lives somewhere between software, automation, design, and figuring out how to make a messy process feel simple.</p>
        <p>I work with business owners, teams, and people with ideas who need someone to actually build the thing. I also use this space like a notebook, so not everything here is polished. Some of it is finished work. Some of it is what I am testing and learning in public.</p>
      </div>
    </section>

    <section class="journal-section">
      <div class="journal-heading">
        <span class="eyebrow">Things I build</span>
        <h2>Capabilities, not a service menu.</h2>
        <p>Different kinds of work, usually connected by the same goal: make the complicated part feel simple.</p>
      </div>
      <ol class="cap-index">
        {CAPABILITIES.map((capability) => (
          <li>
            <span class="cap-number">{capability.number}</span>
            <h3>{capability.name}</h3>
            <p>{capability.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="journal-section">
      <div class="journal-heading split">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2>Things that made it out of my head.</h2>
        </div>
        <a class="link-arrow" href="/work">See all work <span aria-hidden="true">↘</span></a>
      </div>
      <div class="journal-work">
        {WORK.map((item, index) => {
          const external = item.href.startsWith('http');
          return (
            <a class:list={['journal-work-item', { featured: index === 0 }]} href={item.href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
              <div class="journal-work-shot">
                <img src={item.img} srcset={`${item.img.replace('.webp', '-sm.webp')} 760w, ${item.img} 1440w`} sizes={index === 0 ? '(max-width: 900px) calc(100vw - 2rem), 72vw' : '(max-width: 900px) calc(100vw - 2rem), 34vw'} alt={`${item.name}, built by Neil Busque`} width="1280" height="800" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              </div>
              <div class="journal-work-meta">
                <span>{item.label}</span>
                <h3>{item.name}</h3>
                <p>{item.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="journal-section journal-notes">
      <div class="journal-heading split">
        <div>
          <span class="eyebrow">Notes from building</span>
          <h2>What I&rsquo;m learning while I make things.</h2>
        </div>
        <a class="link-arrow" href="/blog">Read all notes <span aria-hidden="true">↘</span></a>
      </div>
      <p class="journal-notes-lede">I do not just want a portfolio. I want a place to share what I am working on, what I am learning, what is breaking, what is getting better, and what I am noticing as I build.</p>
      {latest3.length > 0 ? (
        <ul class="journal-posts">
          {latest3.map((post) => (
            <li>
              <a href={`/posts/${post.slug}`}>
                <span class="journal-post-date">{shortDate(post.published_at)}</span>
                <span class="journal-post-title">{post.title ?? 'Untitled'}</span>
                <span class="journal-post-tag">{tagFor(post)}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="journal-empty">The notebook is open. New notes will show up here as I publish them.</div>
      )}
      <ul class="topic-list" aria-label="Topics Neil writes about">
        {TOPICS.map((topic) => <li>{topic}</li>)}
      </ul>
    </section>

    <section class="newsletter-panel" aria-labelledby="newsletter-title">
      <div>
        <span class="eyebrow">Newsletter · coming soon</span>
        <h2 id="newsletter-title">Build notes, sent occasionally.</h2>
      </div>
      <div>
        <p>I&rsquo;m putting together a small newsletter about the things I build, what breaks, and what I learn fixing it. No signup box yet&mdash;I want the sending side ready before I ask for your email.</p>
        <a href={LINKEDIN} target="_blank" rel="me noopener">Follow me on LinkedIn for now <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="journal-section">
      <div class="journal-heading">
        <span class="eyebrow">Free things I made</span>
        <h2>Useful now. No sales call required.</h2>
      </div>
      <div class="magnet-grid">
        <a class="magnet analyzer" href="/analyzer">
          <span class="magnet-label">Interactive tool</span>
          <strong class="magnet-mark">100</strong>
          <h3>Landing Page Analyzer</h3>
          <p>Paste a page, get a score, and see what is helping or hurting it. The score is free; email is optional for the full PDF report.</p>
          <span class="magnet-link">Analyze a page <span aria-hidden="true">↘</span></span>
        </a>
        <a class="magnet report" href="/viral-post-heist.pdf" download>
          <span class="magnet-label">Six-page field report</span>
          <strong class="magnet-mark">300+</strong>
          <h3>The Viral Post Heist</h3>
          <p>How I used AI to study hundreds of top-performing posts, extract the patterns, and turn the research into a month of content.</p>
          <span class="magnet-link">Download the PDF <span aria-hidden="true">↓</span></span>
        </a>
      </div>
    </section>

    <section class="journal-section journal-now">
      <div>
        <span class="eyebrow">Now</span>
        <h2>What I&rsquo;m focused on right now.</h2>
      </div>
      <div class="now-note">
        <p>{nowText}</p>
        <p>I am especially interested in custom software, AI tools that do real work, workflow systems, and products that feel simple on the surface even when the backend is doing a lot.</p>
        {nowDate && <span>Updated {nowDate}</span>}
        <a href="/now">Read the full now page <span aria-hidden="true">↘</span></a>
      </div>
    </section>

    <section class="journal-section journal-two-up">
      <article>
        <span class="eyebrow">Why work with me</span>
        <h2>One person, all the way through.</h2>
        <p>You work directly with me from the first message to the finished build. No handoff, no account manager, no trying to explain the same project five different times.</p>
        <p>I like moving fast, but I also care about making things dependable. Getting something to look finished is one thing. Making it actually work in real life is the part I take seriously.</p>
      </article>
      <article>
        <span class="eyebrow">About</span>
        <h2>Design, software, systems, and AI.</h2>
        <p>I studied IT, went deep into design, and ended up in the middle of software, systems, and AI. That mix is probably why I like this work so much. I care about how things function, but I also care about how they feel to use.</p>
        <p>This site is my corner of the internet. Part portfolio, part blog, part working notebook.</p>
        <a href="/story">More about me <span aria-hidden="true">↘</span></a>
      </article>
    </section>

    <section class="journal-cta">
      <span class="eyebrow">Got an idea?</span>
      <h2>Got an idea, a broken process, or something you want built?</h2>
      <p>Message me on WhatsApp and I&rsquo;ll tell you how I&rsquo;d approach it.</p>
      <div class="hero-ctas">
        <a class="btn-sun" href={WA_BUILD} target="_blank" rel="noopener">Message me on WhatsApp</a>
        <a class="btn-ghost" href="/blog">Or read my notes</a>
      </div>
      <img class="sig" src="/assets/brand/sig-sun.webp" alt="Neil" width="280" height="165" loading="lazy" />
    </section>
  </div>
</AppShell>
