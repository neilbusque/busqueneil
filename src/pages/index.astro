---
/* Home: the landing page that converts. Section order and copy follow the design blueprint
   (Home) and the copy deck's HOME section. Lists come from src/data/site.ts; section headings
   and leads live here. Server rendered on purpose: the middleware reads the Host header on "/"
   to serve the hire subdomain, which a prerendered page cannot do. */
import AppShell from '../layouts/AppShell.astro';
import Art from '../components/Art.astro';
import Section from '../components/site/Section.astro';
import SectionHead from '../components/site/SectionHead.astro';
import Button from '../components/site/Button.astro';
import Icon from '../components/site/Icon.astro';
import PromptCard from '../components/site/PromptCard.astro';
import RuledGrid from '../components/site/RuledGrid.astro';
import RuledCell from '../components/site/RuledCell.astro';
import Bento from '../components/site/Bento.astro';
import BentoCard from '../components/site/BentoCard.astro';
import CtaRow from '../components/site/CtaRow.astro';
import FeatureSplit from '../components/site/FeatureSplit.astro';
import WorkCard from '../components/site/WorkCard.astro';
import QuoteCard from '../components/site/QuoteCard.astro';
import StatCell from '../components/site/StatCell.astro';
import Steps from '../components/site/Steps.astro';
import FitList from '../components/site/FitList.astro';
import ToolCard from '../components/site/ToolCard.astro';
import ResourceTable, { type ResourceRow } from '../components/site/ResourceTable.astro';
import Portrait from '../components/site/Portrait.astro';
import DefList from '../components/site/DefList.astro';
import Faq from '../components/site/Faq.astro';
import {
  ABOUT_FACTS,
  CAPABILITIES,
  FAQS,
  FEATURED_PROJECT,
  FEATURED_TOOL,
  FIT,
  INDUSTRIES,
  PROJECTS,
  QUOTES,
  SERVICE_CARDS,
  STATS,
  STEPS,
  TOOLS,
  waGlobal,
  type Project,
  type Tool,
} from '../data/site';
import { liveContent, readMinutes, urlFor, type Cluster, type ContentEntry } from '../data/content-index';
import Schema from '../components/Schema.astro';
import { SITE_URL } from '../lib/seo';
import '../styles/pages/home.css';

const title = 'Neil Busque | Your AI guy for agents, apps and automation';
const description =
  'I find the work worth handing to AI, build it and keep it running. AI agents, custom software, automations and sites. First versions in days.';
const canonical = `${SITE_URL}/`;

/* ------------------------------------------------------------------ picks from the shared lists */

const pick = <T extends { slug: string }>(list: T[], slugs: string[]): T[] =>
  slugs.map((slug) => {
    const item = list.find((x) => x.slug === slug);
    if (!item) throw new Error(`Home: "${slug}" is missing from src/data/site.ts`);
    return item;
  });

/* The deck's four work cards, in its order. The CRM and the funnel simulator show in the free
   tools strip instead, so they do not repeat. */
const WORK: Project[] = pick(PROJECTS, ['agency-os-assistant-asks-first', 'ai-phone-receptionist-roofing', 'meeting-notes-to-tasks', 'ai-ads-app']);
/* The analyzer, then two of the tool cards. */
const HOME_TOOLS: Tool[] = [FEATURED_TOOL, ...pick(TOOLS, ['crm-with-ai-follow-up', 'funnel-simulator'])];

/* ------------------------------------------------------------------ resources: the 5 newest live pieces */

const KIND: Record<Cluster, string> = { guides: 'Guide', compare: 'Comparison', research: 'Research' };
/* Newest day first, the same order as the /resources table: pieces published the same day take
   turns by kind (guide, research, comparison), so one busy day does not fill the rows with one
   kind. Within a kind they keep their order in content-index.ts. */
const TURN: Cluster[] = ['guides', 'research', 'compare'];
function newestFive(entries: ContentEntry[]): ContentEntry[] {
  const days = [...new Set(entries.map((e) => e.published ?? ''))].sort().reverse();
  const out: ContentEntry[] = [];
  for (const day of days) {
    const queues = TURN.map((c) => entries.filter((e) => (e.published ?? '') === day && e.cluster === c));
    while (queues.some((q) => q.length) && out.length < 5) {
      for (const q of queues) {
        const next = q.shift();
        if (next && out.length < 5) out.push(next);
      }
    }
    if (out.length >= 5) break;
  }
  return out;
}
const newest = newestFive(liveContent);

/* Read time from the index (counted from each page's source, the same number the article prints). */
const readTime = (entry: ContentEntry) => {
  const minutes = readMinutes(entry);
  return minutes ? `${minutes} min` : undefined;
};
const day = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const RESOURCES: ResourceRow[] = newest.map((entry) => ({
  href: urlFor(entry),
  type: KIND[entry.cluster],
  title: entry.name,
  excerpt: entry.blurb,
  read: readTime(entry),
  date: entry.published ? day(entry.published) : undefined,
  dateTime: entry.published,
  filter: entry.cluster,
}));

---
<AppShell title={title} description={description} canonical={canonical} active="home">
  <Fragment slot="head">
    <Schema description={description} />
  </Fragment>

  <section class="hero home-hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 class="t-display" id="hero-title">Your business needs&nbsp;an <span class="accent">AI guy.</span></h1>
          <p class="t-lead">I find the work worth handing to AI, then build the agents, apps and automations. First versions in days.</p>
          <div class="btn-row btn-row--stack">
            <Button href={waGlobal()}>Message me on WhatsApp</Button>
            <Button href="/work" variant="secondary">See the work</Button>
          </div>
        </div>
        <div class="hero-media">
          <Art seed="home" kind="hero" loading="eager" />
          <PromptCard floating />
        </div>
      </div>
      <RuledGrid cols={4} label="What I build">
        {CAPABILITIES.map((c) => (
          <RuledCell href={c.href} label={c.number} title={c.name} compact text={c.line} />
        ))}
      </RuledGrid>
    </div>
  </section>

  <Section band="mist" as="div" class="home-statement">
    <p class="t-statement">The hard part of AI is knowing what to hand it.</p>
    <a class="link-arrow" href="/story#how-i-work">How I work<Icon name="arrow-right" strokeWidth={2} /></a>
  </Section>

  <Section id="services" labelledby="services-title" class="home-services">
    <SectionHead id="services-title" strong="Four ways I take work off your plate." rest="Each one starts small, with a working first version in days, and it stays yours." />
    <Bento label="Services">
      {SERVICE_CARDS.map((s) => (
        <BentoCard href={s.href} title={s.title} text={s.line} items={s.items} seed={s.slug} layout={s.layout} palette={s.palette} data-reveal />
      ))}
    </Bento>
    <CtaRow
      text="If you're not sure what you need, walk me through a normal day for your team. I'll say what I'd build first."
      cta={{ href: waGlobal(), label: 'Start with a message' }}
      data-reveal
    />
  </Section>

  <Section id="work" labelledby="work-title" class="home-work">
    <SectionHead
      id="work-title"
      title="Selected work"
      lead="Client systems and my own products. Client names stay private, so each build is named for what it does."
      link={{ href: '/work', label: 'All work' }}
    />
    <FeatureSplit
      label={FEATURED_PROJECT.category}
      year={FEATURED_PROJECT.year}
      title={FEATURED_PROJECT.title}
      text={FEATURED_PROJECT.text}
      outcome={FEATURED_PROJECT.outcome}
      items={FEATURED_PROJECT.built}
      stack={FEATURED_PROJECT.stack}
      cta={FEATURED_PROJECT.cta}
      seed={FEATURED_PROJECT.slug}
      palette={FEATURED_PROJECT.palette}
      layout={FEATURED_PROJECT.layout}
      data-reveal
    />
    <div class="work-grid">
      {WORK.map((p) => (
        <WorkCard
          href={p.href}
          title={p.title}
          text={p.text}
          category={p.category}
          year={p.year}
          outcome={p.outcome}
          seed={p.slug}
          palette={p.palette}
          layout={p.layout}
          data-reveal
        />
      ))}
    </div>
  </Section>

  <Section id="proof" labelledby="proof-title" class="home-proof">
    <SectionHead id="proof-title" title="The record so far" />
    <RuledGrid cols={2} label="Quotes from clients">
      {QUOTES.map((q) => <QuoteCard quote={q.quote} role={q.role} data-reveal />)}
    </RuledGrid>
    <RuledGrid cols={3} label="Numbers">
      {STATS.map((s) => <StatCell value={s.value} caption={s.caption} data-reveal />)}
    </RuledGrid>
  </Section>

  <Section band="mist" id="how-it-works" labelledby="how-title">
    <SectionHead id="how-title" title="How it works" />
    <Steps items={STEPS} />
  </Section>

  <Section id="fit" labelledby="fit-title">
    <SectionHead id="fit-title" title="Who I work best with" />
    <FitList fit={FIT.fit} notFit={FIT.notFit} fitTitle={FIT.fitTitle} notFitTitle={FIT.notFitTitle} />
  </Section>

  <Section id="industries" labelledby="industries-title" class="home-industries">
    <div class="home-industries-grid">
      <div class="home-industries-head">
        <h2 class="t-h2" id="industries-title">Ideas for <span class="accent">your industry.</span></h2>
        <p class="t-lead">Pick yours to see the software and AI I'd build for a business like it.</p>
        <a class="link-arrow" href="/software">All industries<Icon name="arrow-right" strokeWidth={2} /></a>
      </div>
      <RuledGrid cols={2} class="ruled--links" label="Industries">
        {INDUSTRIES.map((i) => <RuledCell href={i.href} title={i.name} compact />)}
      </RuledGrid>
    </div>
  </Section>

  <Section id="free-tools" labelledby="tools-title">
    <SectionHead
      id="tools-title"
      title="Free tools you can use today"
      lead="Tools I built that you can use for free. Open one now, no call needed."
      link={{ href: '/free', label: 'All free tools' }}
    />
    <div class="tool-grid">
      {HOME_TOOLS.map((t) => (
        <ToolCard href={t.href} name={t.name} text={t.text} platform={t.platform} cta={t.cta} seed={t.slug} palette={t.palette} layout={t.layout} data-reveal />
      ))}
    </div>
  </Section>

  <Section id="resources" labelledby="resources-title">
    <SectionHead
      id="resources-title"
      title="Read before you build"
      lead="Plain guides, tool comparisons and original research, written from my own projects."
      link={{ href: '/resources', label: 'All resources' }}
    />
    <ResourceTable rows={RESOURCES} />
  </Section>

  <Section band="mist" id="about" labelledby="about-title">
    <div class="home-about">
      <Portrait seed="portrait" />
      <div class="home-about-body">
        <p class="t-label">Who you'll work with</p>
        <h2 class="t-h2" id="about-title">Hi, I'm Neil.</h2>
        <div class="home-about-copy">
          <p>I'm the person a business brings in to lead its AI work. I find the jobs worth handing to AI, build them myself and keep them running.</p>
          <p>I use AI coding tools every day, and they make me fast. My job is to catch what they get wrong before your team or your customers do.</p>
          <p>You talk to me directly, from the first message to launch and after. When a tool changes or your business grows, I'm the one who keeps it working.</p>
        </div>
        <DefList items={ABOUT_FACTS} />
        <a class="link-arrow" href="/story">More about me<Icon name="arrow-right" strokeWidth={2} /></a>
      </div>
    </div>
  </Section>

  <Section id="faq" labelledby="faq-title">
    <Faq id="faq-title" title="Questions owners ask first" lead="Straight answers before we talk." items={FAQS} schema />
  </Section>
</AppShell>
