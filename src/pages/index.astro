---
import AppShell from '../layouts/AppShell.astro';
import Schema from '../components/Schema.astro';
import { getFeed, getNow } from '../lib/posts';
import { isNowFresh } from '../lib/now';
import type { Post } from '../lib/types';

const opts = { request: Astro.request, cookies: Astro.cookies };
const [{ posts: latest }, { current: now }] = await Promise.all([
  getFeed(opts, { page: 1 }),
  getNow(opts),
]);
const latest3 = latest.filter((post) => post.type !== 'now').slice(0, 3);

const WA_BUILD = 'https://wa.me/19083164140?text=Hi%20Neil%2C%20I%20want%20to%20build%20something';
const LINKEDIN = 'https://www.linkedin.com/in/neilbusque/';

const CAPABILITIES = [
  {
    number: '01',
    name: 'AI agents',
    description: 'Agents, assistants, and voice tools that answer questions, follow up, qualify leads, and help move work forward.',
  },
  {
    number: '02',
    name: 'Custom software',
    description: 'Web apps, portals, dashboards, internal tools, and client-facing products built around the way people really work.',
  },
  {
    number: '03',
    name: 'Automations',
    description: 'n8n, Zapier, GoHighLevel, APIs, webhooks, and the small connections that make a business run smoother.',
  },
  {
    number: '04',
    name: 'Websites and funnels',
    description: 'Fast sites, landing pages, and simple flows that make it obvious what to do next.',
  },
];

const WORK = [
  {
    name: 'Orbit CRM',
    description: 'A CRM and operations workspace with AI features, built to help manage work in one place.',
    img: '/assets/work/orbit-app.webp',
    href: '/case-studies/orbit',
    label: 'CRM + AI agents',
  },
  {
    name: 'Tandem',
    description: 'A couples app built around connection, shared experience, and product thinking.',
    img: '/assets/work/tandem.webp',
    href: '/case-studies/tandem',
    label: 'Personal product',
  },
  {
    name: 'Darioo',
    description: 'A client site and app built to support the business with something real people can use.',
    img: '/assets/work/darioo.webp',
    href: 'https://darioo.com',
    label: 'Client site + app',
  },
  {
    name: 'Scott Greenleaf',
    description: 'A client site focused on clarity, presentation, and getting the message across cleanly.',
    img: '/assets/work/scottgreenleaf.webp',
    href: 'https://scottgreenleaf.com/',
    label: 'Client site',
  },
];

const TOPICS = [
  'Building apps with AI',
  'Automations and workflow systems',
  'Design decisions',
  'Product ideas',
  'Experiments that worked',
  'Experiments that did not',
  'Lessons from client projects',
  'Things I am figuring out in real time',
];

/* The hero headline is split into words at build time so GSAP can settle them in without
   SplitText and without any layout shift — the spans ARE the resting layout. */
const HERO_WORDS: Array<{ text: string; hl?: boolean }> = [
  { text: 'I' },
  { text: 'build' },
  { text: 'cool', hl: true },
  { text: 'stuff', hl: true },
  { text: 'with' },
  { text: 'AI.' },
];

const nowIsFresh = isNowFresh(now?.published_at);
const nowText = nowIsFresh
  ? (now?.title || now?.excerpt || 'Building something new.')
  : 'Right now I am focused on building better software, writing more, and getting sharper at turning rough ideas into things people can actually use.';
const nowDate = nowIsFresh && now?.published_at
  ? new Date(now.published_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

function shortDate(iso: string | null): string {
  return iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
}

function tagFor(post: Post): string {
  if (post.tags?.includes('video')) return 'Video';
  if (post.type === 'article') return post.tags.includes('tutorial') ? 'Tutorial' : 'Note';
  const map: Record<string, string> = { status: 'Thought', project: 'Build', now: 'Now' };
  return map[post.type] ?? 'Note';
}
---
<AppShell
  title="Neil Busque — I Build Cool Stuff with AI"
  description="Apps, automations, AI agents, and little internet projects by Neil Busque. See the work, read the notes, and follow what he is building now."
  ogImage="https://busqueneil.com/assets/brand/og-journal.png"
  active="home"
>
  <Fragment slot="head"><Schema /></Fragment>

  <div class="kin-home">
    <section class="kin-hero">
      <span class="eyebrow">Neil Busque · builder</span>
      <h1 class="kin-hero-title" data-kinetic>
        {HERO_WORDS.map((word) => (
          <span class="kin-word-wrap">
            <span class="kin-word" data-hero-word class:list={[{ 'mark-hl': word.hl }]}>{word.text}</span>
          </span>
        ))}
      </h1>
      <div class="kin-hero-row">
        <p class="kin-hero-sub">Apps, automations, AI agents, and little internet projects. Some are for clients. Some are ideas I want to see exist. This is where I share the work and what I learn building it.</p>
        <div class="hero-ctas">
          <a class="btn-sun" href={WA_BUILD} target="_blank" rel="noopener">Message me on WhatsApp</a>
          <a class="link-arrow" href="/work">See what I&rsquo;m building
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
      <figure class="kin-hero-shot" data-drift="26">
        <img src="/assets/work/orbit-app.webp" srcset="/assets/work/orbit-app-sm.webp 760w, /assets/work/orbit-app.webp 1440w" sizes="(max-width: 1020px) calc(100vw - 2.5rem), 1104px" alt="Orbit CRM and operations workspace designed and built by Neil Busque" width="1280" height="800" fetchpriority="high" />
        <figcaption><span class="eyebrow-plain">A real thing I built</span><strong>Orbit CRM · Software + AI agents</strong></figcaption>
      </figure>
    </section>

    <div class="kin-marquee" aria-label="How Neil works">
      <div class="kin-marquee-track">
        {[0, 1].map((copy) => (
          <div class="kin-marquee-set" aria-hidden={copy === 1 ? 'true' : undefined}>
            <span>Direct with Neil</span><i></i>
            <span>No middleman</span><i></i>
            <span>You own the work</span><i></i>
            <span>Apps · Automations · AI agents</span><i></i>
          </div>
        ))}
      </div>
    </div>

    <section class="kin-sec kin-intro">
      <div data-reveal>
        <span class="eyebrow">Intro</span>
        <h2 class="kin-h2" data-kinetic>I like building useful things.</h2>
      </div>
      <div class="kin-copy" data-reveal>
        <p>Things that save time, remove friction, or make someone&rsquo;s day a little easier. Most of my work lives somewhere between software, automation, design, and making a messy process feel simple.</p>
        <p>I work with business owners, teams, and people with ideas who need someone to actually build the thing. I also use this space like a notebook &mdash; some of it is finished work, some of it is what I am testing and learning in public.</p>
      </div>
    </section>

    <section class="kin-sec">
      <div class="kin-heading" data-reveal>
        <span class="eyebrow">Things I build</span>
        <h2 class="kin-h2" data-kinetic>Capabilities, not a service menu.</h2>
        <p>Different kinds of work, usually connected by the same goal: make the complicated part feel simple.</p>
      </div>
      <ol class="kin-caps">
        {CAPABILITIES.map((capability) => (
          <li data-reveal>
            <span class="kin-cap-num">{capability.number}</span>
            <h3>{capability.name}</h3>
            <p>{capability.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="kin-sec">
      <div class="kin-heading split" data-reveal>
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 class="kin-h2" data-kinetic>Things that made it out of my head.</h2>
        </div>
        <a class="link-arrow" href="/work">See all work
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="kin-work">
        {WORK.map((item) => {
          const external = item.href.startsWith('http');
          return (
            <a class="kin-work-row" href={item.href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} data-reveal>
              <div class="kin-work-shot">
                <img src={item.img} srcset={`${item.img.replace('.webp', '-sm.webp')} 760w, ${item.img} 1440w`} sizes="(max-width: 760px) calc(100vw - 2.5rem), 300px" alt={`${item.name}, built by Neil Busque`} width="1280" height="800" loading="lazy" decoding="async" />
              </div>
              <div class="kin-work-meta">
                <span class="kin-work-label">{item.label}</span>
                <h3>{item.name}</h3>
                <p>{item.description}</p>
              </div>
              <svg class="kin-work-arrow" width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          );
        })}
      </div>
    </section>

    <section class="kin-sec">
      <div class="kin-heading split" data-reveal>
        <div>
          <span class="eyebrow">Notes from building</span>
          <h2 class="kin-h2" data-kinetic>What I&rsquo;m learning while I make things.</h2>
        </div>
        <a class="link-arrow" href="/blog">Read all notes
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <p class="kin-lede" data-reveal>Not just a portfolio &mdash; a place to share what I am working on, what is breaking, what is getting better, and what I notice as I build.</p>
      {latest3.length > 0 ? (
        <ul class="kin-posts">
          {latest3.map((post) => (
            <li data-reveal>
              <a href={`/posts/${post.slug}`}>
                <span class="kin-post-date">{shortDate(post.published_at)}</span>
                <span class="kin-post-title">{post.title ?? 'Untitled'}</span>
                <span class="kin-post-tag">{tagFor(post)}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="kin-empty" data-reveal>The notebook is open. New notes will show up here as I publish them.</div>
      )}
      <ul class="kin-topics" aria-label="Topics Neil writes about" data-reveal>
        {TOPICS.map((topic) => <li class="chip">{topic}</li>)}
      </ul>
    </section>

    <section class="kin-panel" aria-labelledby="newsletter-title" data-reveal>
      <div>
        <span class="eyebrow">Newsletter · coming soon</span>
        <h2 id="newsletter-title" class="kin-h2">Build notes, sent occasionally.</h2>
      </div>
      <div class="kin-copy">
        <p>A small newsletter about the things I build, what breaks, and what I learn fixing it. No signup box yet&mdash;I want the sending side ready before I ask for your email.</p>
        <a class="link-arrow" href={LINKEDIN} target="_blank" rel="me noopener">Follow me on LinkedIn for now
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>

    <section class="kin-sec">
      <div class="kin-heading" data-reveal>
        <span class="eyebrow">Free things I made</span>
        <h2 class="kin-h2" data-kinetic>Useful now. No sales call required.</h2>
      </div>
      <div class="kin-magnets">
        <a class="kin-magnet" href="/analyzer" data-reveal>
          <span class="kin-work-label">Interactive tool</span>
          <strong class="kin-magnet-mark">100</strong>
          <h3>Landing Page Analyzer</h3>
          <p>Paste a page, get a score, and see what is helping or hurting it. The score is free; email is optional for the full PDF report.</p>
          <span class="kin-magnet-link">Analyze a page
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <a class="kin-magnet" href="/viral-post-heist.pdf" download data-reveal>
          <span class="kin-work-label">Six-page field report</span>
          <strong class="kin-magnet-mark">300+</strong>
          <h3>The Viral Post Heist</h3>
          <p>How I used AI to study hundreds of top-performing posts, extract the patterns, and turn the research into a month of content.</p>
          <span class="kin-magnet-link">Download the PDF
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v11m0 0-5-5m5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
    </section>

    <section class="kin-sec kin-intro">
      <div data-reveal>
        <span class="eyebrow">Now</span>
        <h2 class="kin-h2" data-kinetic>What I&rsquo;m focused on right now.</h2>
      </div>
      <div class="kin-copy" data-reveal>
        <p>{nowText}</p>
        <p>I am especially interested in custom software, AI tools that do real work, workflow systems, and products that feel simple on the surface even when the backend is doing a lot.</p>
        {nowDate && <span class="kin-stamp">Updated {nowDate}</span>}
        <a class="link-arrow" href="/now">Read the full now page
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>

    <section class="kin-sec kin-two-up">
      <article data-reveal>
        <span class="eyebrow">Why work with me</span>
        <h2 class="kin-h2">One person, all the way through.</h2>
        <p>You work directly with me from the first message to the finished build. No handoff, no account manager, no explaining the same project five different times.</p>
        <p>I like moving fast, but I also care about making things dependable. Getting something to look finished is one thing. Making it work in real life is the part I take seriously.</p>
      </article>
      <article data-reveal>
        <span class="eyebrow">About</span>
        <h2 class="kin-h2">Design, software, systems, and AI.</h2>
        <p>I studied IT, went deep into design, and ended up in the middle of software, systems, and AI. I care about how things function, but I also care about how they feel to use.</p>
        <p>This site is my corner of the internet. Part portfolio, part blog, part working notebook.</p>
        <a class="link-arrow" href="/story">More about me
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </article>
    </section>

    <section class="kin-cta">
      <span class="eyebrow">Got an idea?</span>
      <h2 class="kin-cta-title" data-kinetic data-reveal>Got an idea, a broken process, or <span class="mark-hl">something you want built</span>?</h2>
      <p data-reveal>Message me on WhatsApp and I&rsquo;ll tell you how I&rsquo;d approach it.</p>
      <div class="hero-ctas" data-reveal>
        <a class="btn-sun" href={WA_BUILD} target="_blank" rel="noopener">Message me on WhatsApp</a>
        <a class="btn-ghost" href="/blog">Or read my notes</a>
      </div>
      <img class="kin-sig" src="/assets/brand/sig-sun.webp" alt="Neil" width="280" height="165" loading="lazy" />
    </section>
  </div>
</AppShell>
