---
/* Where the live payment link on /unlimited lands after a successful charge, so this route
   must keep existing while that link does (if /unlimited ever moves, the payment link's
   after-completion URL in the Stripe dashboard has to move with it).
   noindex because it is a post-payment page; it is also absent from sitemap.xml and llms.txt. */
import AppShell from '../../layouts/AppShell.astro';
import Section from '../../components/site/Section.astro';
import PageHead from '../../components/site/PageHead.astro';
import Button from '../../components/site/Button.astro';
import Steps from '../../components/site/Steps.astro';
import ContactChannels from '../../components/site/ContactChannels.astro';
import { CHANNELS, SITE, waUrl } from '../../data/site';
import '../../styles/pages/unlimited.css';

export const prerender = true;

const WA_HREF = waUrl('Hi Neil, I just subscribed to the unlimited plan. ');

const STEPS = [
  { title: 'Book your kickoff call', text: 'Pick any slot that works. This is where you tell me what you need first and I tell you honestly how I would approach it.' },
  { title: 'I set up your portal', text: 'Within 24 hours you get your own portal login. Your queue, your files and our whole conversation live there from then on.' },
  { title: 'You post the first request', text: 'A sentence is enough to start. I come back with what I understood and what it will take before I build anything.' },
];

const channels = CHANNELS.filter((c) => c.key === 'whatsapp' || c.key === 'email');
---
<AppShell
  title="You are in | Unlimited"
  description="Your unlimited subscription is active. Here is what happens next."
  canonical={`${SITE.url}/unlimited/thanks`}
  noindex
  active="services"
  ask={false}
>
  <PageHead label="Payment confirmed" title="You are" accent="in." lead="Your subscription is active and I have your details. There is nothing else to pay and nothing else to fill in. Here is exactly what happens next.">
    <div class="btn-row btn-row--stack">
      <Button href={SITE.booking}>Book your kickoff call</Button>
      <Button href={WA_HREF} variant="secondary">Or message me on WhatsApp</Button>
    </div>
  </PageHead>

  <Section labelledby="thanks-next-title">
    <h2 class="t-h3" id="thanks-next-title">What happens next</h2>
    <Steps items={STEPS} class="unl-thanks-steps" />
  </Section>

  <Section labelledby="thanks-refund-title">
    <div class="unl-thanks-note">
      <h2 class="t-h4" id="thanks-refund-title">Two weeks to change your mind.</h2>
      <p>Your 14 day window started today. If you decide this is not for you, message me and I refund 100% of it, and you keep everything I already built. You can cancel anytime after that with no notice period.</p>
      <ContactChannels items={channels} label="Reach me" />
    </div>
  </Section>
</AppShell>
