---
import AppShell from '../../layouts/AppShell.astro';
import Art from '../../components/Art.astro';
import Section from '../../components/site/Section.astro';
import PageHead from '../../components/site/PageHead.astro';
import SectionHead from '../../components/site/SectionHead.astro';
import Button from '../../components/site/Button.astro';
import Icon from '../../components/site/Icon.astro';
import RuledGrid from '../../components/site/RuledGrid.astro';
import CheckList from '../../components/site/CheckList.astro';
import DefList from '../../components/site/DefList.astro';
import Steps from '../../components/site/Steps.astro';
import FitList from '../../components/site/FitList.astro';
import CtaRow from '../../components/site/CtaRow.astro';
import Faq from '../../components/site/Faq.astro';
import Breadcrumb from '../../components/site/Breadcrumb.astro';
import { ORGANIZATION_REF, SOCIAL_IMAGE_URL } from '../../lib/seo';
import { SERVICES, waGlobal, waOneBuild, waOngoing, type LinkItem } from '../../data/site';
import type { PaletteName } from '../../lib/art';
import '../../styles/pages/services.css';

export const prerender = true;

const title = 'AI agents, software and automation services | Neil Busque';
const description = 'AI agents, phone agents, custom software, automations and websites, built and run by one person. Clear scope and price before any work starts.';
const canonical = 'https://busqueneil.com/services';

/* Extra deep pages per service, so every /services/* page is one click from this hub.
   Art palettes alternate light grounds with one dark picture, top to bottom. */
const EXTRA: Record<string, { links: LinkItem[]; palette: PaletteName }> = {
  'ai-agents': { links: [], palette: 'mist' },
  'ai-voice-agents': { links: [{ label: 'Phone agent or answering service', href: '/software/ai-phone-agent-vs-answering-service' }], palette: 'navy' },
  'custom-software': { links: [{ label: 'Software by industry', href: '/software' }], palette: 'paper' },
  automations: { links: [{ label: 'Working with a consultant', href: '/services/ai-automation-consultant' }], palette: 'mist' },
  'ai-sites': { links: [{ label: 'Landing pages', href: '/services/landing-pages' }, { label: 'Funnels', href: '/services/funnels' }], palette: 'paper' },
};

const WAYS = [
  {
    title: 'One build',
    fit: 'You have one clear job in mind: an agent, an app or an automation.',
    facts: [
      { term: 'How it starts', value: 'A few messages or a short call, then a clear scope and price' },
      { term: 'How long', value: 'A working first version in days, finished in weeks' },
      { term: 'What you get', value: 'The finished build, running in your accounts and yours to keep' },
      { term: 'How we talk', value: 'WhatsApp or email, with a link to try after each round' },
    ],
    cta: { label: 'Talk about a build', href: waOneBuild() },
  },
  {
    title: 'Ongoing AI lead',
    fit: 'You want one person to find, build and look after your AI work, month after month.',
    facts: [
      { term: 'How it starts', value: 'We list the jobs worth handing to AI and pick the first one' },
      { term: 'How long', value: 'Ongoing, as a monthly arrangement' },
      { term: 'What you get', value: 'New builds, fixes and improvements every month, from one person who knows your business' },
      { term: 'How we talk', value: 'A shared chat and a regular check-in call' },
    ],
    cta: { label: 'Talk about ongoing help', href: waOngoing() },
  },
];

const HOW = [
  { title: 'First message', text: 'On WhatsApp, email or a short call. You describe the work, and I ask about your tools, your team and what a good result looks like.' },
  { title: 'Scope and price', text: "In plain English: what gets built, what doesn't, what it costs and when you'll see the first version." },
  { title: 'First version in days', text: 'You get a link to something that works. You click through it, and we adjust in short rounds.' },
  { title: 'Launch and after', text: 'It goes live in your accounts. Then I keep it running each month, or hand it to your team with what they need to run it.' },
];

const FIT = {
  fit: [
    'You can name a task your team repeats every week.',
    "You pay for tools that don't talk to each other.",
    "Leads or calls slip through when you're busy.",
    'You want one person accountable from start to finish.',
    "You're ready to give feedback on early versions.",
  ],
  notFit: [
    'You need a large team for a big company-wide rollout.',
    'You only want strategy slides and no build.',
    'You want AI to spend money or delete records with no human check.',
    'You need someone on site every day.',
    "You can't share access to the tools we'd connect.",
  ],
};

const FAQ = [
  { q: 'How do you price the work?', a: 'A single build gets its own scope and price. Ongoing work is a monthly arrangement. Either way, you see the scope and price before any work starts.' },
  { q: 'Who does the work?', a: "I do. You talk to the person building it, from the first message to launch and after. There's no account manager in between." },
  { q: 'What if the AI gets something wrong?', a: 'I plan for it. Every agent gets clear limits that you approve before launch. Anything risky, like spending money, publishing or deleting, waits for a person to approve it. I test it on real examples from your business before it goes live.' },
  { q: 'Which AI models do you use?', a: 'Whichever fits the job, usually Claude or GPT. I set things up so you can switch models later without starting over.' },
  { q: 'Can you take over something another developer started?', a: "Yes. I've taken over apps started by other developers and by AI app builders, cleaned them up and kept building. I'll look at what you have and tell you whether to keep it or start fresh." },
  { q: 'Can we start small?', a: 'Yes. Start with one build. If it pays off, we plan the next one or move to a monthly arrangement.' },
];

const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: title,
  description,
  url: canonical,
  about: ORGANIZATION_REF,
  mainEntity: {
    '@type': 'ItemList',
    '@id': `${canonical}#services-list`,
    name: 'Services by Neil Busque',
    itemListElement: SERVICES.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: `https://busqueneil.com${s.href}`,
    })),
  },
};
---
<AppShell title={title} description={description} canonical={canonical} ogImage={SOCIAL_IMAGE_URL} active="services">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collection)} />
  <Breadcrumb back={false} items={[
    { name: 'Home', url: 'https://busqueneil.com/' },
    { name: 'Services', url: canonical },
  ]} />

  <PageHead
    title="Agents, apps and automations, one person"
    accent="accountable."
    lead="Start with one build, or keep me on each month as your ongoing AI lead. Either way, you get a clear scope and price before any work starts."
  >
    <div class="btn-row btn-row--stack">
      <Button href={waGlobal()}>Message me on WhatsApp</Button>
      <Button href="/work" variant="secondary">See the work</Button>
    </div>
    <nav slot="aside" aria-label="Services on this page">
      <ol class="svc-index" role="list">
        {SERVICES.map((s) => (
          <li>
            <a href={`#${s.slug}`}>
              <span class="t-label">{s.number}</span>
              <span class="svc-index-name">{s.name}</span>
              <span class="svc-index-line">{s.line}</span>
              <Icon name="arrow-right" strokeWidth={2} />
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </PageHead>

  {SERVICES.map((s, i) => (
    <section class:list={['section', 'svc-sec', i % 2 === 1 && 'svc-sec--flip']} id={s.slug} aria-labelledby={`${s.slug}-title`}>
      <div class="wrap svc-sec-grid">
        <div class="svc-sec-copy">
          <p class="t-label">{s.number}</p>
          <h2 class="t-h2" id={`${s.slug}-title`}>{s.name}</h2>
          <p class="svc-sec-text">{s.text}</p>
          <h3 class="t-h4 svc-sec-sub">What you get</h3>
          <CheckList items={s.items} />
          <DefList items={s.facts} />
          <div class="svc-links">
            <a class="link-arrow" href={s.link.href}>{s.link.label}<Icon name="arrow-right" strokeWidth={2} /></a>
            {EXTRA[s.slug]?.links.map((l) => (
              <a class="link-arrow" href={l.href}>{l.label}<Icon name="arrow-right" strokeWidth={2} /></a>
            ))}
          </div>
        </div>
        <div class="svc-sec-art">
          <Art seed={s.slug} kind="service" ratio="4 / 3" palette={EXTRA[s.slug]?.palette} />
        </div>
      </div>
    </section>
  ))}

  <Section band="mist" id="ways" labelledby="ways-title">
    <SectionHead id="ways-title" title="Two ways to work together" />
    <RuledGrid cols={2} class="svc-ways" label="Ways to work together">
      {WAYS.map((w) => (
        <div>
          <h3 class="t-h3">{w.title}</h3>
          <p class="cell-text">{w.fit}</p>
          <dl class="svc-facts">
            {w.facts.map((f) => (
              <div>
                <dt>{f.term}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
          <Button href={w.cta.href}>{w.cta.label}</Button>
        </div>
      ))}
    </RuledGrid>
    <CtaRow
      class="svc-ways-row"
      text="If you're not sure which fits, tell me about your business. I'll say which one I'd pick."
      cta={{ href: waGlobal(), label: 'Start with a message' }}
    />
  </Section>

  <Section id="how" labelledby="how-title">
    <SectionHead id="how-title" title="From first message to launch" />
    <Steps items={HOW} />
  </Section>

  <Section id="fit" labelledby="fit-title">
    <SectionHead id="fit-title" title="Who this is for" />
    <FitList fit={FIT.fit} notFit={FIT.notFit} />
  </Section>

  <Section id="faq" labelledby="faq-title">
    <Faq id="faq-title" title="Before you decide" lead="Short answers to what people ask before a build." items={FAQ} schema />
  </Section>
</AppShell>
