---
import AppShell from '../../layouts/AppShell.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export const prerender = true;

const title = 'AI Automation and Agent Development | Neil Busque';
const description = 'AI agents, workflow automation, and practical automation consulting for small teams. Work directly with Neil Busque from scope to launch.';
const canonical = 'https://busqueneil.com/services';

const SERVICES = [
  {
    href: '/services/ai-automation-services',
    name: 'AI Automation Services',
    blurb: 'Take a repeated task off someone\'s desk and turn it into a workflow the team can see and trust.',
  },
  {
    href: '/services/ai-agent-development',
    name: 'AI Agent Development',
    blurb: 'Agents that can read the lead, update the CRM, draft the reply, and wait for approval before sending.',
  },
  {
    href: '/services/ai-automation-consultant',
    name: 'AI Automation Consulting',
    blurb: 'Find the process that is eating the team\'s time, then build the smallest dependable fix.',
  },
];

const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: `https://busqueneil.com${s.href}`,
  })),
};
---
<AppShell title={title} description={description} canonical={canonical} active="hire">
  <Fragment slot="head">
    <Breadcrumb items={[
      { name: 'Home', url: 'https://busqueneil.com/' },
      { name: 'Services', url: canonical },
    ]} />
    <script type="application/ld+json" set:html={JSON.stringify(list)} />
  </Fragment>

  <header class="page-head">
    <p class="eyebrow"><span class="idx">&#8727;</span> Services</p>
    <h1>What I <span class="accent">build</span>.</h1>
    <p class="lede">Three common starting points. Whichever one fits, you work with me from the first call through launch.</p>
  </header>

  <div class="svc-grid">
    {SERVICES.map((s) => (
      <a class="v8-card svc-card" href={s.href}>
        <b>{s.name}</b>
        <span>{s.blurb}</span>
        <span class="svc-go">Read more &#8594;</span>
      </a>
    ))}
  </div>

  <div class="hire-cta v8-card">
    <span class="eyebrow">The guarantee</span>
    <p class="guarantee">I keep working until you are proud of it. If I am not the right fit, I will tell you on the first call.</p>
    <div class="hero-ctas">
      <a class="btn-sun" href="/contact">Tell me what you need</a>
      <a class="btn-ghost" href="/hire">Or hire me full-time</a>
    </div>
  </div>
</AppShell>
