---
import AppShell from '../../layouts/AppShell.astro';
import Section from '../../components/site/Section.astro';
import SectionHead from '../../components/site/SectionHead.astro';
import Button from '../../components/site/Button.astro';
import Faq from '../../components/site/Faq.astro';
import ServiceHead from '../../components/services/ServiceHead.astro';
import ServiceBody from '../../components/services/ServiceBody.astro';
import LinkRows from '../../components/services/LinkRows.astro';
import { ORGANIZATION_REF, SOCIAL_IMAGE_URL, WEBSITE_REF } from '../../lib/seo';
import { waSoftware } from '../../data/site';
import { softwarePages, softwareBySlug, softwareName, softwareLabel } from '../../data/software-pages';
import type { PaletteName } from '../../lib/art';
import '../../styles/pages/services.css';

export const prerender = true;

export function getStaticPaths() {
  return softwarePages.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const page = softwareBySlug.get(slug!);
if (!page) return Astro.redirect('/software');

const canonical = `https://busqueneil.com/software/${page.slug}`;
const name = softwareName(page);
const wa = { label: 'Message me on WhatsApp', href: waSoftware(page.title) };

/* Light art grounds only in the head, so the page never opens on a dark slab. */
const HEAD_PALETTES: PaletteName[] = ['mist', 'paper'];
const artPalette = HEAD_PALETTES[[...page.slug].reduce((n, c) => n + c.charCodeAt(0), 0) % HEAD_PALETTES.length];

const BACK: Record<typeof page.cat, string> = {
  industry: 'Software by industry',
  combo: 'Software by industry',
  solution: 'Software by system',
  decision: 'Software guides',
};

const summaryItems = [
  'A clear scope and price before any work starts',
  'A working first version in days',
  'Software that fits how your team already works',
  'The code and the accounts, in your name',
];

const related = page.related
  .map((r) => softwareBySlug.get(r))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((p) => ({ href: `/software/${p.slug}`, title: softwareLabel(p), text: p.lede }));
if (page.guide) related.push({ href: page.guide.href, title: page.guide.label, text: '' });
related.push({ href: '/work', title: 'See the work', text: 'Client systems, agency work and my own products, named for what they do.' });

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name,
  url: canonical,
  image: SOCIAL_IMAGE_URL,
  provider: ORGANIZATION_REF,
  brand: ORGANIZATION_REF,
  isPartOf: WEBSITE_REF,
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  serviceType: ['Custom software development', 'AI agent development', 'AI automation'],
  areaServed: { '@type': 'Country', name: 'United States' },
  description: page.metaDescription,
};
---
<AppShell title={page.title} description={page.metaDescription} canonical={canonical} ogImage={SOCIAL_IMAGE_URL} active="services">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(service)} />

  <ServiceHead
    heading={page.h1}
    lead={page.lede}
    crumbs={[
      { name: 'Home', url: 'https://busqueneil.com/' },
      { name: 'Software', url: 'https://busqueneil.com/software' },
      { name, url: canonical },
    ]}
    backLabel={BACK[page.cat]}
    primary={wa}
    artSeed={page.slug}
    artPalette={artPalette}
  />

  <Section id="details">
    <ServiceBody id="summary-title" title="Working with me" items={summaryItems} cta={wa} desktopOnly>
      {page.sections.map((s) => (
        <>
          <h2>{s.h2}</h2>
          {s.body.map((p) => <p>{p}</p>)}
          {s.bullets && (
            <ul>
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
        </>
      ))}
    </ServiceBody>
  </Section>

  <section class="section band band--mist" aria-labelledby="build-title">
    <div class="wrap svc-cta-grid">
      <h2 class="t-h2" id="build-title">I can build this for <span class="accent">your business.</span></h2>
      <div class="svc-cta-side">
        <p class="t-lead">Tell me how your team works today. You get a clear scope and price before any work starts, and you own everything I build.</p>
        <div class="btn-row btn-row--stack">
          <Button href={wa.href}>{wa.label}</Button>
          <Button href="/work" variant="secondary">See the work</Button>
        </div>
      </div>
    </div>
  </section>

  <Section id="faq" labelledby="faq-title">
    <Faq id="faq-title" title="Common questions" lead="Straight answers before we talk." items={page.faq} ask={{ href: wa.href, label: 'Ask me directly' }} schema />
  </Section>

  <Section id="more" labelledby="more-title">
    <SectionHead id="more-title" title="Keep reading" link={{ href: '/software', label: 'All industries and systems' }} />
    <LinkRows rows={related} />
  </Section>
</AppShell>
