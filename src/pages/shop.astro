---
import AppShell from '../layouts/AppShell.astro';

const WA_SHOP = 'https://wa.me/19083164140?text=Hi%20Neil%2C%20about%20the%20shop';
---
<AppShell title="Shop | Neil Busque" description="Templates and small tools from Neil Busque. The shop is not open yet." active="shop" noindex>
  <span class="eyebrow">Shop</span>
  <h1 class="sec">Things I made that <span class="mark-hl">you can buy.</span></h1>
  <p style="color:var(--muted); max-width:56ch; margin-top:14px;">The shop opens soon. Templates, playbooks, and the tools I use to ship real products, packaged for you.</p>
  <p style="margin-top:18px"><a class="btn-sun" href={WA_SHOP}>Tell me what you want first</a></p>
  <p style="margin-top:14px"><span class="hand" style="display:inline-block; transform:rotate(-1.5deg);">first drops are in the works</span></p>
  <img class="art-img" style="max-width:640px; margin-top:34px" src="/assets/art/shop-bag.webp" alt="" width="1264" height="848" loading="lazy" />
</AppShell>
