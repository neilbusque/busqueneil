---
import AppShell from '../layouts/AppShell.astro';
import { getFeed } from '../lib/posts';
import { filterToQuery, FILTERS } from '../lib/blogFilters';
import type { Post } from '../lib/types';

const url = Astro.url;
const filter = url.searchParams.get('filter');
const page = Math.max(1, parseInt(url.searchParams.get('page') ?? '1', 10) || 1);
const query = filterToQuery(filter);
const { posts, hasMore } = await getFeed({ request: Astro.request, cookies: Astro.cookies }, { page, ...query });
const chipHref = (key: string) => (key === 'all' ? '/blog' : `/blog?filter=${key}`);
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

function shortDate(iso: string | null): string {
  return iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
}

function tagFor(post: Post): string {
  if (post.tags?.includes('video')) return 'Video';
  if (post.type === 'article') return post.tags.includes('tutorial') ? 'Tutorial' : 'Note';
  const map: Record<string, string> = { status: 'Thought', project: 'Build', now: 'Now' };
  return map[post.type] ?? 'Note';
}

const canonical = 'https://busqueneil.com/blog';
const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#webpage`,
  name: "Neil Busque's Notes",
  description: 'Notes from Neil Busque about building apps with AI, automations, design decisions, experiments, and lessons from client work.',
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    '@id': `${canonical}#posts-list`,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.title ?? 'Untitled',
      url: `https://busqueneil.com/posts/${post.slug}`,
    })),
  },
};
---
<AppShell
  title="Notes from Building | Neil Busque"
  description="Notes from Neil Busque on apps, AI, automation, design decisions, experiments, client work, and what he is figuring out in real time."
  canonical={canonical}
  active="notes"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <div class="journal-page notes-page">
    <header class="journal-page-head">
      <span class="eyebrow">Notes</span>
      <h1>Things I&rsquo;m learning while I <em>build.</em></h1>
      <p>What I am making, what broke, what I changed my mind about, and the decisions behind the finished screen. Some posts are polished. Some are notes from the middle of the work.</p>
    </header>

    <nav class="notes-filters" aria-label="Filter notes">
      {FILTERS.map((item) => (
        <a class:list={{ active: (filter ?? 'all') === item.key }} href={chipHref(item.key)} aria-current={(filter ?? 'all') === item.key ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    {posts.length > 0 ? (
      <ul class="journal-posts notes-index">
        {posts.map((post) => (
          <li>
            <a href={`/posts/${post.slug}`}>
              <span class="journal-post-date">{shortDate(post.published_at)}</span>
              <span class="journal-post-main">
                <span class="journal-post-title">{post.title ?? 'Untitled'}</span>
                {post.excerpt && <span class="journal-post-excerpt">{post.excerpt}</span>}
              </span>
              <span class="journal-post-tag">{tagFor(post)}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="notes-empty">No notes match that filter yet. The notebook is still open.</div>
    )}

    <nav class="notes-pager" aria-label="Notes pagination">
      {page > 1 && <a class="btn-ghost" href={`/blog?${new URLSearchParams({ ...(filter ? { filter } : {}), page: String(page - 1) })}`}>Newer notes</a>}
      {hasMore && <a class="btn-ghost" href={`/blog?${new URLSearchParams({ ...(filter ? { filter } : {}), page: String(page + 1) })}`}>Older notes</a>}
    </nav>

    <section class="newsletter-panel notes-newsletter" aria-labelledby="notes-newsletter-title">
      <div>
        <span class="eyebrow">Newsletter · coming soon</span>
        <h2 id="notes-newsletter-title">Build notes, sent occasionally.</h2>
      </div>
      <div>
        <p>I&rsquo;m getting the newsletter ready before I ask for anyone&rsquo;s email. Until then, new notes live here first.</p>
        <a href="https://www.linkedin.com/in/neilbusque/" target="_blank" rel="me noopener">Follow me on LinkedIn for now <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</AppShell>
