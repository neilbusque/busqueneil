---
import AppShell from '../layouts/AppShell.astro';
import { getFeed } from '../lib/posts';
import { filterToQuery, FILTERS } from '../lib/blogFilters';
import type { Post } from '../lib/types';

const url = Astro.url;
const filter = url.searchParams.get('filter');
const page = Math.max(1, parseInt(url.searchParams.get('page') ?? '1', 10) || 1);
const q = filterToQuery(filter);
const { posts, hasMore } = await getFeed({ request: Astro.request, cookies: Astro.cookies }, { page, ...q });
const chipHref = (key: string) => (key === 'all' ? '/blog' : `/blog?filter=${key}`);
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

function shortDate(iso: string | null): string {
  return iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
}
function tagFor(p: Post): string {
  if (p.tags?.includes('video')) return 'Video';
  if (p.type === 'article') return p.tags.includes('tutorial') ? 'Tutorial' : 'Article';
  const map: Record<string, string> = { status: 'Thought', project: 'Build', now: 'Now' };
  return map[p.type] ?? 'Post';
}
const canonical = 'https://busqueneil.com/blog';
const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#webpage`,
  name: "Neil Busque's Blog",
  description: 'Build notes and lessons about AI products, automations, websites, and the systems behind them.',
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    '@id': `${canonical}#posts-list`,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.title ?? 'Untitled',
      url: `https://busqueneil.com/posts/${post.slug}`,
    })),
  },
};
---
<AppShell title="Neil Busque's Blog | Build Notes and Lessons" description="Notes from Neil Busque on building AI products, automations, websites, and the systems behind them, including what broke and what he learned." canonical={canonical} active="resources">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <span class="eyebrow">The blog</span>
  <h1 class="sec">Build notes and <span class="mark-hl">lessons.</span></h1>
  <p class="res-lede">What I am making, what broke, and what I learned fixing it. If you want the cleaner step-by-step version, head to <a href="/resources">Resources</a>.</p>
  <div class="blog-chips">
    {FILTERS.map((f) => (
      <a class:list={['chip', { on: (filter ?? 'all') === f.key }]} href={chipHref(f.key)}>{f.label}</a>
    ))}
  </div>
  <ul class="postlist">
    {posts.map((p) => (
      <li>
        <a href={`/posts/${p.slug}`}>
          <span class="pd">{shortDate(p.published_at)}</span>
          <span class="pt">{p.title ?? 'Untitled'}</span>
          <span class:list={['tag', { video: p.tags.includes('video') }]}>{tagFor(p)}</span>
        </a>
      </li>
    ))}
  </ul>
  {posts.length === 0 && <p>No posts match that filter yet.</p>}
  <div class="pager">
    {page > 1 && <a class="btn-ghost" href={`/blog?${new URLSearchParams({ ...(filter ? { filter } : {}), page: String(page - 1) })}`}>Newer</a>}
    {hasMore && <a class="btn-ghost" href={`/blog?${new URLSearchParams({ ...(filter ? { filter } : {}), page: String(page + 1) })}`}>Older</a>}
  </div>
</AppShell>
