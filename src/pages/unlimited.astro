---
/* The subscription offer. UNLISTED: only people Neil sends the link to see it. Nothing on the
   site links here, it is out of sitemap.xml and llms.txt, and noindex keeps it out of search.
   Use noindex, never a robots.txt Disallow: a Disallow stops the crawl, so search engines never
   read the noindex and the bare URL can still surface from an outside link.

   This page keeps its own offer (price, refund window, open spots, the live payment link),
   which no other page on the site shows.

   Everything numeric has to stay true. When a spot fills, change SPOTS_LEFT and nothing else:
   the label, the price card, the FAQ and the closing ask all read from it. */
import AppShell from '../layouts/AppShell.astro';
import Section from '../components/site/Section.astro';
import PageHead from '../components/site/PageHead.astro';
import SectionHead from '../components/site/SectionHead.astro';
import Button from '../components/site/Button.astro';
import Icon from '../components/site/Icon.astro';
import Steps from '../components/site/Steps.astro';
import RuledGrid from '../components/site/RuledGrid.astro';
import RuledCell from '../components/site/RuledCell.astro';
import CheckList from '../components/site/CheckList.astro';
import DefList from '../components/site/DefList.astro';
import CtaRow from '../components/site/CtaRow.astro';
import Faq from '../components/site/Faq.astro';
import Breadcrumb from '../components/site/Breadcrumb.astro';
import { SITE, waUrl } from '../data/site';
import { ORGANIZATION_REF, PERSON_REF, SOCIAL_IMAGE_URL, WEBSITE_REF } from '../lib/seo';
import '../styles/pages/unlimited.css';

export const prerender = true;

const SPOTS_TOTAL = 3;
const SPOTS_LEFT = 2;
const PRICE = 1500;

/* LIVE payment link on Neil's own Stripe account. Charges the first month immediately on a
   monthly recurring price, no trial: the risk reversal is the 14 day refund. It collects a
   phone number and an optional website, then redirects to /unlimited/thanks, so that page must
   keep existing while this link does. */
const SUBSCRIBE_HREF = 'https://buy.stripe.com/fZufZh6FI83pbcy87E1kA02';
const BOOK_HREF = SITE.booking;
const WA_HREF = waUrl('Hi Neil, I want to ask about the $1,500 a month plan. ');

const money = `$${PRICE.toLocaleString('en-US')}`;
const spotsLabel = SPOTS_LEFT === 1 ? '1 spot left' : `${SPOTS_LEFT} of ${SPOTS_TOTAL} spots left`;
const spotsSentence = SPOTS_LEFT === 1 ? 'is 1 spot' : `are ${SPOTS_LEFT} spots`;

const title = 'Unlimited Marketing and Software | $1,500 a Month';
const description =
  'One subscription for landing pages, websites, ads, software, funnels and automation. Unlimited requests, one at a time, most things live in one to two days. Three clients only. 14 day refund, cancel anytime.';
const canonical = `${SITE.url}/unlimited`;

const FLOW = [
  { title: 'Subscribe', text: `We get on a call, you pay ${money} for the first month, and you get your own portal login the same week.` },
  { title: 'Request', text: 'Add as many requests as you want to your queue. Pages, sites, ads, software, funnels, automation, copy and design.' },
  { title: 'Receive', text: 'I build the top one until it is done. Most land in one to two days. You review, comment and approve, and the next one starts.' },
];

const BENEFITS = [
  { t: 'Your own portal', d: 'Your queue, every file, every version and our whole conversation in one login. Comment on the actual file instead of describing what you mean.' },
  { t: 'One fixed price', d: `${money} a month, AI usage included. No hourly billing, no scope arguments and no invoice at the end you did not see coming.` },
  { t: 'One to two day turnaround', d: 'Most requests are back with you inside two days. The bigger ones have their numbers further down this page.' },
  { t: 'Design, code and marketing', d: 'Three careers in one person. Nothing gets handed between a designer, a developer and a strategist who never spoke.' },
  { t: 'Reorder whenever you want', d: 'Priorities move. Drag your queue, and the thing I build next is whatever matters most to you today.' },
  { t: 'You own all of it', d: 'Code, accounts, domains and assets. Nothing sits behind a platform you have to keep renting from me, and nothing breaks when you stop paying.' },
];

const INCLUDED = [
  'Unlimited requests, one at a time',
  'Most requests back in 1 to 2 days',
  'Unlimited revisions until you are happy',
  'Pages, websites, ads, software, funnels, automation',
  'Copy and design included, not extra',
  'AI usage included, no credits to top up',
  'Your own client portal',
  'You own everything I build',
];

const REQUESTS = [
  { num: '01', name: 'Landing pages', blurb: 'One page built around one action, written and designed to convert traffic you already pay for.', items: 'Copy included, mobile first, tracking wired, A/B variants' },
  { num: '02', name: 'Websites', blurb: 'Multi-page sites that look like your business instead of a template, and that search engines can read.', items: 'Custom design, Astro or Next, SEO ready, CMS if you need it' },
  { num: '03', name: 'Ads and creative', blurb: 'Static ads, carousels, hooks and the copy underneath them. Built to be tested, not admired.', items: 'Meta and Google, hook variants, static and carousel, ad copy' },
  { num: '04', name: 'Software and web apps', blurb: 'Portals, dashboards, CRMs and internal tools with real logins and real data, not a clickable mockup.', items: 'Auth and roles, database, integrations, deployed live' },
  { num: '05', name: 'Funnels and CRM', blurb: 'First click to booked call, with every handoff connected: page, form, CRM, follow-up and reporting.', items: 'Lead capture, GoHighLevel, email and SMS, booking' },
  { num: '06', name: 'Automation and AI agents', blurb: 'The repetitive thing eating hours of your week, turned into something that runs without you.', items: 'n8n and Zapier, AI agents, data sync, reporting' },
  { num: '07', name: 'Copy', blurb: 'Sales pages, emails, SMS, ad copy and scripts. A page built on the wrong message converts badly however it looks.', items: 'Sales pages, email sequences, cold outreach, scripts' },
  { num: '08', name: 'Design and brand', blurb: 'Logos, decks, social sets, one-pagers and the small assets that never seem worth a whole project.', items: 'Logos and marks, decks, social sets, one-pagers' },
];

/* Real numbers, not a best case. Publishing the slow ones next to the fast ones is what makes
   the fast ones believable. */
const TURNAROUND = [
  { term: 'Landing page', value: '1 to 2 days' },
  { term: 'Ad creative and ad copy', value: '1 to 2 days' },
  { term: 'Email or SMS sequence', value: '1 to 2 days' },
  { term: 'Logo, deck or social set', value: '1 to 2 days' },
  { term: 'Multi-page website', value: '3 to 5 days' },
  { term: 'Funnel with CRM wiring', value: '3 to 5 days' },
  { term: 'Automation or AI agent', value: '2 to 5 days' },
  { term: 'Software or web app', value: '5 to 10 days' },
];

const PORTAL = [
  { title: 'Your queue, in order.', text: 'What is being built now, what is next and where every request sits. Drag it to change my priorities.' },
  { title: 'Comments on the actual file.', text: 'Point at the thing you want changed instead of describing it. Every file and every version in one place.' },
  { title: 'Messages that are not email.', text: 'Ask me something at 9pm and it lands against the project it belongs to, not in an inbox with 400 other things.' },
  { title: 'Review and approve in one screen.', text: 'You sign off, the request closes and the next one starts. Nothing sits half done waiting on a reply nobody chased.' },
];

const SLOP = [
  { title: 'AI writes code that looks right and is wrong.', text: 'I shipped an app where the public database key could read buyer contact details across 31 tables. Nothing errored. The app worked. It was a live data leak, and only a review pass found it.' },
  { title: 'AI does not check the thing it just built.', text: 'A floating button on my own site sat directly on top of a form submit. Tapping "Send" opened WhatsApp instead. The screenshots looked perfect, because a screenshot cannot tell you what is on top.' },
  { title: 'AI has no idea what you did not say.', text: 'My site ran 16 months with zero search impressions because nobody submitted the sitemap. Every page was written well. 27 of 29 were unknown to Google.' },
  { title: 'AI stops at the demo. Your customers do not.', text: 'The first screen looks finished in an afternoon. Then a real user takes the path the demo never covered, one fix creates two new bugs, and nobody is sure what changed.' },
];

const COMPARE = [
  { label: 'What it costs', a: '$6,000 to $15,000 a month', b: '$500 to $5,000 per project', c: '$20 to $200 a month', d: `${money} a month` },
  { label: 'Time to a first version', a: 'Weeks to months', b: 'Days to weeks, if they reply', c: 'Minutes', d: '1 to 2 days for most of it' },
  { label: 'Who you talk to', a: 'An account manager', b: 'A different person each time', c: 'Nobody', d: 'Me' },
  { label: 'Who writes the copy', a: 'A junior on the team', b: 'Usually you', c: 'You, then you fix it', d: 'Me, included' },
  { label: 'Who fixes it at 11pm', a: 'A ticket queue', b: 'You hire someone again', c: 'You', d: 'Me' },
  { label: 'What you own at the end', a: 'Sometimes their platform', b: 'Whatever you were handed', c: 'Your account on their stack', d: 'All of it. Code and accounts.' },
  { label: 'How long you are locked in', a: '6 to 12 months', b: 'Per project', c: 'Monthly', d: 'Cancel anytime' },
];

const GUARANTEE = [
  { title: '14 days, 100% back.', text: 'If you do not like the work or the output, ask me inside the first two weeks and I refund the whole month. No form, no exit call, no "let me try to save this".' },
  { title: 'You keep everything I already built.', text: 'The pages, the code, the assets and the accounts. I am not going to take work back from you on the way out.' },
  { title: 'Cancel anytime after that.', text: 'No contract and no notice period. The month you paid for finishes, then nothing renews. Leaving should be as easy as starting.' },
  { title: 'If I am not the right fit, I say so on the call.', text: 'Before you pay anything. Sometimes the honest answer is that you need a fixed-scope project, or that you should not build this at all.' },
];

const FAQ = [
  { q: 'What counts as one request?', a: 'One deliverable. A landing page, a set of ads, an automation, a sequence or an app screen. If you send me something huge, I break it into pieces on the call and we work through them in order, so you always know what is being built right now.' },
  { q: 'How many requests can I make?', a: 'As many as you want. Add fifty to the queue on day one if you like. The only rule is that I work on one at a time, so the thing at the top gets my full attention instead of five things each getting a fifth of it.' },
  { q: 'Why one at a time and not two or three?', a: 'Because that is the only honest way to promise one to two days. Every unlimited service that works on five things at once is really telling you everything takes three weeks. You can reorder the queue whenever you want, so the top of the list is always whatever matters most to you today.' },
  { q: 'Is the turnaround really one to two days?', a: 'For most of it, yes. Pages, ads, copy, sequences and design assets land in one to two days. Websites, funnels and software take longer because they carry data, logins and integrations, and I publish those numbers on this page rather than hiding them. Whatever the job is, you get the estimate before I start it, not after.' },
  { q: 'Is video included?', a: `No, and I would rather say that plainly than bury it. Generating video burns real money on every render, far more than everything else on this page put together, so it sits outside the ${money}. If you want video I quote the batch before I make anything and you decide with the number in front of you. It starts around $500 depending on length and how much generation it takes.` },
  { q: 'What is the portal?', a: 'Your own login, set up during onboarding. Your queue, the work in progress, every file and our whole conversation live there. You comment directly on the file instead of describing what you mean in an email thread, and you approve from the same screen. Nothing important happens somewhere you cannot see it.' },
  { q: 'What if I do not like the work?', a: 'Ask for changes and I redo it. That is not the refund, that is just the job, and revisions are unlimited. If after two weeks you decide the whole arrangement is not for you, ask and I send 100% back, and you keep everything I already built.' },
  { q: 'Can I cancel anytime?', a: 'Yes. There is no contract and no notice period. Cancel and the month you paid for finishes out, then nothing renews. I would rather you leave easily than stay because leaving is annoying.' },
  { q: 'Do I own what you build?', a: 'All of it. Code, accounts, domains and assets. Nothing sits behind a platform you have to keep renting from me, and nothing breaks the day you stop paying. If you take the work in house later, I will hand it over properly.' },
  { q: 'Do you use AI to do the work?', a: 'Constantly, and I am not going to pretend otherwise. It is why one person can move this fast at this price. The difference is that I am the engineer reviewing what comes out, and the four defects listed above are real ones from my own build logs that got past a first pass. That review is the thing you are actually paying for.' },
  { q: `Why only ${SPOTS_TOTAL} clients?`, a: `Because I am one person, and one at a time is a promise rather than a slogan. With ${SPOTS_TOTAL} clients I can hold every project in my head and turn work around in days. At ten I would be an agency with a queue, which is the thing this exists to avoid. There ${spotsSentence} open right now.` },
  { q: 'What if I need two things at once?', a: 'Tell me on the call. Sometimes the honest answer is that a subscription is the wrong shape for you and a fixed-scope project is better, and I will say so. I would rather lose the sale than take money for a plan that does not fit what you need.' },
  { q: 'What do you need from me to start?', a: 'Access to whatever the work touches, brand assets if you have them, and a reply within a day or so when I ask a question. That is it. If a request stalls waiting on you, I move to the next one in your queue rather than sitting idle.' },
  { q: 'Who else have you built for?', a: 'Small teams and founders across construction, finance, roofing, ecommerce and marketing, and more than 40 products shipped in 2026. The work page shows what I can share, with each build named for what it does.' },
];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: 'Unlimited marketing and software subscription',
  description,
  url: canonical,
  provider: ORGANIZATION_REF,
  serviceType: 'Marketing and software development subscription',
  areaServed: { '@type': 'Country', name: 'United States' },
  offers: {
    '@type': 'Offer',
    '@id': `${canonical}#offer`,
    price: String(PRICE),
    priceCurrency: 'USD',
    availability: SPOTS_LEFT > 0 ? 'https://schema.org/LimitedAvailability' : 'https://schema.org/SoldOut',
    url: canonical,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: PRICE,
      priceCurrency: 'USD',
      unitCode: 'MON',
      billingDuration: 1,
      billingIncrement: 1,
    },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'What you can request',
    itemListElement: REQUESTS.map((r) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: r.name, description: r.blurb } })),
  },
};
const webpage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  isPartOf: WEBSITE_REF,
  about: PERSON_REF,
  mainEntity: { '@id': `${canonical}#service` },
};
---
<AppShell
  title={title}
  description={description}
  canonical={canonical}
  ogImage={SOCIAL_IMAGE_URL}
  active="services"
  noindex
  closing={{
    title: SPOTS_LEFT === 1 ? 'One spot left.' : `${SPOTS_LEFT} spots left.`,
    accent: 'Take one.',
    lead: `${money} a month, unlimited requests, one at a time, and most things back with you in one to two days. Two weeks to decide whether you like working with me, and a full refund if you do not.`,
    primary: { href: SUBSCRIBE_HREF, label: 'Claim a spot' },
    secondary: { href: BOOK_HREF, label: 'Book a call first' },
  }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webpage)} />
    <script type="application/ld+json" set:html={JSON.stringify(service)} />
  </Fragment>
  <Breadcrumb items={[{ name: 'Home', url: `${SITE.url}/` }, { name: 'Unlimited', url: canonical }]} back={false} />

  <PageHead class="unl-head" label={spotsLabel} title="Everything you need built, for" accent={`${money} a month.`} lead="Unlimited requests. One at a time. Cancel anytime.">
    <p class="unl-lede">Landing pages, websites, ads, software, funnels, automation, copy and design. Ask for as much as you want. I build one at a time, and most of it is back with you in one to two days. I take {SPOTS_TOTAL} clients, which is the only reason that promise holds.</p>
    <div class="btn-row btn-row--stack">
      <Button href={SUBSCRIBE_HREF}>Claim a spot</Button>
      <Button href="#pricing" variant="secondary">See what is included</Button>
    </div>
    <p class="t-small">Try it for two weeks. If you do not like the work, ask and I refund all of it.</p>
  </PageHead>

  <Section band="mist" labelledby="unl-how-title">
    <SectionHead id="unl-how-title" title="Three steps, then we are working." />
    <Steps items={FLOW} />
  </Section>

  <Section labelledby="unl-why-title">
    <SectionHead id="unl-why-title" strong="Better than a freelancer you have to chase." rest="And cheaper than an agency where the person you liked on the sales call never touches your account again." />
    <RuledGrid cols={3} label="Why this instead">
      {BENEFITS.map((b) => <RuledCell title={b.t} titleAs="h3" text={b.d} />)}
    </RuledGrid>
  </Section>

  <Section labelledby="unl-req-title">
    <SectionHead id="unl-req-title" title="Eight things, one subscription." lead="Whatever your business needs made this month, ask for it. You are not buying a category, you are buying my output." />
    <RuledGrid cols={4} label="What you can request" class="unl-req">
      {REQUESTS.map((r) => (
        <RuledCell label={r.num} title={r.name} compact text={r.blurb}>
          <p class="t-label unl-req-items">{r.items}</p>
        </RuledCell>
      ))}
    </RuledGrid>
  </Section>

  <Section band="mist" labelledby="unl-rule-title" class="unl-rule">
    <div class="unl-rule-grid">
      <h2 class="t-h2" id="unl-rule-title">Unlimited requests. One at a time.</h2>
      <div class="unl-rule-copy">
        <p>Put as many requests in the queue as you want. I work the top one until it is done, then the next. You reorder the list whenever your priorities move, so the thing I am building is always the thing that matters most to you today.</p>
        <p>This is the part most unlimited services get wrong. Working on five things at once is how a two day job quietly becomes a three week job. One at a time is not a limit I am apologizing for. It is the reason the numbers below are real.</p>
        <p class="unl-strong">If it is not being built yet, you can see exactly where it sits in line.</p>
      </div>
    </div>
  </Section>

  <Section labelledby="unl-fast-title">
    <div class="unl-split">
      <SectionHead id="unl-fast-title" title="The honest numbers." lead="Complexity moves these, and you get the number for your request before I start it. Nothing here is a best case." />
      <DefList items={TURNAROUND} />
    </div>
  </Section>

  <Section id="pricing" labelledby="unl-price-title" class="unl-pricing">
    <SectionHead id="unl-price-title" title="One subscription. Everything above." />
    <div class="unl-price-grid">
      <div class="unl-price">
        <p class="t-label">Cancel anytime</p>
        <p class="unl-price-num"><span>{money}</span><span class="unl-price-per">per month</span></p>
        <p class="unl-price-sub">Unlimited requests and revisions, one at a time. AI usage included.</p>
        <CheckList items={INCLUDED} />
        <div class="unl-price-actions">
          <Button href={SUBSCRIBE_HREF} full>Claim a spot</Button>
          <a class="link-arrow" href={BOOK_HREF} target="_blank" rel="noopener">Or book a call first<Icon name="arrow-up-right" strokeWidth={2} /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <p class="t-small">{spotsLabel}. I take {SPOTS_TOTAL} clients, and that is not a marketing number.</p>
      </div>
      <div class="unl-notes">
        <div class="unl-note">
          <h3 class="t-h4">Two weeks to change your mind.</h3>
          <p>If you do not like the work or the output, ask inside the first 14 days and I refund 100%. You keep everything I already built.</p>
        </div>
        <div class="unl-note">
          <h3 class="t-h4">Video is quoted separately.</h3>
          <p>Every render costs real money, more than everything else combined, so I will not hide it in the price. Batches start around $500 and you see the number first.</p>
        </div>
        <div class="unl-note">
          <h3 class="t-h4">Questions first?</h3>
          <p>Ask me anything on WhatsApp before you decide.</p>
          <a class="link-arrow" href={WA_HREF} target="_blank" rel="noopener">Ask me on WhatsApp<Icon name="arrow-up-right" strokeWidth={2} /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
    </div>
  </Section>

  <Section labelledby="unl-portal-title">
    <SectionHead id="unl-portal-title" title="You watch it get built." lead="No status emails, no 'checking with the team' and no wondering what happened this week. One login, and everything is in it." />
    <RuledGrid cols={4} label="The portal">
      {PORTAL.map((p) => <RuledCell title={p.title} compact text={p.text} />)}
    </RuledGrid>
  </Section>

  <Section band="mist" labelledby="unl-who-title">
    <div class="unl-rule-grid">
      <h2 class="t-h2" id="unl-who-title">One person, three careers deep.</h2>
      <div class="unl-rule-copy">
        <p>My path ran from IT to design, then funnels, automation and AI. So I see the whole business, from the page a lead lands on to the report the owner reads.</p>
        <p>Most people in this field have one of those. I have design, engineering and marketing, and the combination is the point. I can design the thing, build the thing and tell you why the business needed it. The handoffs where projects usually lose their shape do not exist when one person carries all three.</p>
        <p>More than 40 products shipped in 2026. That is not a brag about volume. It is how I keep the feedback loop short enough to learn from.</p>
        <a class="link-arrow" href="/story">More about me<Icon name="arrow-right" strokeWidth={2} /></a>
      </div>
    </div>
  </Section>

  <Section labelledby="unl-slop-title">
    <SectionHead id="unl-slop-title" title="You are paying for the part that catches this." lead="Every example below is a real defect from my own build logs. This is what AI hands you when nobody experienced is reviewing it." />
    <RuledGrid cols={2} label="Real defects">
      {SLOP.map((d) => <RuledCell title={d.title} compact text={d.text} />)}
    </RuledGrid>
    <CtaRow class="unl-cta-row" text="I use the speed. I still own the engineering." cta={{ href: '/guides/why-hire-a-person-when-ai-can-build-it', label: 'Read the full breakdown' }} />
  </Section>

  <Section labelledby="unl-cmp-title">
    <SectionHead id="unl-cmp-title" title="The same job, four ways." />
    <div class="unl-cmp-wrap" role="region" aria-labelledby="unl-cmp-title" tabindex="0">
      <table class="unl-cmp">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">What you are comparing</span></th>
            <th scope="col">An agency</th>
            <th scope="col">A marketplace freelancer</th>
            <th scope="col">An AI builder</th>
            <th scope="col" class="unl-cmp-mine">This</th>
          </tr>
        </thead>
        <tbody>
          {COMPARE.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>{r.a}</td>
              <td>{r.b}</td>
              <td>{r.c}</td>
              <td class="unl-cmp-mine">{r.d}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="t-small unl-cmp-note">Agency and freelancer figures are typical US market ranges for the same scope of work, not quotes from any specific company.</p>
    <CtaRow class="unl-cta-row" text="Don't take my word for it. The work page shows what I've built, and the case studies walk through what broke and how I fixed it." cta={{ href: '/work', label: 'See the work' }} />
  </Section>

  <Section band="mist" labelledby="unl-guar-title">
    <SectionHead id="unl-guar-title" strong="Two weeks to change your mind." rest="The risk of going first should be mine, not yours." />
    <RuledGrid cols={4} label="The guarantee">
      {GUARANTEE.map((g) => <RuledCell title={g.title} compact text={g.text} />)}
    </RuledGrid>
    <p class="t-small unl-guar-line">One refund per client, which is the only condition attached to any of this.</p>
  </Section>

  <Section labelledby="unl-faq-title">
    <Faq id="unl-faq-title" title="What people ask first." items={FAQ} ask={{ href: WA_HREF, label: 'Ask me directly' }} schema />
  </Section>
</AppShell>
