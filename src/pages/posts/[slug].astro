---
/* A published note, in the same article chrome as the guides. The hidden posts that used to be
   public answer a 301 (hiddenPostRedirect); any other hidden or "now" post comes back null from
   getPostBySlug (src/lib/posts.ts), so its URL answers 404. */
import NoteArticle from '../../components/articles/NoteArticle.astro';
import { articleRows, newestFirst, noteRow, type HubRow } from '../../components/articles/rows';
import { getAllPublished, getPostBySlug, hiddenPostRedirect, setPublicCache } from '../../lib/posts';

const { slug } = Astro.params;
const moved = slug ? hiddenPostRedirect(slug) : null;
if (moved) return Astro.redirect(moved, 301);
const opts = { request: Astro.request, cookies: Astro.cookies };
const post = slug ? await getPostBySlug(opts, slug) : null;

if (!post) {
  return new Response(null, { status: 404 });
}
setPublicCache(Astro.response.headers);

/* Read next: other notes first, then the newest articles, three rows in all. */
let others: HubRow[] = [];
try {
  others = (await getAllPublished(opts)).filter((p) => p.slug !== post.slug).map(noteRow);
} catch {
  others = [];
}
const related = [...newestFirst(others), ...articleRows()].slice(0, 3);
---
<NoteArticle post={post} related={related} />
