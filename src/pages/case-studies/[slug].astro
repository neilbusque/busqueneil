---
/* Case study page (blueprint "Case study page"): back link to /work, category and year, the
   descriptive H1, lead, a 4-cell facts row, art 16/9, real numbers, then the write-up in a
   reading column with a sticky table of contents at 1200px and wider (The situation, What I
   built, How it works, How it came together, The hard parts, What changed, What I'd tell you),
   a short ask, the next project as a featured split, and the shell's closing band.
   URLs keep their original slugs; nothing visible names the product. */
import AppShell from '../../layouts/AppShell.astro';
import Art from '../../components/Art.astro';
import Button from '../../components/site/Button.astro';
import Breadcrumb from '../../components/site/Breadcrumb.astro';
import RuledGrid from '../../components/site/RuledGrid.astro';
import StatCell from '../../components/site/StatCell.astro';
import SectionHead from '../../components/site/SectionHead.astro';
import FeatureSplit from '../../components/site/FeatureSplit.astro';
import ArticleToc from '../../components/articles/ArticleToc.astro';
import CaseStudyCTA from '../../components/CaseStudyCTA.astro';
import { caseStudies, type CaseStudy } from '../../data/case-studies';
import { SITE, waGlobal } from '../../data/site';
import { AUTHOR, PUBLISHER, SOCIAL_IMAGE_URL, WEBSITE_REF } from '../../lib/seo';
import '../../styles/pages/case-study.css';

export const prerender = true;

export function getStaticPaths() {
  return caseStudies.map((cs, i) => ({
    params: { slug: cs.slug },
    props: { cs, next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}

interface Props {
  cs: CaseStudy;
  next: CaseStudy;
}

const { cs, next } = Astro.props;
const url = `${SITE.url}/case-studies/${cs.slug}`;

const FACTS = [
  { label: 'Who it was for', value: cs.facts.whoFor },
  { label: 'What I built', value: cs.facts.built },
  { label: 'Timeline', value: cs.facts.timeline },
  { label: 'Stack', value: cs.facts.stack },
];

const TOC = [
  { id: 'situation', html: 'The situation' },
  { id: 'what-i-built', html: 'What I built' },
  { id: 'how-it-works', html: 'How it works' },
  { id: 'timeline', html: 'How it came together' },
  { id: 'hard-parts', html: 'The hard parts' },
  { id: 'what-changed', html: 'What changed' },
  { id: 'takeaways', html: "What I'd tell you" },
];
const heading = (id: string) => TOC.find((t) => t.id === id)?.html ?? '';
const metricCols = (cs.metrics?.length ?? 0) === 4 ? 4 : 3;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: cs.title,
  name: cs.title,
  description: cs.seoDescription,
  url,
  dateCreated: cs.year,
  author: AUTHOR,
  publisher: PUBLISHER,
  image: SOCIAL_IMAGE_URL,
  isPartOf: WEBSITE_REF,
  mainEntityOfPage: url,
  inLanguage: 'en-US',
  keywords: cs.stack.join(', '),
};
---
<AppShell
  title={`${cs.seoTitle} | Neil Busque`}
  description={cs.seoDescription}
  canonical={url}
  ogType="article"
  active="work"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="cs" aria-labelledby="cs-title">
    <header class="section cs-top">
      <div class="wrap">
        <div class="cs-head">
          <Breadcrumb
            items={[
              { name: 'Home', url: `${SITE.url}/` },
              { name: 'Work', url: `${SITE.url}/work` },
              { name: cs.title, url },
            ]}
            backLabel="All work"
          />
          <div class="cs-meta">
            <span class="t-label">{cs.category}</span>
            <span class="t-label">{cs.year}</span>
          </div>
          <h1 class="t-h1 cs-title" id="cs-title">{cs.title}</h1>
          <p class="t-lead cs-lede">{cs.lede}</p>
          <div class="btn-row btn-row--stack">
            <Button href={waGlobal()}>Message me on WhatsApp</Button>
            {cs.liveUrl && <Button href={cs.liveUrl} variant="secondary">Open the live app</Button>}
          </div>
        </div>

        <RuledGrid cols={4} label="Project facts" class="cs-facts">
          {FACTS.map((f) => (
            <div>
              <p class="t-label">{f.label}</p>
              <p class="cs-fact">{f.value}</p>
            </div>
          ))}
        </RuledGrid>

        <Art seed={`case-${cs.slug}`} kind="project" ratio="21 / 9" palette={cs.palette} loading="eager" class="cs-art" />

        {cs.metrics && cs.metrics.length > 0 && (
          <RuledGrid cols={metricCols} label="Numbers" class="cs-metrics">
            {cs.metrics.map((m) => <StatCell value={m.value} caption={m.label} />)}
          </RuledGrid>
        )}
      </div>
    </header>

    <div class="section cs-body-section">
      <div class="wrap">
        <div class="article-body cs-body">
          <div class="prose cs-prose">
            <h2 id="situation">{heading('situation')}</h2>
            {cs.problem.body.map((p) => <p>{p}</p>)}

            <h2 id="what-i-built">{heading('what-i-built')}</h2>
            {cs.approach.body.map((p) => <p>{p}</p>)}

            <h2 id="how-it-works">{heading('how-it-works')}</h2>
            {cs.features.map((g) => (
              <>
                <h3>{g.group}</h3>
                <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
              </>
            ))}

            <h2 id="timeline">{heading('timeline')}</h2>
            <ol class="cs-tl" role="list">
              {cs.timeline.map((t) => (
                <li>
                  <span class="cs-tl-when">{t.when}</span>
                  <span class="cs-tl-body"><strong>{t.title}</strong>{t.what}</span>
                </li>
              ))}
            </ol>

            <h2 id="hard-parts">{heading('hard-parts')}</h2>
            {cs.hardParts.map((h) => (
              <>
                <h3>{h.title}</h3>
                <p><strong>The problem.</strong> {h.problem}</p>
                <p><strong>What I did.</strong> {h.solution}</p>
              </>
            ))}

            <h2 id="what-changed">{heading('what-changed')}</h2>
            {cs.outcome.body.map((p) => <p>{p}</p>)}

            <h2 id="takeaways">{heading('takeaways')}</h2>
            <ul>{cs.lessons.map((l) => <li>{l}</li>)}</ul>
            <p class="cs-proof">{cs.proof}</p>
          </div>
          <ArticleToc items={TOC} />
        </div>
        <CaseStudyCTA />
      </div>
    </div>
  </article>

  <section class="section cs-next" aria-labelledby="cs-next-title">
    <div class="wrap">
      <SectionHead id="cs-next-title" title="Next project" />
      <FeatureSplit
        label={next.category}
        year={next.year}
        title={next.title}
        text={next.summary}
        seed={`case-${next.slug}`}
        palette={next.palette}
        cta={{ href: `/case-studies/${next.slug}`, label: 'Read the case study' }}
      />
    </div>
  </section>
</AppShell>
