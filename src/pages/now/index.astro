---
import AppShell from '../../layouts/AppShell.astro';
import { getNow, setPublicCache } from '../../lib/posts';
import { isNowFresh } from '../../lib/now';
import type { Post } from '../../lib/types';

const { current, archive } = await getNow({ request: Astro.request, cookies: Astro.cookies });
setPublicCache(Astro.response.headers);

const isFresh = isNowFresh(current?.published_at);
const archived: Post[] = isFresh ? archive : [current, ...archive].filter((post): post is Post => Boolean(post));

const fallbackTitle = 'Building better software, writing more, and getting sharper.';
const fallbackBody = 'I am focused on turning rough ideas into things people can actually use. I am especially interested in custom software, AI tools that do real work, workflow systems, and products that feel simple on the surface even when the backend is doing a lot.';

function fullDate(iso: string | null): string {
  return iso ? new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '';
}

const canonical = 'https://busqueneil.com/now';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonical}#webpage`,
  name: 'What Neil Busque Is Doing Now',
  description: 'What Neil Busque is building, learning, and focusing on right now.',
  url: canonical,
  dateModified: isFresh && current?.updated_at ? current.updated_at : '2026-08-30',
};
---
<AppShell
  title="Now | Neil Busque"
  description="What Neil Busque is building, learning, and focusing on right now."
  canonical={canonical}
  active="now"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="kin-page">
    <header class="kin-page-head">
      <span class="eyebrow">Now</span>
      <h1 data-kinetic>What I&rsquo;m focused on <span class="accent">right now.</span></h1>
      <p class="lede">A small, honest page about the work in front of me. Inspired by the <a href="https://nownownow.com/about" target="_blank" rel="noopener">Now page movement</a>.</p>
    </header>

    <section class="kin-panel kin-now" data-reveal>
      <div>
        <span class="eyebrow">Current focus</span>
        <span class="kin-stamp">{isFresh && current?.published_at ? `Updated ${fullDate(current.published_at)}` : 'Evergreen until the next update'}</span>
      </div>
      <article class="kin-copy">
        <h2 class="kin-h2">{isFresh && current?.title ? current.title : fallbackTitle}</h2>
        {isFresh && current?.body_html ? (
          <div class="prose kin-now-prose" set:html={current.body_html} />
        ) : (
          <>
            <p>{fallbackBody}</p>
            <p>I also want to write more of the useful middle: what broke, why a decision changed, and how a rough idea became something dependable.</p>
          </>
        )}
      </article>
    </section>

    {archived.length > 0 && (
      <section class="kin-sec">
        <div class="kin-heading" data-reveal>
          <span class="eyebrow">Past updates</span>
          <h2 class="kin-h2" data-kinetic>Where my attention used to be.</h2>
        </div>
        <ul class="kin-posts">
          {archived.map((post) => (
            <li data-reveal>
              <a href={`/posts/${post.slug}`}>
                <time class="kin-post-date" datetime={post.published_at ?? undefined}>{fullDate(post.published_at)}</time>
                <span class="kin-post-title">{post.title ?? 'An earlier update'}</span>
                <svg class="kin-work-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="kin-sec kin-now-close" data-reveal>
      <p>The simplest way to follow the moving pieces is through my <a href="/blog">notes from building</a>.</p>
    </section>
  </div>
</AppShell>
