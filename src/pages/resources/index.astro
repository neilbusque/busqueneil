---
import AppShell from '../../layouts/AppShell.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getFeed } from '../../lib/posts';
import type { Post } from '../../lib/types';

const title = 'Resources — Tutorials and Writing | Neil Busque';
const description = 'Tutorials on AI agents, MCP, GEO, and shipping fast, plus what I am writing about while I build. All of it from real work, not theory.';
const canonical = 'https://busqueneil.com/resources';

// Tutorials keep living at /guides/* so their existing rankings are untouched. This is the hub.
const TUTORIALS = [
  { slug: 'geo-generative-engine-optimization-guide', title: 'GEO: How to Rank in AI Answers', blurb: 'Getting cited by ChatGPT, Perplexity, and AI Overviews. What actually works.' },
  { slug: 'google-ai-overviews-guide', title: 'How to Show Up in Google AI Overviews', blurb: 'How Google’s AI answer picks its sources, and the steps to get cited inside it.' },
  { slug: 'build-ai-agent-claude-code', title: 'How to Build an AI Agent with Claude Code and MCP', blurb: 'A real build: model plus tools plus a loop, with config and the common mistakes.' },
  { slug: 'what-is-mcp-model-context-protocol', title: 'What Is MCP (Model Context Protocol)?', blurb: 'A plain explainer: what MCP is, the problem it solves, and how servers work.' },
  { slug: 'ship-web-app-in-days-with-ai', title: 'How to Ship a Web App in Days with AI', blurb: 'The workflow I use to go from an idea to a live, working app in days.' },
];

// The feed is a live query; if it fails the tutorials half of the page must still render.
let posts: Post[] = [];
try {
  const feed = await getFeed({ request: Astro.request, cookies: Astro.cookies }, { page: 1 });
  posts = feed.posts.slice(0, 5);
} catch { posts = []; }
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tutorials by Neil Busque',
  itemListElement: TUTORIALS.map((t, i) => ({
    '@type': 'ListItem', position: i + 1, name: t.title,
    url: `https://busqueneil.com/guides/${t.slug}`,
  })),
};
---
<AppShell title={title} description={description} canonical={canonical} active="resources">
  <Fragment slot="head">
    <Breadcrumb items={[
      { name: 'Home', url: 'https://busqueneil.com/' },
      { name: 'Resources', url: canonical },
    ]} />
    <script type="application/ld+json" set:html={JSON.stringify(list)} />
  </Fragment>

  <span class="eyebrow">Resources</span>
  <h1 class="sec">Tutorials and <span class="mark-hl">writing.</span></h1>
  <p class="res-lede">Two different things. Tutorials are how to do something, written from builds that actually shipped. Writing is what I am thinking about while I build.</p>

  <section class="hsec">
    <span class="eyebrow">Tutorials</span>
    <h2 class="sec">How to <span class="mark-hl">do it.</span></h2>
    <ul class="postlist res">
      {TUTORIALS.map((t) => (
        <li>
          <a href={`/guides/${t.slug}`}>
            <span class="pl-main">
              <span class="pl-title">{t.title}</span>
              <span class="pl-blurb">{t.blurb}</span>
            </span>
            <span class="tag">Tutorial</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="hsec">
    <span class="eyebrow">Writing</span>
    <h2 class="sec">What I&rsquo;m <span class="mark-hl">thinking about.</span></h2>
    {posts.length > 0 ? (
      <ul class="postlist res">
        {posts.map((p) => (
          <li>
            <a href={`/posts/${p.slug}`}>
              <span class="pl-main">
                <span class="pl-title">{p.title}</span>
              </span>
              <span class="tag">Post</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="v8-card nowcta">
        <p>Newest writing lands on the blog first.</p>
      </div>
    )}
    <p style="margin-top:22px"><a class="link-arrow" href="/blog">All writing
      <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#16150F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
  </section>
</AppShell>
