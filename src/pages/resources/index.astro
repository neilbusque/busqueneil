---
/* The resources hub (blueprint "Resources"): page head with search, three featured reads, the
   four topics, every guide, comparison, study and published note in one table, and the free
   tools strip. Rendered on request so filters, search and "Show more" work from the URL
   without JavaScript, and so newly published notes appear within a minute. /guides, /blog,
   /notes, /feed, /posts and /now all 301 here. */
import AppShell from '../../layouts/AppShell.astro';
import PageHead from '../../components/site/PageHead.astro';
import Section from '../../components/site/Section.astro';
import SectionHead from '../../components/site/SectionHead.astro';
import RuledGrid from '../../components/site/RuledGrid.astro';
import RuledCell from '../../components/site/RuledCell.astro';
import ToolCard from '../../components/site/ToolCard.astro';
import Breadcrumb from '../../components/site/Breadcrumb.astro';
import Icon from '../../components/site/Icon.astro';
import FeaturedReads from '../../components/articles/FeaturedReads.astro';
import ResourceIndex from '../../components/articles/ResourceIndex.astro';
import ResourceSearch from '../../components/articles/ResourceSearch.astro';
import { articleRows, indexTabs, newestFirst, noteRow, type HubRow } from '../../components/articles/rows';
import { TOPICS } from '../../data/content-index';
import { FEATURED_TOOL, TOOLS, type Tool } from '../../data/site';
import { getAllPublished } from '../../lib/posts';
import { hubHref, parseHubFilters } from '../../lib/blogFilters';
import { SITE_URL } from '../../lib/seo';
import '../../styles/pages/articles.css';

const title = 'Guides on AI agents, automation and software | Neil Busque';
const description = 'Plain guides, tool comparisons and original research on AI agents, automation, custom software and AI search, written from real builds.';
const canonical = `${SITE_URL}/resources`;

const filters = parseHubFilters(Astro.url.searchParams);

/* Notes are a live query. If it fails, the articles still render. */
let notes: HubRow[] = [];
try {
  notes = (await getAllPublished({ request: Astro.request, cookies: Astro.cookies })).map(noteRow);
} catch {
  notes = [];
}
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const articles = articleRows();
const everything = newestFirst([...articles, ...notes]);
const inTopic = filters.topic ? everything.filter((r) => r.topic === filters.topic) : everything;
const topic = filters.topic ? TOPICS.find((t) => t.key === filters.topic) ?? null : null;
const tabs = indexTabs(inTopic, 'hub', filters.topic);
/* A kind with no rows (no notes yet, say) falls back to the whole list rather than an empty tab. */
const active = tabs.some((t) => t.key === filters.kind) ? filters.kind : 'all';

/* Featured: the strongest piece on why a person still matters, the flagship study, and the
   voice-agent comparison. Picked by hand; a slug that disappears simply drops out. */
const FEATURED = ['why-hire-a-person-when-ai-can-build-it', '866-custom-software-ads', 'ai-phone-agent-vs-chatbot-vs-live-chat'];
const featured = FEATURED.map((slug) => articles.find((r) => r.slug === slug)).filter((r): r is HubRow => Boolean(r));

const topicCount = (key: string) => articles.filter((r) => r.topic === key).length;

/* Free tools strip: the same three the home page shows (analyzer, CRM, funnel simulator). */
const STRIP = ['crm-with-ai-follow-up', 'funnel-simulator'];
const tools: Tool[] = [FEATURED_TOOL, ...STRIP.map((slug) => TOOLS.find((t) => t.slug === slug)).filter((t): t is Tool => Boolean(t))];
const strip = tools.length >= 3 ? tools.slice(0, 3) : [FEATURED_TOOL, ...TOOLS].slice(0, 3);

const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    '@id': `${canonical}#list`,
    name: 'Guides, comparisons and research by Neil Busque',
    numberOfItems: everything.length,
    itemListElement: everything.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.title,
      url: `${SITE_URL}${r.href}`,
    })),
  },
};
---
<AppShell title={title} description={description} canonical={canonical} active="resources">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <Breadcrumb back={false} items={[{ name: 'Home', url: `${SITE_URL}/` }, { name: 'Resources', url: canonical }]} />

  <PageHead
    title="Guides written from"
    accent="real work."
    lead="Plain guides, side-by-side tool comparisons and my own research on AI agents, automation and building software. Free to read, no email needed."
    class="rhead"
  >
    <Fragment slot="aside">
      <ResourceSearch query={filters.query} kind={active} topic={filters.topic} />
    </Fragment>
  </PageHead>

  {featured.length === 3 && (
    <Section labelledby="featured-title" class="rsec-featured">
      <h2 class="sr-only" id="featured-title">Featured</h2>
      <FeaturedReads lead={featured[0]} side={featured.slice(1)} palettes={['navy']} />
    </Section>
  )}

  <Section labelledby="topics-title" class="rsec-topics">
    <SectionHead id="topics-title" title="Browse by topic" />
    <RuledGrid cols={4} label="Topics" class="rtopics">
      {TOPICS.map((t) => (
        <RuledCell
          href={hubHref({ topic: t.key })}
          title={t.name}
          titleAs="h3"
          compact
          text={t.line}
          cta={`${topicCount(t.key)} articles`}
          aria-current={filters.topic === t.key ? 'true' : undefined}
        />
      ))}
    </RuledGrid>
  </Section>

  <Section id="everything" labelledby="everything-title" class="rsec-all">
    <div class="rsec-all-head">
      <h2 class="t-h2" id="everything-title">{topic ? topic.name : 'The full list'}</h2>
      {topic && (
        <a class="link-arrow" href={hubHref({ kind: active })}>Show every topic<Icon name="arrow-right" strokeWidth={2} /></a>
      )}
    </div>
    <ResourceIndex
      rows={inTopic}
      tabs={tabs}
      active={active}
      query={filters.query}
      expanded={filters.expanded}
      moreHref={hubHref({ topic: filters.topic, kind: active, query: filters.query, expanded: true }, '')}
    />
  </Section>

  <Section band="mist" labelledby="tools-title" class="rsec-tools">
    <SectionHead id="tools-title" title="Free tools to try today" link={{ href: '/free', label: 'All free tools' }} />
    <div class="tool-grid">
      {strip.map((t) => (
        <ToolCard href={t.href} name={t.name} text={t.text} platform={t.platform} cta={t.cta} free={t.free} seed={t.slug} palette={t.palette} layout={t.layout} image={t.image} imageAlt={t.imageAlt} />
      ))}
    </div>
  </Section>
</AppShell>
