---
import AppShell from '../../layouts/AppShell.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getFeed } from '../../lib/posts';
import type { Post } from '../../lib/types';

const title = 'AI, Automation and Web App Guides | Neil Busque';
const description = 'Practical guides to AI agents, MCP, AI search, and shipping web apps, plus honest notes from the products Neil Busque is building.';
const canonical = 'https://busqueneil.com/resources';

// Tutorials keep living at /guides/* so their existing rankings are untouched. This is the hub.
const TUTORIALS = [
  { slug: 'geo-generative-engine-optimization-guide', title: 'GEO and AI Search: What Actually Helps', blurb: 'The useful parts of AI search optimization, without the llms.txt myths or schema tricks.' },
  { slug: 'google-ai-overviews-guide', title: 'How to Show Up in Google AI Overviews', blurb: 'Google’s current guidance, translated into a practical checklist for your site.' },
  { slug: 'build-ai-agent-claude-code', title: 'How to Build an AI Agent with Claude Code and MCP', blurb: 'A working pattern: one job, a few tools, clear approval rules, and real tests.' },
  { slug: 'what-is-mcp-model-context-protocol', title: 'What Is MCP (Model Context Protocol)?', blurb: 'What MCP connects, how clients and servers work, and where the USB analogy falls short.' },
  { slug: 'ship-web-app-in-days-with-ai', title: 'How I Ship a Web App in Days with AI', blurb: 'The small-scope workflow I use to move from an idea to a reviewed, live app.' },
];

// The feed is a live query; if it fails the tutorials half of the page must still render.
let posts: Post[] = [];
try {
  const feed = await getFeed({ request: Astro.request, cookies: Astro.cookies }, { page: 1 });
  posts = feed.posts.slice(0, 5);
} catch { posts = []; }
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const list = {
  '@type': 'ItemList',
  '@id': `${canonical}#guide-list`,
  name: 'Tutorials by Neil Busque',
  itemListElement: TUTORIALS.map((t, i) => ({
    '@type': 'ListItem', position: i + 1, name: t.title,
    url: `https://busqueneil.com/guides/${t.slug}`,
  })),
};
const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  mainEntity: list,
};
---
<AppShell title={title} description={description} canonical={canonical} active="resources">
  <Fragment slot="head">
    <Breadcrumb items={[
      { name: 'Home', url: 'https://busqueneil.com/' },
      { name: 'Resources', url: canonical },
    ]} />
    <script type="application/ld+json" set:html={JSON.stringify(collection)} />
  </Fragment>

  <span class="eyebrow">Resources</span>
  <h1 class="sec">Tutorials and the <span class="mark-hl">blog.</span></h1>
  <p class="res-lede">The guides explain how I do the work. The blog is looser: what I am building, what broke, and what I changed my mind about.</p>

  <section class="hsec">
    <span class="eyebrow">Tutorials</span>
    <h2 class="sec">How to <span class="mark-hl">do it.</span></h2>
    <ul class="postlist res">
      {TUTORIALS.map((t) => (
        <li>
          <a href={`/guides/${t.slug}`}>
            <span class="pl-main">
              <span class="pl-title">{t.title}</span>
              <span class="pl-blurb">{t.blurb}</span>
            </span>
            <span class="tag">Tutorial</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="hsec">
    <span class="eyebrow">Blog</span>
    <h2 class="sec">Everything <span class="mark-hl">else.</span></h2>
    <p class="stack-note">Build notes, lessons, and the occasional opinion I could not fit into a step-by-step guide.</p>
    {posts.length > 0 ? (
      <ul class="postlist res">
        {posts.map((p) => (
          <li>
            <a href={`/posts/${p.slug}`}>
              <span class="pl-main">
                <span class="pl-title">{p.title}</span>
              </span>
              <span class="tag">Post</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="v8-card nowcta">
        <p>Newest posts land on the blog first.</p>
      </div>
    )}
    <p style="margin-top:22px"><a class="link-arrow" href="/blog">Read the blog
      <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#16150F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
  </section>
</AppShell>
