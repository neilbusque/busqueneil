---
/* 404. Server-rendered on purpose: a prerendered 404 makes the SSR function fetch the static
   page internally, which fails behind deployment protection. Copy follows the copy deck's
   GLOBAL > 404 page. */
import AppShell from '../layouts/AppShell.astro';
import Section from '../components/site/Section.astro';
import PageHead from '../components/site/PageHead.astro';
import RuledGrid from '../components/site/RuledGrid.astro';
import RuledCell from '../components/site/RuledCell.astro';
import Button from '../components/site/Button.astro';
import { waGlobal } from '../data/site';
import '../styles/pages/notfound.css';

Astro.response.status = 404;

const PLACES = [
  { href: '/services', name: 'Services', line: "What I build and how we'd work together." },
  { href: '/work', name: 'Work', line: 'Client builds, agency work and my own products.' },
  { href: '/resources', name: 'Resources', line: 'Guides, comparisons and research.' },
  { href: '/free', name: 'Free tools', line: 'Tools you can open right now.' },
];
---
<AppShell title="Page not found | Neil Busque" description="This page moved or never existed." noindex>
  <PageHead class="nf-head" title="This page moved or never existed." lead="Try one of these instead, or message me and I'll point you to it.">
    <div class="btn-row btn-row--stack">
      <Button href={waGlobal()}>Message me on WhatsApp</Button>
      <Button href="/" variant="secondary">Go to the home page</Button>
    </div>
  </PageHead>

  <Section class="nf-places" labelledby="nf-places-title">
    <h2 class="sr-only" id="nf-places-title">Pages to try</h2>
    <RuledGrid cols={4} label="Pages to try">
      {PLACES.map((p) => <RuledCell href={p.href} title={p.name} compact text={p.line} cta="Open" />)}
    </RuledGrid>
  </Section>
</AppShell>
