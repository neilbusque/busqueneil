---
import AppShell from '../layouts/AppShell.astro';
import { caseStudies } from '../data/case-studies';
import ClientLogos from '../components/ClientLogos.astro';

/* The work splits four ways, because "a client site" and "an internal tool I use every day"
   are not the same claim and should not sit in one undifferentiated grid.
   `href` on a card means it is genuinely reachable; cards without one are internal builds
   that have no public URL, and they carry no screenshot rather than a staged one.
   That rule survived the 2026-07-25 pass deliberately: a staged or AI-generated mockup would
   present a picture of software as if it were a capture of the real thing, on a site whose
   whole argument is that the work is real. Those cards get a monogram tile instead, which
   reads as a choice where an empty grey box read as a broken image. */
type Item = { name: string; tag: string; img?: string; href?: string; note?: string };

const WEBSITES: Item[] = [
  { name: 'Darioo', tag: 'Manufacturing site + app', img: '/assets/work/darioo.webp', href: 'https://darioo.com' },
  { name: 'Scott Greenleaf', tag: 'Client rebuild', img: '/assets/work/scottgreenleaf.webp' },
];

// Everything on neilb.app: free, no account gymnastics, anyone can open them.
const PUBLIC_APPS: Item[] = [
  { name: 'Orbit', tag: 'CRM with AI agents', img: '/assets/work/orbit-app.webp', href: 'https://inorbit.one' },
  { name: 'Tandem', tag: 'App for couples', img: '/assets/work/tandem.webp', href: 'https://tandem.yengandneil.site', note: 'built this for my wife' },
  { name: 'Preflight', tag: 'Score a funnel before you spend', img: '/assets/work/preflight.webp', href: 'https://preflight.neilb.app' },
  { name: 'Flow', tag: 'Deep-work timer that blocks the noise', img: '/assets/work/flow.webp', href: 'https://goflow.space' },
  { name: 'Cue', tag: 'Teleprompter for talking-head video', img: '/assets/work/cue.webp', href: 'https://cue.neilb.app' },
  { name: 'Watch Together', tag: 'Watch in sync, far apart', img: '/assets/work/watch-together.webp', href: 'https://watch.yengandneil.site' },
];

// Internal tools. These run my own work; most have no public URL by design.
const PRIVATE_APPS: Item[] = [
  { name: 'Portal', tag: 'Client portal: files, updates, approvals' },
  { name: 'Vid', tag: 'Screen recorder and share links', img: '/assets/work/vid.webp' },
  { name: 'Prism', tag: 'Purpose-built browser for research' },
  { name: 'Hop', tag: 'Link shortener with analytics and push', img: '/assets/work/hop.webp' },
  { name: 'Magus', tag: 'Outreach agent: research, draft, follow up' },
  { name: 'Otto', tag: 'AI command center for my own ops', img: '/assets/work/otto.webp' },
];

/* What I actually do with Claude Code day to day. Framed as capability rather than as a list
   of internal skill filenames, which would mean nothing to someone deciding whether to hire me. */
const CAPABILITIES = [
  { label: 'Agents connected to your tools', body: 'Claude connected to a CRM, inbox, or database through MCP, with clear permissions and approval steps.' },
  { label: 'Parallel AI workflows', body: 'Separate agents can research, build, and review the same task, while I make the decisions and check the result.' },
  { label: 'Browser QA', body: 'I run every important flow in a real browser, at multiple screen sizes, before it goes live.' },
  { label: 'Research and outreach', body: 'Agents that find the right companies, fill in the missing context, and draft a useful first message.' },
  { label: 'Search and AI visibility', body: 'Helpful pages, clean technical SEO, and topics chosen from the questions people actually search.' },
  { label: 'Fast, reviewed shipping', body: 'Scope, plan, build, review, deploy. More than 40 products this year, most live within days of the idea.' },
];

/* Card name -> case-study slug. Preflight and Portal already had full write-ups that nothing
   on the site linked to; the slugs are 'lumen-portal' and 'suki-neighbors', not the app names,
   which is why guessing the URL 404s. A case study always wins over the raw live link, because
   the write-up ends in a CTA and the live app does not. */
const CASE_STUDY_BY_CARD: Record<string, string> = {
  Orbit: 'orbit',
  Tandem: 'tandem',
  Preflight: 'preflight',
  Portal: 'lumen-portal',
};
const csBySlug = new Map(caseStudies.map((c) => [c.slug, c]));
const csFor = (name: string) => {
  const slug = CASE_STUDY_BY_CARD[name];
  return slug && csBySlug.has(slug) ? `/case-studies/${slug}` : null;
};
const linkFor = (i: Item) => csFor(i.name) ?? i.href ?? null;
---
<AppShell
  title="Neil Busque's Work | AI Apps, Websites and Automations"
  description="Explore the AI apps, client websites, automations, and internal tools Neil Busque has designed, built, tested, and shipped."
  active="work"
>
  <span class="eyebrow">The work</span>
  <h1 class="sec">Built by one person. <span class="mark-hl">Shipped for real.</span></h1>
  <p class="res-lede">A mix of public apps, client websites, and private tools I built because I needed them. If there is a link, you can open the real thing.</p>

  <section class="hsec">
    <span class="eyebrow">Apps, free to use</span>
    <h2 class="sec">Open any of <span class="mark-hl">these.</span></h2>
    <p class="stack-note">No invite and no demo call. Open one and try it. The full collection lives at <a href="https://neilb.app">neilb.app</a>.</p>
    <div class="workgrid">
      {PUBLIC_APPS.map((w) => {
        const href = linkFor(w);
        const Tag = href ? 'a' : 'div';
        return (
          <Tag class="workcard" href={href ?? undefined}>
            {w.note && <span class="worknote">{w.note}</span>}
            <div class="wc-chrome" aria-hidden="true"><i></i><i></i><i></i><span class="wc-bar"></span></div>
            <div class="wc-shot">
              <img src={w.img} srcset={`${w.img!.replace('.webp', '-sm.webp')} 760w, ${w.img} 1440w`}
                sizes="(max-width: 900px) calc(100vw - 40px), 33vw" alt={w.name} width="1280" height="800" loading="lazy" />
              <span class="wc-live">Live</span>
            </div>
            <div class="workmeta"><b>{w.name}</b><span>{w.tag}</span></div>
          </Tag>
        );
      })}
    </div>
  </section>

  <section class="hsec">
    <span class="eyebrow">Websites</span>
    <h2 class="sec">Built for <span class="mark-hl">clients.</span></h2>
    <div class="workgrid">
      {WEBSITES.map((w) => {
        const href = linkFor(w);
        const Tag = href ? 'a' : 'div';
        return (
          <Tag class="workcard" href={href ?? undefined}>
            <div class="wc-chrome" aria-hidden="true"><i></i><i></i><i></i><span class="wc-bar"></span></div>
            <div class="wc-shot">
              <img src={w.img} srcset={`${w.img!.replace('.webp', '-sm.webp')} 760w, ${w.img} 1440w`}
                sizes="(max-width: 900px) calc(100vw - 40px), 33vw" alt={w.name} width="1280" height="800" loading="lazy" />
            </div>
            <div class="workmeta"><b>{w.name}</b><span>{w.tag}</span></div>
          </Tag>
        );
      })}
    </div>
  </section>

  <section class="hsec">
    <span class="eyebrow">Apps, private</span>
    <h2 class="sec">The tools that run <span class="mark-hl">my work.</span></h2>
    <p class="stack-note">Most of these do not have a public URL. I built them to solve problems in my own work, not to make a prettier portfolio grid.</p>
    <div class="workgrid">
      {PRIVATE_APPS.map((w) => {
        const href = linkFor(w);
        const Tag = href ? 'a' : 'div';
        return (
        <Tag class="workcard" href={href ?? undefined}>
          {w.img ? (
            <>
              <div class="wc-chrome" aria-hidden="true"><i></i><i></i><i></i><span class="wc-bar"></span></div>
              <div class="wc-shot">
                <img src={w.img} srcset={`${w.img.replace('.webp', '-sm.webp')} 760w, ${w.img} 1440w`}
                  sizes="(max-width: 900px) calc(100vw - 40px), 33vw" alt={w.name} width="1280" height="800" loading="lazy" />
              </div>
            </>
          ) : (
            <div class="wc-internal" aria-hidden="true">
              <span class="wc-mono">{w.name.charAt(0)}</span>
              <span class="wc-tagline">Internal build</span>
            </div>
          )}
          <div class="workmeta"><b>{w.name}</b><span>{w.tag}</span></div>
        </Tag>
        );
      })}
    </div>
  </section>

  <section class="hsec">
    <span class="eyebrow">What I build with</span>
    <h2 class="sec">Claude Code, <span class="mark-hl">daily.</span></h2>
    <ul class="caps">
      {CAPABILITIES.map((c) => (
        <li><b>{c.label}</b><span>{c.body}</span></li>
      ))}
    </ul>
  </section>

  <section class="hsec">
    <span class="eyebrow">Other creative work</span>
    <h2 class="sec">Graphics, banners, <span class="mark-hl">video.</span></h2>
    <p class="stack-note">Brand marks, ad creative, social graphics, and short video. It comes with the builds more often than not, because a working product with bad creative still does not convert.</p>
    <p style="margin-top:18px"><a class="link-arrow" href="/contact">Ask me for samples
      <svg width="44" height="16" viewBox="0 0 44 16" fill="none"><path d="M2 9 C 14 4, 26 12, 41 7 M35 3 L 42 7 L 35 12" stroke="#16150F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
  </section>

  {caseStudies.length > 0 && (
    <section class="hsec">
      <span class="eyebrow">Case studies</span>
      <h2 class="sec">The deep <span class="mark-hl">dives.</span></h2>
      <p class="stack-note">The longer version: what went wrong, what I decided, what was harder than expected, and what finally shipped.</p>
      <ul class="cs-list">
        {caseStudies.map((cs) => (
          <li><a class="v8-card cs-row" href={`/case-studies/${cs.slug}`}><b>{cs.name}</b><span>{cs.summary}</span></a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="hsec">
    <span class="eyebrow">Worked with</span>
    <ClientLogos />
  </section>

  <section class="hsec v8-card why-card">
    <h2>Want one of these for <span class="mark-hl">your business?</span></h2>
    <p>Every product above started as a rough sentence. Tell me what you want yours to do and I will give you an honest read on the build, the likely scope, and whether I am the right person for it.</p>
    <div class="hero-ctas" style="margin-top:18px">
      <a class="btn-sun" href="https://book.busqueneil.com/" target="_blank" rel="noopener">Book a call</a>
      <a class="btn-ghost" href="/hire">How working with me works</a>
    </div>
  </section>
</AppShell>
