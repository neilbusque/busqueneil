---
import AppShell from '../layouts/AppShell.astro';
import ClientLogos from '../components/ClientLogos.astro';
import { caseStudies } from '../data/case-studies';

type WorkItem = {
  name: string;
  tag: string;
  description: string;
  img?: string;
  href?: string;
  note?: string;
};

const SELECTED: WorkItem[] = [
  {
    name: 'Orbit CRM',
    tag: 'CRM + AI agents',
    description: 'A CRM and operations workspace with AI features, built to help manage relationships, projects, and follow-up in one place.',
    img: '/assets/work/orbit-app.webp',
    href: '/case-studies/orbit',
  },
  {
    name: 'Tandem',
    tag: 'App for couples',
    description: 'A couples app built around connection, shared experiences, and the reality of being far apart.',
    img: '/assets/work/tandem.webp',
    href: '/case-studies/tandem',
    note: 'Built this for my wife',
  },
  {
    name: 'Darioo',
    tag: 'Manufacturing site + app',
    description: 'A client site and interactive product experience built to make a complex industrial business easier to understand.',
    img: '/assets/work/darioo.webp',
    href: 'https://darioo.com',
  },
  {
    name: 'Scott Greenleaf',
    tag: 'Client site',
    description: 'A clearer, calmer client site focused on presentation, trust, and getting the message across cleanly.',
    img: '/assets/work/scottgreenleaf.webp',
    href: 'https://scottgreenleaf.com/',
  },
];

const EXPERIMENTS: WorkItem[] = [
  { name: 'Preflight', tag: 'Funnel testing', description: 'Score and click through a whole funnel before spending money on traffic.', img: '/assets/work/preflight.webp', href: 'https://preflight.neilb.app' },
  { name: 'Flow', tag: 'Focus tool', description: 'A deep-work timer that blocks the noise instead of politely suggesting focus.', img: '/assets/work/flow.webp', href: 'https://goflow.space' },
  { name: 'Cue', tag: 'Video tool', description: 'A teleprompter for talking-head video that keeps the script out of the way.', img: '/assets/work/cue.webp', href: 'https://cue.neilb.app' },
  { name: 'Watch Together', tag: 'Personal product', description: 'Watch something in sync with someone far away, built for my own long-distance marriage.', img: '/assets/work/watch-together.webp', href: 'https://watch.yengandneil.site' },
];

const PRIVATE_TOOLS: WorkItem[] = [
  { name: 'Portal', tag: 'Client files, updates, and approvals', description: 'One place for clients to see the work and respond without another email thread.', href: '/case-studies/lumen-portal' },
  { name: 'Vid', tag: 'Screen recorder', description: 'Record a screen, share one link, and keep feedback attached to the thing itself.', img: '/assets/work/vid.webp' },
  { name: 'Prism', tag: 'Research browser', description: 'A purpose-built browser for research sessions and AI-assisted synthesis.' },
  { name: 'Hop', tag: 'Links + analytics', description: 'Short links, click analytics, and push notifications for the links I actually care about.', img: '/assets/work/hop.webp' },
  { name: 'Magus', tag: 'Outreach agent', description: 'Research, draft, and follow-up support with a person reviewing what goes out.' },
  { name: 'Otto', tag: 'AI command center', description: 'An internal operations workspace that helps me keep projects and follow-ups moving.', img: '/assets/work/otto.webp' },
];

const CAPABILITIES = [
  ['AI agents connected to real tools', 'CRM, inbox, database, APIs, and approval steps instead of an isolated chatbot.'],
  ['Custom software around the real workflow', 'Portals, dashboards, internal tools, and customer products shaped around how people already work.'],
  ['Automations that survive real life', 'n8n, Zapier, GHL, webhooks, retries, failure paths, and a human in the loop where judgment matters.'],
  ['Design and frontend craft', 'Responsive interfaces with clear hierarchy, thoughtful interaction, and fewer things competing for attention.'],
  ['Testing and release work', 'Real-browser QA, permissions, edge cases, deployment, and the last part that turns a demo into dependable software.'],
];

const isExternal = (href?: string) => !!href && /^https?:\/\//.test(href);
---
<AppShell
  title="Work by Neil Busque | Apps, AI Agents and Internet Projects"
  description="Selected apps, client work, experiments, and internal tools designed and built by Neil Busque."
  active="work"
>
  <div class="kin-page">
    <header class="kin-page-head">
      <span class="eyebrow">Work</span>
      <h1 data-kinetic>Things I&rsquo;ve built and <span class="accent">shipped for real.</span></h1>
      <p class="lede">A mix of client work, personal products, experiments, and private tools I made because I needed them. If there is a link, you can open the real thing.</p>
    </header>

    <section class="kin-sec">
      <div class="kin-heading" data-reveal>
        <span class="eyebrow">Selected work</span>
        <h2 class="kin-h2" data-kinetic>A few good places to start.</h2>
      </div>
      <div class="kin-work">
        {SELECTED.map((item) => (
          <a class="kin-work-row" href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener' : undefined} data-reveal>
            <div class="kin-work-shot">
              <img src={item.img} srcset={`${item.img!.replace('.webp', '-sm.webp')} 760w, ${item.img} 1440w`} sizes="(max-width: 760px) calc(100vw - 2.5rem), 300px" alt={`${item.name}, built by Neil Busque`} width="1280" height="800" loading="lazy" decoding="async" />
            </div>
            <div class="kin-work-meta">
              <span class="kin-work-label">{item.tag}</span>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              {item.note && <small class="kin-note">{item.note}</small>}
            </div>
            <svg class="kin-work-arrow" width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        ))}
      </div>
    </section>

    <section class="kin-sec">
      <div class="kin-heading" data-reveal>
        <span class="eyebrow">Experiments</span>
        <h2 class="kin-h2" data-kinetic>Small ideas I wanted to see exist.</h2>
        <p>These are public, useful, and free to open. Some started as a personal annoyance. Some were just worth testing.</p>
      </div>
      <div class="kin-magnets kin-experiments">
        {EXPERIMENTS.map((item) => (
          <a class="kin-magnet" href={item.href} target="_blank" rel="noopener" data-reveal>
            <div class="kin-exp-shot"><img src={item.img} alt="" width="240" height="150" loading="lazy" decoding="async" /></div>
            <span class="kin-work-label">{item.tag}</span>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <span class="kin-magnet-link">Open it
              <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="kin-sec">
      <div class="kin-heading" data-reveal>
        <span class="eyebrow">Private tools</span>
        <h2 class="kin-h2" data-kinetic>The things that run my own work.</h2>
        <p>Most do not have a public URL by design. They solve real problems in my day instead of filling another portfolio grid.</p>
      </div>
      <div class="kin-tools">
        {PRIVATE_TOOLS.map((item) => {
          const Tag = item.href ? 'a' : 'article';
          return (
            <Tag href={item.href} class="kin-tool" data-reveal>
              <span class="kin-tool-initial" aria-hidden="true">{item.name.charAt(0)}</span>
              <div><span class="kin-work-label">{item.tag}</span><h3>{item.name}</h3><p>{item.description}</p></div>
            </Tag>
          );
        })}
      </div>
    </section>

    <section class="kin-sec">
      <div class="kin-heading" data-reveal>
        <span class="eyebrow">Capabilities</span>
        <h2 class="kin-h2" data-kinetic>What sits behind the screenshots.</h2>
      </div>
      <ol class="kin-caps">
        {CAPABILITIES.map(([name, description], index) => (
          <li data-reveal><span class="kin-cap-num">0{index + 1}</span><h3>{name}</h3><p>{description}</p></li>
        ))}
      </ol>
    </section>

    {caseStudies.length > 0 && (
      <section class="kin-sec">
        <div class="kin-heading" data-reveal>
          <span class="eyebrow">Case studies</span>
          <h2 class="kin-h2" data-kinetic>The longer version.</h2>
          <p>What went wrong, what I decided, what was harder than expected, and what finally shipped.</p>
        </div>
        <ul class="kin-posts kin-cases">
          {caseStudies.map((study) => (
            <li data-reveal>
              <a href={`/case-studies/${study.slug}`}>
                <span class="kin-post-title">{study.name}</span>
                <span class="kin-case-summary">{study.summary}</span>
                <svg class="kin-work-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="kin-sec" data-reveal>
      <span class="eyebrow">Worked with</span>
      <ClientLogos />
    </section>

    <section class="kin-cta">
      <span class="eyebrow">That is the work</span>
      <p class="kin-cta-lede" data-reveal>Most of it started as a rough sentence and a problem somebody was tired of dealing with.</p>
      <div class="hero-ctas" data-reveal>
        <a class="btn-sun" href="https://wa.me/19083164140?text=Hi%20Neil%2C%20I%20want%20to%20build%20something" target="_blank" rel="noopener">Tell me what you want to make</a>
      </div>
    </section>
  </div>
</AppShell>
