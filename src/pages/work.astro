---
/* Work: page head with filter tabs, the featured project, eight work cards, then the "More
   builds" table. Copy follows the copy deck's WORK section; the lists come from
   src/data/site.ts and this page's own strings from src/data/work-page.ts.
   The tabs filter every [data-filter] element inside <main>: the featured split, the cards and
   the table rows. Without JS the tab bar hides and everything shows. */
import AppShell from '../layouts/AppShell.astro';
import Section from '../components/site/Section.astro';
import PageHead from '../components/site/PageHead.astro';
import SectionHead from '../components/site/SectionHead.astro';
import Tabs from '../components/site/Tabs.astro';
import FeatureSplit from '../components/site/FeatureSplit.astro';
import WorkCard from '../components/site/WorkCard.astro';
import Breadcrumb from '../components/site/Breadcrumb.astro';
import BuildsTable from '../components/work/BuildsTable.astro';
import { FEATURED_PROJECT, MORE_BUILDS, PROJECTS, SITE, WORK_TABS } from '../data/site';
import { WORK_PAGE } from '../data/work-page';
import { PERSON_REF, WEBSITE_REF } from '../lib/seo';
import '../styles/pages/work.css';

export const prerender = true;

const canonical = `${SITE.url}/work`;
const cards = PROJECTS;
const absolute = (href: string | null) => (href ? (href.startsWith('/') ? `${SITE.url}${href}` : href) : undefined);

const listed = [FEATURED_PROJECT, ...cards, ...MORE_BUILDS];
const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: WORK_PAGE.title,
  description: WORK_PAGE.description,
  url: canonical,
  isPartOf: WEBSITE_REF,
  about: PERSON_REF,
  mainEntity: {
    '@type': 'ItemList',
    name: 'Work',
    numberOfItems: listed.length,
    itemListElement: listed.map((p, i) => {
      const url = absolute(p.href);
      return { '@type': 'ListItem', position: i + 1, name: p.title, ...(url ? { url } : {}) };
    }),
  },
};
---
<AppShell title={WORK_PAGE.title} description={WORK_PAGE.description} canonical={canonical} active="work">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <Breadcrumb items={[{ name: 'Home', url: `${SITE.url}/` }, { name: 'Work', url: canonical }]} back={false} />

  <PageHead class="work-phead" title={WORK_PAGE.h1} accent={WORK_PAGE.accent} lead={WORK_PAGE.lead}>
    <Tabs target="main" label="Filter work" tabs={WORK_TABS} />
  </PageHead>

  <Section class="work-main" labelledby="work-featured-title">
    <h2 class="sr-only" id="work-featured-title">Selected builds</h2>
    <FeatureSplit
      data-filter={FEATURED_PROJECT.type}
      label={FEATURED_PROJECT.category}
      year={FEATURED_PROJECT.year}
      title={FEATURED_PROJECT.title}
      text={FEATURED_PROJECT.text}
      outcome={FEATURED_PROJECT.outcome}
      items={FEATURED_PROJECT.built}
      stack={FEATURED_PROJECT.stack}
      cta={FEATURED_PROJECT.cta}
      seed={FEATURED_PROJECT.slug}
      palette={FEATURED_PROJECT.palette}
      layout={FEATURED_PROJECT.layout}
    />
    <div class="work-grid">
      {cards.map((p) => (
        <WorkCard
          href={p.href}
          title={p.title}
          text={p.text}
          category={p.category}
          year={p.year}
          outcome={p.outcome}
          seed={p.slug}
          palette={p.palette}
          layout={p.layout}
          filter={p.type}
          data-reveal
        />
      ))}
    </div>
  </Section>

  <Section class="work-more" labelledby="more-builds-title">
    <SectionHead id="more-builds-title" title={WORK_PAGE.moreTitle} lead={WORK_PAGE.moreLead} />
    <BuildsTable rows={MORE_BUILDS} columns={WORK_PAGE.moreColumns} caption={WORK_PAGE.moreLead} />
  </Section>
</AppShell>
