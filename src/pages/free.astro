---
/* Free tools: page head, the featured analyzer, the tool cards and a build-for-you row.
   Copy follows the copy deck's FREE TOOLS section. Every tool here is free and live; a card's
   URL is only its link target, never printed. Cards held back in HELD_TOOLS never render. */
import AppShell from '../layouts/AppShell.astro';
import Section from '../components/site/Section.astro';
import PageHead from '../components/site/PageHead.astro';
import ToolCard from '../components/site/ToolCard.astro';
import CtaRow from '../components/site/CtaRow.astro';
import Breadcrumb from '../components/site/Breadcrumb.astro';
import FeaturedTool from '../components/work/FeaturedTool.astro';
import { FEATURED_TOOL, SITE, TOOLS, waFreeTools } from '../data/site';
import { FREE_PAGE, FREE_TOOL_PALETTES } from '../data/work-page';
import { PERSON_REF, WEBSITE_REF } from '../lib/seo';
import '../styles/pages/free.css';

export const prerender = true;

const canonical = `${SITE.url}/free`;
const all = [FEATURED_TOOL, ...TOOLS];
const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonical}#collection`,
  name: FREE_PAGE.title,
  description: FREE_PAGE.description,
  url: canonical,
  isPartOf: WEBSITE_REF,
  about: PERSON_REF,
  mainEntity: {
    '@type': 'ItemList',
    name: 'Free tools',
    numberOfItems: all.length,
    itemListElement: all.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: t.href.startsWith('/') ? `${SITE.url}${t.href}` : t.href,
    })),
  },
};
---
<AppShell title={FREE_PAGE.title} description={FREE_PAGE.description} canonical={canonical} active="free">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collection)} />
  <Breadcrumb items={[{ name: 'Home', url: `${SITE.url}/` }, { name: 'Free tools', url: canonical }]} back={false} />

  <PageHead title={FREE_PAGE.h1} accent={FREE_PAGE.accent} lead={FREE_PAGE.lead} />

  <Section class="free-featured" labelledby="featured-tool-title">
    <FeaturedTool
      tool={FEATURED_TOOL}
      whoLabel={FREE_PAGE.whoLabel}
      stepsLabel={FREE_PAGE.stepsLabel}
      palette={FREE_TOOL_PALETTES[FEATURED_TOOL.slug]}
      id="featured-tool-title"
    />
  </Section>

  <Section class="free-tools" labelledby="free-tools-title">
    <h2 class="sr-only" id="free-tools-title">{FREE_PAGE.gridTitle}</h2>
    <div class="tool-grid tool-grid--4">
      {TOOLS.map((t) => (
        <ToolCard
          href={t.href}
          name={t.name}
          text={t.text}
          platform={t.platform}
          free={t.free}
          cta={t.cta}
          seed={t.slug}
          palette={t.palette ?? FREE_TOOL_PALETTES[t.slug]}
          layout={t.layout}
          image={t.image}
          imageAlt={t.imageAlt}
          data-reveal
        />
      ))}
    </div>
  </Section>

  <Section band="mist" class="free-build">
    <CtaRow text={FREE_PAGE.buildLine} cta={{ href: waFreeTools(), label: FREE_PAGE.buildCta }} variant="primary" />
  </Section>
</AppShell>
