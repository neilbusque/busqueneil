---
/* About (/story; /about redirects here). Page head with a placeholder portrait slot, the story
   in a reading column, "How I work" (id how-i-work, the home statement links here), the four
   capabilities as a ruled strip, then the shell's closing band. Copy follows the copy deck's
   ABOUT section. Work only: nothing personal. */
import AppShell from '../layouts/AppShell.astro';
import Section from '../components/site/Section.astro';
import PageHead from '../components/site/PageHead.astro';
import SectionHead from '../components/site/SectionHead.astro';
import Portrait from '../components/site/Portrait.astro';
import Steps from '../components/site/Steps.astro';
import RuledGrid from '../components/site/RuledGrid.astro';
import RuledCell from '../components/site/RuledCell.astro';
import Button from '../components/site/Button.astro';
import DefList from '../components/site/DefList.astro';
import Icon from '../components/site/Icon.astro';
import Breadcrumb from '../components/site/Breadcrumb.astro';
import { ABOUT_FACTS, CAPABILITIES, SITE, waGlobal } from '../data/site';
import { AUTHOR, WEBSITE_REF } from '../lib/seo';
import '../styles/pages/about.css';

export const prerender = true;

const title = 'About Neil Busque | AI developer based in New Jersey';
const description =
  'I find the work in your business worth handing to AI, build it and keep it running. AI agents, custom software and automations. Based in New Jersey.';
const canonical = `${SITE.url}/story`;

const PARAGRAPHS = [
  "I build AI agents, voice agents, custom software, automations and the sites that bring in the leads. I've shipped more than 40 products in 2026, including operating systems for six agencies and service businesses.",
  "Every project starts with your week. I ask where the hours go, what keeps breaking and what you'd hand off tomorrow if you could. Then I build the piece that gives you the most time back.",
  'I work fast on purpose. You see a working first version in days, so your feedback shapes the real thing early.',
  'My path ran from IT to design, then funnels, automation and AI. So I see the whole business, from the page a lead lands on to the report the owner reads.',
  'I build with AI coding tools like Claude Code and Codex every day. They do a lot of the typing. My job is to catch what they get wrong: the edge case, the missing permission, the fix that breaks something else.',
  'You deal with me from the first message to launch and after. You own what I build and the accounts it runs on. I keep working until you are proud of it. If I am not the right fit, I will tell you on the first call.',
];

const HOW = [
  { title: 'Start from the work', text: 'We find the task that costs your team the most time, then decide if AI should take it.' },
  { title: 'Ship something real, fast', text: 'You click through a working first version within days and tell me what to change.' },
  { title: 'Keep a person in charge', text: 'Agents get clear limits you approve. Anything risky waits for your OK.' },
  { title: 'Plan for after launch', text: 'I keep it running and add what comes next, or hand it to your team cleanly.' },
];

const profile = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonical}#profile`,
  name: title,
  description,
  url: canonical,
  isPartOf: WEBSITE_REF,
  dateCreated: '2026-05-13',
  dateModified: '2026-10-12',
  mainEntity: {
    ...AUTHOR,
    jobTitle: 'AI developer and fractional AI lead',
    description:
      'Neil Busque, based in New Jersey, finds the work worth handing to AI for small and mid-size businesses, builds the agents, software and automations, and keeps them running.',
    homeLocation: { '@type': 'Place', name: 'New Jersey, United States' },
    sameAs: [SITE.linkedin],
  },
};
---
<AppShell title={title} description={description} canonical={canonical} active="about">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(profile)} />
  <Breadcrumb items={[{ name: 'Home', url: `${SITE.url}/` }, { name: 'About', url: canonical }]} back={false} />

  <PageHead
    class="about-head"
    title="The person behind"
    accent="the AI."
    lead="I'm Neil Busque, based in New Jersey. I find the work in a business that's worth handing to AI, then build it and keep it running."
  >
    <div class="btn-row btn-row--stack">
      <Button href={waGlobal()}>Message me on WhatsApp</Button>
      <Button href="/work" variant="secondary">See the work</Button>
    </div>
    <Fragment slot="aside">
      <Portrait class="about-portrait" seed="about-portrait" loading="eager" />
    </Fragment>
  </PageHead>

  <Section class="about-story" labelledby="about-story-title">
    <div class="about-story-grid">
      <div class="about-prose">
        <h2 class="sr-only" id="about-story-title">About me</h2>
        {PARAGRAPHS.map((p) => <p>{p}</p>)}
      </div>
      <aside class="about-facts" aria-label="Quick facts">
        <DefList items={ABOUT_FACTS} />
        <a class="link-arrow" href={waGlobal()} target="_blank" rel="noopener">Message me on WhatsApp<Icon name="arrow-up-right" strokeWidth={2} /><span class="sr-only"> (opens in a new tab)</span></a>
      </aside>
    </div>
  </Section>

  <Section band="mist" id="how-i-work" labelledby="how-i-work-title">
    <SectionHead id="how-i-work-title" title="How I work" />
    <Steps items={HOW} />
  </Section>

  <Section class="about-build" labelledby="about-build-title">
    <SectionHead id="about-build-title" title="What I build" lead="Four ways I take work off your plate." link={{ href: '/services', label: 'All services' }} />
    <RuledGrid cols={4} label="What I build">
      {CAPABILITIES.map((c) => (
        <RuledCell href={c.href} label={c.number} title={c.name} compact text={c.line} />
      ))}
    </RuledGrid>
  </Section>
</AppShell>
