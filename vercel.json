{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/resume.pdf", "destination": "/contact", "statusCode": 301 },
    { "source": "/neil-busque-resume.pdf", "destination": "/contact", "statusCode": 301 },
    { "source": "/build", "destination": "/contact", "statusCode": 301 },
    { "source": "/build/", "destination": "/contact", "statusCode": 301 },
    { "source": "/build/thanks", "destination": "/contact", "statusCode": 301 },
    { "source": "/build/thanks/", "destination": "/contact", "statusCode": 301 },
    { "source": "/help", "destination": "/contact", "statusCode": 301 },
    { "source": "/help/", "destination": "/contact", "statusCode": 301 },
    { "source": "/help/thanks", "destination": "/contact", "statusCode": 301 },
    { "source": "/help/thanks/", "destination": "/contact", "statusCode": 301 },
    { "source": "/support", "destination": "/contact", "statusCode": 301 },
    { "source": "/support/", "destination": "/contact", "statusCode": 301 },
    { "source": "/support/thanks", "destination": "/contact", "statusCode": 301 },
    { "source": "/support/thanks/", "destination": "/contact", "statusCode": 301 },
    { "source": "/ria", "destination": "/services", "statusCode": 301 },
    { "source": "/ria/", "destination": "/services", "statusCode": 301 },
    { "source": "/ria/thanks", "destination": "/services", "statusCode": 301 },
    { "source": "/ria/thanks/", "destination": "/services", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/brand/favicon-32.png" },
    { "source": "/api/chat", "destination": "https://cubglfkgnjvlwelkmnbh.supabase.co/functions/v1/chat" },
    { "source": "/api/form-lead", "destination": "https://cubglfkgnjvlwelkmnbh.supabase.co/functions/v1/form-lead" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "interest-cohort=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
